array<string@> DepletingWasteBarrelPics1 = { "art\\items\\toxic_barrel2.fofrm" };
PicHashes DepletingWasteBarrelPicHashes1(DepletingWasteBarrelPics1);
array<string@> DepletingWasteBarrelPics2 = { "art\\items\\toxic_barrel3.fofrm" };
PicHashes DepletingWasteBarrelPicHashes2(DepletingWasteBarrelPics2);
array<string@> DepletingWasteBarrelPics3 = { "art\\items\\toxic_barrel4.fofrm" };
