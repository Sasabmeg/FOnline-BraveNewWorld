///
///     OTHER
///

bool hasRangedSkillAtLeast(Critter& player, int skillValue) {
    if (player.Skill[SK_SMALL_GUNS] >= skillValue || player.Skill[SK_BIG_GUNS] >= skillValue
            || player.Skill[SK_ENERGY_WEAPONS] >= skillValue || player.Skill[SK_THROWING] >= skillValue) {
        return true;
    } else {
        return false;
    }
}

bool hasRangedSkillAtLeastWithout(Critter& player, int skillValue, uint withoutIndex) {
    if ((player.Skill[SK_SMALL_GUNS] >= skillValue && withoutIndex != SK_SMALL_GUNS)
            || (player.Skill[SK_BIG_GUNS] >= skillValue && withoutIndex != SK_BIG_GUNS)
            || (player.Skill[SK_ENERGY_WEAPONS] >= skillValue  && withoutIndex != SK_ENERGY_WEAPONS)
            || (player.Skill[SK_THROWING] >= skillValue && withoutIndex != SK_THROWING)) {
        return true;
    } else {
        return false;
    }
}

bool hasCombatSkillAtLeastWithout(Critter& player, int skillValue, uint withoutIndex) {
    if ((player.Skill[SK_SMALL_GUNS] >= skillValue && withoutIndex != SK_SMALL_GUNS)
            || (player.Skill[SK_BIG_GUNS] >= skillValue && withoutIndex != SK_BIG_GUNS)
            || (player.Skill[SK_ENERGY_WEAPONS] >= skillValue  && withoutIndex != SK_ENERGY_WEAPONS)
            || (player.Skill[SK_UNARMED] >= skillValue  && withoutIndex != SK_UNARMED)
            || (player.Skill[SK_THROWING] >= skillValue && withoutIndex != SK_THROWING)) {
        return true;
    } else {
        return false;
    }
}

