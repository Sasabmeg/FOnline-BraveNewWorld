    return 0;
}

bool isCharPointsChecksumOk(Critter& player, string& reason) {
    reason = "";
    int totalBaseStats = 40;
    if (usedTraitPoints(player) > 2) {
        reason = "Too many Traits.";
        return false;
    }

    //  extra specials from traits
    if (player.Trait[TRAIT_GIFTED] > 0) {
        totalBaseStats += 7;
    }
    if (player.Trait[TRAIT_BRUISER] > 0) {
        totalBaseStats += 3;
    }
    if (player.Trait[TRAIT_FAST_SHOT] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_FINESSE] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_DOUBLE_TAP] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_CAUTIOUS_NATURE] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_KAMIKAZE] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_HEAVY_HANDED] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_GOOD_NATURED] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_BRUTISH_HULK] > 0) {
        totalBaseStats -= 1;
    }
    if (player.Trait[TRAIT_JINXED] > 0) {
        totalBaseStats -= 1;
    }

    //  extra specials from perks
    if (player.Perk[PE_GAIN_STRENGTH] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_STRENGTH];
    }
    if (player.Perk[PE_GAIN_PERCEPTION] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_PERCEPTION];
    }
    if (player.Perk[PE_GAIN_ENDURANCE] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_ENDURANCE];
    }
    if (player.Perk[PE_GAIN_CHARISMA] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_CHARISMA];
    }
    if (player.Perk[PE_GAIN_INTELLIGENCE] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_INTELLIGENCE];
    }
    if (player.Perk[PE_GAIN_AGILITY] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_STRENGTH];
    }
    if (player.Perk[PE_GAIN_LUCK] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_LUCK];
    }

    int currentBaseStats = 0;
    for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
        currentBaseStats += player.StatBase[i];
    }
    if (currentBaseStats > totalBaseStats) {
        reason = "Player: " + player.Name + " has MORE base SPECIAL stats than it should: " + currentBaseStats + " vs " + totalBaseStats;
        return false;
    }
    if (currentBaseStats < totalBaseStats) {
        reason = "Player: " + player.Name + " has LESS base SPECIAL stats than it should: " + currentBaseStats + " vs " + totalBaseStats;
        return false;
    }
    return true;
}

int recalcMaxLife(Critter& cr) {
    int life = 0;
    //  base life at character creation

    MutationLog("Critter <" + cr.Name + ">");
    MutationLog("\t\t+168 flat");
    life += 168;
    if (cr.TraitBase[TRAIT_BRUTISH_HULK] != 0) {
        MutationLog("\t\t+12 (Brutish Hulk)");
        life += 12;
    }

    int level = cr.StatBase[ST_LEVEL] <= int(__LevelCap) ? cr.StatBase[ST_LEVEL] : int(__LevelCap);
    life += 4 * (level - 1);
    MutationLog("\t\t+" + 4*(level-1) + " = 4 * (level - 1)");

    if (cr.PerkBase[PE_LIFEGIVER] > 0) {
        for (int i = 1; i <= cr.PerkBase[PE_LIFEGIVER]; i++) {
            life += 30;
            MutationLog("\t\t+30 from Lifegiver(" + i + ")");
        }
    }
    MutationLog("Critter <" + cr.Name + ">: StatBase[ST_MAX_LIFE] = " + cr.StatBase[ST_MAX_LIFE] + ", life = " + life + " (StatBase[ST_MAX_LIFE_EXT] = " + cr.StatBase[ST_MAX_LIFE_EXT] + ")");
    MutationLog("\t\t2*ST = " + cr.StatBase[ST_STRENGTH]*2 + ", 3*EN = " + cr.StatBase[ST_ENDURANCE]*3 + " -> " + (life + cr.StatBase[ST_STRENGTH]*2 + cr.StatBase[ST_ENDURANCE]*3) + " == " + cr.Stat[ST_MAX_LIFE]);

    //  safety check if some of the stat bonuses are skewed
    for (uint i = ST_STRENGTH_EXT; i <= ST_POISON_RESISTANCE_EXT; i++) {
        if (cr.StatBase[i] > 0) {
            MutationLog("\t\t\tStatBase[" + i + "] = " + cr.StatBase[i]);
        }
    }

    return life;
}

int recalcRadiationResistBase(Critter& cr) {
    int base = 0;
    //  EN does not need to calculated because it's part of the extensions and dynamic
    if (cr.Perk[PE_SNAKEATER] > 0) {
        base += 5;
    }
    if (cr.Perk[PE_RAD_RESISTANCE] > 0) {
        base += 10;
    }
    MutationLog("Critter <" + cr.Name + ">: RADIATION STATS");
    MutationLog("\tStatBase[ST_RAD_RESIST] = " + cr.StatBase[ST_RADIATION_RESISTANCE] + " vs " + base + " calculated as base");
    return base;
}

int recalcRadiationResistExt(Critter& cr) {
    int ext = 0;
    //  armor bonus is calculated via extensions so it's dynamic, but not armor base resist
    int armorRadResist = 0;
    Item@ bodyArmor = cr.GetItem(0, SLOT_ARMOR);
    if (valid(bodyArmor)) {
        switch (bodyArmor.Proto.Armor_Perk) {
            case ARMOR_PERK_POWERED: armorRadResist = 35; break;
            case ARMOR_PERK_ADVANCED_I:
            case ARMOR_PERK_ADVANCED_II: armorRadResist = 40; break;
            case ARMOR_PERK_LEATHER_JACKET: armorRadResist = 5; break;
            case ARMOR_PERK_LEATHER_ARMOR: armorRadResist = 10; break;
            case ARMOR_PERK_THERMAL_LEATHER: armorRadResist = 35; break;
            case ARMOR_PERK_COMBAT: armorRadResist = 25; break;
            case ARMOR_PERK_METAL: armorRadResist = 15; break;
            case ARMOR_PERK_TESLA: armorRadResist = 35; break;
            case ARMOR_PERK_CAMOUFLAGE_HP: armorRadResist = 10; break;
        }
    }
    if (armorRadResist != 0) {
        ext += armorRadResist;
    }
    if (cr.Timeout[TO_RAD_X] > 0) {
        ext += 25;
    }
    MutationLog("Critter <" + cr.Name + ">: RADIATION STATS");
    MutationLog("\tStatBase[ST_RAD_RESIST_EXT] = " + cr.StatBase[ST_RADIATION_RESISTANCE_EXT] + " vs " + ext + " calculated as ext");
    return ext;
}



#endif 	//	__MUTATION_FEATURE__
