        str += listPrefix + "[More Ranged Damage]\n";
    }
    if (player.Perk[PE_MAN_OF_STEEL] > 0) {
        str += listPrefix + "[Man of Steel]\n";
    }
    if (player.Perk[PE_FIELD_MEDIC] > 0) {
        str += listPrefix + "[Field Medic]\n";
    }

    //  level 18 perks
    if (player.Perk[PE_BONUS_RATE_OF_ATTACK] > 0) {
        str += listPrefix + "[Bonus Rate of Attack]\n";
    }
    if (player.Perk[PE_SNIPER] > 0) {
        str += listPrefix + "[Sniper]\n";
    }
    if (player.Perk[PE_SILENT_DEATH] > 0) {
        str += listPrefix + "[Silent Death]\n";
    }

    text = "$availablePerks " + str;
    if (text.length() > 998) {
        text = substring(text, 0, 998);
    }
}

bool d_CanRemovePerk(Critter& player, Critter@ npc, int val) {
    uint perkIndex = uint(val);
    string reason = "";
    if (canRemovePerk(player, perkIndex, reason)) {
        MutationLog("DEMAND - PERK REMOVE OK: " + getPerkName(perkIndex) + ", player: " + player.Name + ", reason: " + reason);
        return true;
    } else {
        MutationLog("DEMAND - CANNOT REMOVE PERK: " + getPerkName(perkIndex) + ", player: " + player.Name + ", reason: " + reason);
        return false;
    }
}

bool d_CanAddPerk(Critter& player, Critter@ npc, int val) {
    uint perkIndex = uint(val);
    string reason = "";
    if (canAddPerk(player, perkIndex, reason)) {
        MutationLog("DEMAND - PERK ADD OK: " + getPerkName(perkIndex) + ", player: " + player.Name + ", reason: " + reason);
        return true;
    } else {
        MutationLog("DEMAND - CANNOT ADD PERK: " + getPerkName(perkIndex) + ", player: " + player.Name + ", reason: " + reason);
        return false;
    }
}

void r_RemovePerk(Critter& player, Critter@ npc, int val) {
    uint perkIndex = uint(val);
    string reason = "";
    if (canRemovePerk(player, perkIndex, reason)) {
        removePerk(player, perkIndex);
        int maxLife = recalcMaxLife(player);
        //player.StatBase[ST_MAX_LIFE] = maxLife;
    } else {
        MutationLog("MUTATION DIALONG ERROR: RESULT - CANNOT REMOVE PERK: " + getPerkName(perkIndex) + ", player: " + player.Name + ", reason: " + reason);
    }
}

void r_AddPerk(Critter& player, Critter@ npc, int val) {
    uint perkIndex = uint(val);
    string reason = "";
    if (canAddPerk(player, perkIndex, reason)) {
        addPerk(player, perkIndex);
        int maxLife = recalcMaxLife(player);
        //player.StatBase[ST_MAX_LIFE] = maxLife;
    } else {
        MutationLog("MUTATION DIALOG ERROR: RESULT - CANNOT ADD PERK: " + getPerkName(perkIndex) + ", player: " + player.Name + ", reason: " + reason);
    }
}

bool canRemovePerk(Critter& player, uint perkIndex, string@ reason) {
    if (perkIndex < PERK_BEGIN  || perkIndex > PERK_END) {
        reason = colorError + "Error: Perk index out of bounds." + colorNormal;
        return false;
    }
    if (player.Perk[perkIndex] <= 0) {
        reason = colorWarn + "Does not have this Perk." + colorNormal;
        return false;
    }

    int highestPerk = getHighestPerkWithout(player, perkIndex);
    //MutationLog("MUTATION DIALOG - canRemovePerk() -> highestPerk:" + getPerkName(highestPerk) + ", player: " + player.Name);
    if (highestPerk > 0) {
        if (!hasPerkLevelsForWithout(player, highestPerk, perkIndex, reason)) {
            return false;
        }
    }

    switch (perkIndex) {
        case PE_MEDIC:
            if (player.Perk[PE_FIELD_MEDIC] > 0) {
                reason = colorWarn + "Blocked by Field Medic perk.!" + colorNormal;
                return false;
            }
            return true;
        case PE_GAIN_STRENGTH:
            if (!canChangeSpecial(player, ST_STRENGTH, -2, PE_GAIN_STRENGTH, reason)) {
                return false;
            }
            return true;
        case PE_GAIN_PERCEPTION:
            if (!canChangeSpecial(player, ST_PERCEPTION, -2, PE_GAIN_PERCEPTION, reason)) {
                return false;
            }
            return true;
        case PE_GAIN_ENDURANCE:
            if (!canChangeSpecial(player, ST_ENDURANCE, -2, PE_GAIN_ENDURANCE, reason)) {
                return false;
            }
            return true;
        case PE_GAIN_CHARISMA:
            if (!canChangeSpecial(player, ST_CHARISMA, -2, PE_GAIN_CHARISMA, reason)) {
                return false;
            }
            return true;
        case PE_GAIN_INTELLIGENCE:
            if (!canChangeSpecial(player, ST_INTELLECT, -2, PE_GAIN_INTELLIGENCE, reason)) {
                return false;
            }
            return true;
        case PE_GAIN_AGILITY:
            if (!canChangeSpecial(player, ST_AGILITY, -2, PE_GAIN_AGILITY, reason)) {
                return false;
            }
            return true;
        case PE_GAIN_LUCK:
            if (!canChangeSpecial(player, ST_LUCK, -2, PE_GAIN_LUCK, reason)) {
                return false;
            }
            return true;
        default:
            return true;
    }
    return true;
}

bool canAddPerk(Critter& player, uint perkIndex, string@ reason) {
    if (perkIndex < PERK_BEGIN  || perkIndex > PERK_END) {
        reason = colorError + "Error: Perk index out of bounds." + colorNormal;
        return false;
    }
    if (player.Perk[perkIndex] > 0) {
        if (!isMultiRankPerk(perkIndex)) {
            reason = colorWarn + "Already has this Perk." + colorNormal;
            return false;
        }
    }
    if (totalPerkCount(player) >= 8) {
        reason = "Cannot have more than 8 leveling Perks.";
        return false;
    }
    if (totalPerkCount(player) >= player.Stat[ST_LEVEL] / 3) {
        reason = "Cannot have more than " + (player.Stat[ST_LEVEL] / 3) + " leveling Perks at level " + player.Stat[ST_LEVEL] + ".";
        return false;
    }
    if (!hasPerkLevelsForWithout(player, perkIndex, 0, reason)) {
        return false;
    }
    int perkLevel = levelOfPerk(perkIndex);
    if (perkLevel > player.Stat[ST_LEVEL]) {
        reason = "Need to be at least level " + (perkLevel) + ".";
        return false;
    }

    switch (perkIndex) {
        //  level 3 perks
        case PE_MORE_CRITICALS:
            if (!hasRangedSkillAtLeast(player, 50) && player.Skill[SK_UNARMED] < 50) {
                reason = colorWarn + "One combat skill must be at least 50!" + colorNormal;
                return false;
            }
            return true;
        case PE_WEAPON_HANDLING:
            if (!hasRangedSkillAtLeast(player, 50)) {
                reason = colorWarn + "One ranged combat skill must be at least 50!" + colorNormal;
                return false;
            }
            return true;
        case PE_ADRENALINE_RUSH:
            if (player.StatBase[ST_STRENGTH] < 5) {
                reason = colorWarn + "Strength must be at least 5!" + colorNormal;
                return false;
            }
            return true;
        case PE_QUICK_RECOVERY:
            if (player.StatBase[ST_AGILITY] < 6) {
                reason = colorWarn + "Agility must be at least 6!" + colorNormal;
                return false;
            }
            return true;
        case PE_LIVEWIRE:
            if (player.StatBase[ST_AGILITY] < 7) {
                reason = colorWarn + "Agility must be at least 7!" + colorNormal;
                return false;
            }
            return true;
        case PE_WAY_OF_THE_FRUIT:
            if (player.StatBase[ST_CHARISMA] < 4) {
                reason = colorWarn + "Charisma must be at least 4!" + colorNormal;
                return false;
            }
            return true;
        case PE_HEALER_II:
            if (player.StatBase[ST_INTELLECT] < 4) {
                reason = colorWarn + "Intellect must be at least 4!" + colorNormal;
                return false;
            }
            if (player.Skill[SK_FIRST_AID] < 50) {
                reason = colorWarn + "First Aid must be at least 50!" + colorNormal;
                return false;
            }
            return true;
        case PE_QUICK_POCKETS:
            if (player.StatBase[ST_AGILITY] < 5) {
                reason = colorWarn + "Agility must be at least 5!" + colorNormal;
                return false;
            }
            return true;
        //  level 6 perks
        case PE_EVEN_MORE_CRITICALS:
            if (!hasRangedSkillAtLeast(player, 75) && player.Skill[SK_UNARMED] < 75) {
                reason = colorWarn + "One combat skill must be at least 75!" + colorNormal;
                return false;
            }
            return true;
        case PE_IN_YOUR_FACE:
            if (player.Skill[SK_UNARMED] < 75) {
                reason = colorWarn + "Close Combat must be at least 75!" + colorNormal;
                return false;
            }
            return true;
        case PE_SILENT_RUNNING:
            if (player.Skill[SK_SNEAK] < 75) {
                reason = colorWarn + "Sneak must be at least 75!" + colorNormal;
                return false;
            }
            return true;
        case PE_TOUGHNESS:
            if (player.StatBase[ST_ENDURANCE] < 4) {
                reason = colorWarn + "Endurance must be at least 4!" + colorNormal;
                return false;
            }
            return true;
        case PE_SPRAY_AND_PRAY:
            if (player.StatBase[ST_CHARISMA] < 3) {
                reason = colorWarn + "Charisma must be at least 3!" + colorNormal;
                return false;
            }
            if (player.StatBase[ST_LUCK] < 3) {
                reason = colorWarn + "Luck must be at least 3!" + colorNormal;
                return false;
            }
            return true;
        //  level 9 perks
        case PE_IRON_LIMBS:
            if (player.StatBase[ST_ENDURANCE] < 6) {
                reason = colorWarn + "Endurance must be at least 6!" + colorNormal;
                return false;
            }
            return true;
        case PE_STONEWALL:
            if (player.StatBase[ST_STRENGTH] < 6) {
                reason = colorWarn + "Strength must be at least 6!" + colorNormal;
                return false;
            }
            return true;
        case PE_SHARPSHOOTER:
            if (!hasRangedSkillAtLeast(player, 100) && player.Skill[SK_UNARMED] < 100) {
                reason = colorWarn + "One combat skill must be at least 100!" + colorNormal;
                return false;
            }
            if (player.StatBase[ST_INTELLECT] < 3) {
                reason = colorWarn + "Intellect must be at least 3!" + colorNormal;
                return false;
            }
            return true;
        case PE_BONUS_RANGED_DAMAGE:
            if (!hasRangedSkillAtLeast(player, 100)) {
                reason = colorWarn + "One ranged combat skill must be at least 100!" + colorNormal;
                return false;
            }
            return true;
        case PE_MORE_RANGED_DAMAGE:
            if (!hasRangedSkillAtLeast(player, 100)) {
                reason = colorWarn + "One ranged combat skill must be at least 100!" + colorNormal;
                return false;
            }
            if (player.StatBase[ST_CHARISMA] < 4) {
                reason = colorWarn + "Charisma must be at least 4!" + colorNormal;
                return false;
            }
            return true;
        case PE_PYROMANIAC:
            if (!hasRangedSkillAtLeast(player, 100)) {
                reason = colorWarn + "One ranged combat skill must be at least 100!" + colorNormal;
                return false;
            }
            return true;
        case PE_EVEN_TOUGHER:
            if (player.StatBase[ST_ENDURANCE] < 5) {
                reason = colorWarn + "Endurance must be at least 5!" + colorNormal;
                return false;
            }
            return true;
        case PE_MEDIC:
            if (player.Skill[SK_FIRST_AID] < 75) {
                reason = colorWarn + "First Aid must be at least 75!" + colorNormal;
                return false;
            }
            if (player.Skill[SK_DOCTOR] < 75) {
                reason = colorWarn + "Doctor must be at least 75!" + colorNormal;
                return false;
            }
            if (player.StatBase[ST_INTELLECT] < 5) {
                reason = colorWarn + "Intellect must be at least 5!" + colorNormal;
                return false;
            }
            return true;
        case PE_HEAVE_HO:
            if (player.Skill[SK_THROWING] < 100) {
                reason = colorWarn + "Throwing must be at least 100!" + colorNormal;
                return false;
            }
            return true;
        case PE_CLOSE_COMBAT_MASTER:
            if (player.Skill[SK_UNARMED] < 100) {
                reason = colorWarn + "Unarmed must be at least 100!" + colorNormal;
                return false;
            }
            return true;
        //  level 12 perks
        case PE_BETTER_CRITICALS:
            if (!hasRangedSkillAtLeast(player, 125) && player.Skill[SK_UNARMED] < 125) {
                reason = colorWarn + "One combat skill must be at least 125!" + colorNormal;
                return false;
            }
            if (player.StatBase[ST_LUCK] < 5) {
                reason = colorWarn + "Luck must be at least 5!" + colorNormal;
                return false;
            }
            return true;
        case PE_LIFEGIVER:
            if (player.PerkBase[PE_LIFEGIVER] > 2) {
                reason = colorWarn + "Can have more ranks than 3." + colorNormal;
                return false;
            }
            return true;
        case PE_GHOST:
            if (player.Skill[SK_SNEAK] < 125) {
                reason = colorWarn + "Sneak must be at least 125!" + colorNormal;
                return false;
            }
            return true;
        case PE_ACTION_BOY:
            if (player.Perk[PE_ACTION_BOY] > 1) {
                    reason = colorWarn + "Cannot have more ranks than 2!" + colorNormal;
                    return false;
            } else if (player.Perk[PE_ACTION_BOY] > 0) {
                if (player.StatBase[ST_AGILITY] < 7) {
                    reason = colorWarn + "Agility must be at least 7!" + colorNormal;
                    return false;
                }
            } else {
                if (player.StatBase[ST_AGILITY] < 5) {
                    reason = colorWarn + "Agility must be at least 5!" + colorNormal;
                    return false;
                }
            }
            return true;
        case PE_GAIN_STRENGTH:
            if (player.StatBase[ST_STRENGTH] > 8) {
                reason = colorWarn + "Strength must be at most 8!" + colorNormal;
                return false;
            }
            return true;
        case PE_GAIN_PERCEPTION:
            if (player.StatBase[ST_PERCEPTION] > 8) {
                reason = colorWarn + "Perception must be at most 8!" + colorNormal;
                return false;
            }
            return true;
        case PE_GAIN_ENDURANCE:
            if (player.StatBase[ST_ENDURANCE] > 8) {
                reason = colorWarn + "Endurance must be at most 8!" + colorNormal;
                return false;
            }
            return true;
        case PE_GAIN_CHARISMA:
            if (player.StatBase[ST_CHARISMA] > 8) {
                reason = colorWarn + "Charisma must be at most 8!" + colorNormal;
                return false;
            }
            return true;
        case PE_GAIN_INTELLIGENCE:
            if (player.StatBase[ST_INTELLECT] > 8) {
                reason = colorWarn + "Intellect must be at most 8!" + colorNormal;
                return false;
            }
            return true;
        case PE_GAIN_AGILITY:
            if (player.StatBase[ST_AGILITY] > 8) {
                reason = colorWarn + "Agility must be at most 8!" + colorNormal;
                return false;
            }
            return true;
        case PE_GAIN_LUCK:
            if (player.StatBase[ST_LUCK] > 8) {
                reason = colorWarn + "Luck must be at most 8!" + colorNormal;
                return false;
            }
            return true;
        //  level 15 perks
        case PE_MAN_OF_STEEL:
            if (player.StatBase[ST_ENDURANCE] < 6) {
                reason = colorWarn + "Endurance must be at least 6!" + colorNormal;
                return false;
            }
            return true;
        case PE_FIELD_MEDIC:
            if (player.Skill[SK_FIRST_AID] < 150) {
                reason = colorWarn + "First Aid must be at least 75!" + colorNormal;
                return false;
            }
            if (player.Skill[SK_DOCTOR] < 150) {
                reason = colorWarn + "Doctor must be at least 75!" + colorNormal;
                return false;
            }
            if (player.Perk[PE_MEDIC] < 1) {
                reason = colorWarn + "Must also have Medic perk!" + colorNormal;
                return false;
            }
            return true;
        //  level 18 perks
        case PE_BONUS_RATE_OF_ATTACK:
            if (!hasRangedSkillAtLeast(player, 175) && player.Skill[SK_UNARMED] < 175) {
                reason = colorWarn + "One combat skill must be at least 175!" + colorNormal;
                return false;
            }
            return true;
        case PE_SNIPER:
            if (!hasRangedSkillAtLeast(player, 175)) {
                reason = colorWarn + "One ranged combat skill must be at least 175!" + colorNormal;
                return false;
            }
            return true;
        case PE_SILENT_DEATH:
            if (player.Skill[SK_SNEAK] < 175) {
                reason = colorWarn + "Sneak must be at least 175!" + colorNormal;
                return false;
            }
            return true;
        default:
            return true;
    }
    return false;
}

void removePerk(Critter& player, uint perkIndex) {
    if (isMultiRankPerk(perkIndex)) {
        if (perkIndex == PE_LIFEGIVER) {
            if (player.PerkBase[perkIndex] > 0) {
                player.PerkBase[perkIndex] -= 1;
                MutationLog("Reducing player's LIFEGIVER perk rank to " + player.PerkBase[perkIndex]);
            } else {
                MutationLogError("ERROR: Cannot have less than 0 ranks in LIFEGIVER perk. (This code should not be reachable)");
            }
        } else if (perkIndex == PE_ACTION_BOY) {
            if (player.PerkBase[perkIndex] > 0) {
                player.PerkBase[perkIndex] -= 1;
                MutationLog("Reducing player's ACTION BOY perk rank to " + player.PerkBase[perkIndex]);
            } else {
                MutationLogError("ERROR: Cannot have less than 0 ranks in ACTION BOY perk. (This code should not be reachable)");
            }
        } else {
            MutationLogError("ERROR: Unhandled multi rank perk: " + getPerkName(perkIndex));
        }
    } else {
        MutationLog("Removing player's perk: " + getPerkName(perkIndex));
        player.PerkBase[perkIndex] = 0;
    }
}

void addPerk(Critter& player, uint perkIndex) {
    if (isMultiRankPerk(perkIndex)) {
        if (perkIndex == PE_LIFEGIVER) {
            if (player.PerkBase[perkIndex] < 3) {
                player.PerkBase[perkIndex] += 1;
                MutationLog("Increasing player's LIFEGIVER perk rank to " + player.PerkBase[perkIndex]);
            } else {
                MutationLogError("ERROR: Cannot have more than 3 ranks in LIFEGIVER perk.");
            }
        } else if (perkIndex == PE_ACTION_BOY) {
            if (player.PerkBase[perkIndex] < 2) {
                player.PerkBase[perkIndex] += 1;
                MutationLog("Increasing player's ACTION BOY perk rank to " + player.PerkBase[perkIndex]);
            } else {
                MutationLogError("ERROR: Cannot have more than 2 ranks in ACTION BOY perk.");
            }
        } else {
            MutationLogError("ERROR: Unhandled multi rank perk with index = " + getPerkName(perkIndex));
        }
    } else {
        MutationLog("Adding " + getPerkName(perkIndex) + " to player.");
        player.PerkBase[perkIndex] = 1;
    }
}

int totalPerkCount(Critter& player) {
    int perkCount = 0;
    for (uint i = 0; i < level3Perks.length; i++) {
        if (player.Perk[level3Perks[i]] > 0) {
            perkCount += player.Perk[level3Perks[i]];
        }
    }
    for (uint i = 0; i < level6Perks.length; i++) {
        if (player.Perk[level6Perks[i]] > 0) {
            perkCount += player.Perk[level6Perks[i]];
        }
    }
    for (uint i = 0; i < level9Perks.length; i++) {
        if (player.Perk[level9Perks[i]] > 0) {
            perkCount += player.Perk[level9Perks[i]];
        }
    }
    for (uint i = 0; i < level12Perks.length; i++) {
        if (player.Perk[level12Perks[i]] > 0) {
            perkCount += player.Perk[level12Perks[i]];
        }
    }
    for (uint i = 0; i < level15Perks.length; i++) {
        if (player.Perk[level15Perks[i]] > 0) {
            perkCount += player.Perk[level15Perks[i]];
        }
    }
    for (uint i = 0; i < level18Perks.length; i++) {
        if (player.Perk[level18Perks[i]] > 0) {
            perkCount += player.Perk[level18Perks[i]];
        }
    }
    return perkCount;
}

bool hasPerkLevelsForWithout(Critter& player, uint perkIndexFor, uint perkIndexWithout, string@ reason) {
    reason = "N/A";
    int level = 3;
    int perkLevel = levelOfPerk(perkIndexFor);
    if (isMultiRankPerk(perkIndexFor)) {
        if (perkIndexFor == PE_LIFEGIVER) {
            if (player.PerkBase[perkIndexFor] == 3) {
                perkLevel = 15;
            } else if (player.PerkBase[perkIndexFor] == 2) {
                perkLevel = 12;
            } else {
                perkLevel = 9;
            }
        }
        if (perkIndexFor == PE_ACTION_BOY) {
            if (player.PerkBase[perkIndexFor] == 2) {
                perkLevel = 12;
            } else {
                perkLevel = 9;
            }
        }
    }

    //  level 3 perks always true
    if (perkLevel == 3) {
        return true;
    }

    //  level 6 perks must have at least 1 level 3 perk
    for (uint i = 0; i < level3Perks.length; i++) {
        if (perkIndexWithout != level3Perks[i] && player.Perk[level3Perks[i]] > 0) {
            level += 3;
        }
    }
    if (level >= 6) {
        if (perkLevel == 6)
            return true;
    } else {
        reason = colorAlreadyHave + "Need one more level 3 perk." + colorNormal;
        return false;
    }

    //  level 9 perks must have at least 2 lower level perk
    for (uint i = 0; i < level6Perks.length; i++) {
        if (perkIndexWithout != level6Perks[i] && player.Perk[level6Perks[i]] > 0) {
            level += 3;
        }
    }
    if (level >= 9) {
        if (perkLevel == 9)
            return true;
    } else {
        reason = colorAlreadyHave + "Need one more level 6 or lower perk." + colorNormal;
        return false;
    }

    //  level 12 perks must have at least 3 lower level perk
    for (uint i = 0; i < level9Perks.length; i++) {
        if (perkIndexWithout != level9Perks[i] && player.Perk[level9Perks[i]] > 0) {
            level += 3;
        }
    }
    if (level >= 12) {
        if (perkLevel == 12)
            return true;
    } else {
        reason = colorAlreadyHave + "Need one more level 9 or lower perk." + colorNormal;
        return false;
    }

    //  level 15 perks must have at least 4 lower level perk
    for (uint i = 0; i < level12Perks.length; i++) {
        if (perkIndexWithout != level12Perks[i] && player.Perk[level12Perks[i]] > 0) {
            level += 3;
        }
    }
    if (level >= 15) {
        if (perkLevel == 15)
            return true;
    } else {
        reason = colorAlreadyHave + "Need one more level 12 or lower perk." + colorNormal;
        return false;
    }

    //  level 18 perks must have at least 5 lower level perk
    for (uint i = 0; i < level15Perks.length; i++) {
        if (perkIndexWithout != level15Perks[i] && player.Perk[level15Perks[i]] > 0) {
            level += 3;
        }
    }
    if (level >= 18) {
        if (perkLevel == 18)
            return true;
    } else {
        reason = colorAlreadyHave + "Need one more level 15 or lower perk." + colorNormal;
        return false;
    }

    reason = "Unknown Perk";
    return false;
}

int levelOfPerk(uint perkIndex) {
    for (uint i = 0; i < level3Perks.length; i++) {
        if (perkIndex == level3Perks[i]) {
            return 3;
        }
    }
    for (uint i = 0; i < level6Perks.length; i++) {
        if (perkIndex == level6Perks[i]) {
            return 6;
        }
    }
    for (uint i = 0; i < level9Perks.length; i++) {
        if (perkIndex == level9Perks[i]) {
            return 9;
        }
    }
    for (uint i = 0; i < level12Perks.length; i++) {
        if (perkIndex == level12Perks[i]) {
            return 12;
        }
    }
    for (uint i = 0; i < level15Perks.length; i++) {
        if (perkIndex == level15Perks[i]) {
            return 15;
        }
    }
    for (uint i = 0; i < level18Perks.length; i++) {
        if (perkIndex == level18Perks[i]) {
            return 18;
        }
    }
    return 10000;
}

uint[] multiRankPerks = {PE_LIFEGIVER, PE_ACTION_BOY};

uint[] level3Perks = {PE_MORE_CRITICALS, PE_WEAPON_HANDLING, PE_ADRENALINE_RUSH, PE_QUICK_RECOVERY, PE_LIVEWIRE, PE_WAY_OF_THE_FRUIT, PE_HEALER_II, PE_QUICK_POCKETS};
uint[] level6Perks = {PE_EVEN_MORE_CRITICALS, PE_IN_YOUR_FACE, PE_SILENT_RUNNING, PE_TOUGHNESS, PE_SPRAY_AND_PRAY};
uint[] level9Perks = {PE_MORE_RANGED_DAMAGE, PE_IRON_LIMBS, PE_STONEWALL, PE_SHARPSHOOTER, PE_BONUS_RANGED_DAMAGE, PE_PYROMANIAC, PE_EVEN_TOUGHER, PE_MEDIC, PE_HEAVE_HO, PE_CLOSE_COMBAT_MASTER};
uint[] level12Perks = {PE_BETTER_CRITICALS, PE_LIFEGIVER, PE_GHOST, PE_ACTION_BOY, PE_GAIN_STRENGTH, PE_GAIN_PERCEPTION,
                       PE_GAIN_ENDURANCE, PE_GAIN_CHARISMA, PE_GAIN_INTELLIGENCE, PE_GAIN_AGILITY, PE_GAIN_LUCK};
uint[] level15Perks = {PE_MAN_OF_STEEL, PE_FIELD_MEDIC};
uint[] level18Perks = {PE_BONUS_RATE_OF_ATTACK, PE_SNIPER, PE_SILENT_DEATH};

uint getHighestPerkWithout(Critter& player, uint perkIndex) {
    for (uint i = 0; i < level18Perks.length; i++) {
        if (perkIndex != level18Perks[i] && player.Perk[level18Perks[i]] > 0) {
            return level18Perks[i];
        }
    }
    for (uint i = 0; i < level15Perks.length; i++) {
        if (perkIndex != level15Perks[i] && player.Perk[level15Perks[i]] > 0) {
            return level15Perks[i];
        }
    }
    for (uint i = 0; i < level12Perks.length; i++) {
        if (perkIndex != level12Perks[i] && player.Perk[level12Perks[i]] > 0) {
            return level12Perks[i];
        }
    }
    for (uint i = 0; i < level9Perks.length; i++) {
        if (perkIndex != level9Perks[i] && player.Perk[level9Perks[i]] > 0) {
            return level9Perks[i];
        }
    }
    for (uint i = 0; i < level6Perks.length; i++) {
        if (perkIndex != level6Perks[i] && player.Perk[level6Perks[i]] > 0) {
            return level6Perks[i];
        }
    }
    for (uint i = 0; i < level3Perks.length; i++) {
        if (perkIndex != level3Perks[i] && player.Perk[level3Perks[i]] > 0) {
            return level3Perks[i];
        }
    }
    return 0;
}

bool isMultiRankPerk(uint perkIndex) {
    for (uint i = 0; i < multiRankPerks.length; i++) {
        if (perkIndex == multiRankPerks[i]) {
            return true;
        }
    }
    return false;
}

