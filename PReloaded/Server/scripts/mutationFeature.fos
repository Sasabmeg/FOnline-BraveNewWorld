void addTrait(Critter& player, uint traitIndex) {
    string reason = "";
    bool canChangeGifted = false;

    if (player.TraitBase[traitIndex] > 0) {
        return;
    }
    if (usedTraitPoints(player) >= 2) {
        return;
    }

    switch (traitIndex) {
        case TRAIT_FAST_METABOLISM:
        case TRAIT_ONE_HANDER:
        case TRAIT_BLOODY_MESS:
        case TRAIT_CHEM_RELIANT:
            player.TraitBase[traitIndex] = 1;
            break;
        case TRAIT_BRUISER:
            if (canChangeSpecial(player, ST_STRENGTH, +3, reason)) {
                player.StatBase[ST_STRENGTH] += 3;
                player.StatBase[ST_ACTION_POINTS] += -1;
                player.TraitBase[traitIndex] = 1;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_FINESSE:
            if (canChangeSpecial(player, ST_INTELLECT, +1, reason) && !hasExclusiveTrait(player)) {
                player.StatBase[ST_INTELLECT] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_KAMIKAZE:
        case TRAIT_FAST_SHOT:
        case TRAIT_DOUBLE_TAP:
            if (canChangeSpecial(player, ST_AGILITY, +1, reason) && !hasExclusiveTrait(player)) {
                player.StatBase[ST_AGILITY] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_HEAVY_HANDED:
            if (canChangeSpecial(player, ST_STRENGTH, +1, reason)) {
                player.StatBase[ST_STRENGTH] += 1;
                player.StatBase[ST_MELEE_DAMAGE] += 5;
                player.TraitBase[traitIndex] = 1;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_JINXED:
            if (canChangeSpecial(player, ST_LUCK, -1, reason)) {
                player.StatBase[ST_LUCK] += -1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_GOOD_NATURED:
            if (canChangeSpecial(player, ST_CHARISMA, +1, reason)) {
                player.StatBase[ST_CHARISMA] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_BRUTISH_HULK:
            if (canChangeSpecial(player, ST_CHARISMA, -1, reason)) {
                player.StatBase[ST_CHARISMA] += -1;
                player.StatBase[ST_MELEE_DAMAGE] += +3;
                player.StatBase[ST_MAX_LIFE] += 12;
                player.TraitBase[traitIndex] = 1;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_CAUTIOUS_NATURE:
            if (canChangeSpecial(player, ST_PERCEPTION, +1, reason) && !hasExclusiveTrait(player)) {
                player.StatBase[ST_PERCEPTION] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_GIFTED:
            if (usedTraitPoints(player) > 0) {
                return;
            }
            canChangeGifted = true;
            for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                if (!canChangeSpecial(player, i, +1, reason)) {
                    canChangeGifted = false;
                }
            }
            if (canChangeGifted) {
                for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                    player.StatBase[i] += 1;
                }
                player.TraitBase[traitIndex] = 1;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_LONER:
            if (canAddTrait(player, TRAIT_LONER, reason)) {
                player.TraitBase[traitIndex] = 1;
            }
            break;
        default:
    }
}

void removeTrait(Critter& player, uint traitIndex) {
    string reason = "";
    bool canChangeGifted = false;

    if (player.TraitBase[traitIndex] == 0) {
        return;
    }

    switch (traitIndex) {
        case TRAIT_FAST_METABOLISM:
        case TRAIT_ONE_HANDER:
        case TRAIT_BLOODY_MESS:
        case TRAIT_CHEM_RELIANT:
            player.TraitBase[traitIndex] = 0;
            break;
        case TRAIT_BRUISER:
            if (canChangeSpecial(player, ST_STRENGTH, -3, reason)) {
                player.StatBase[ST_STRENGTH] += -3;
                player.StatBase[ST_ACTION_POINTS] += 1;
                player.TraitBase[traitIndex] = 0;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_FINESSE:
            if (canChangeSpecial(player, ST_INTELLECT, -1, reason)) {
                player.StatBase[ST_INTELLECT] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_KAMIKAZE:
        case TRAIT_FAST_SHOT:
        case TRAIT_DOUBLE_TAP:
            if (canChangeSpecial(player, ST_AGILITY, -1, reason)) {
                player.StatBase[ST_AGILITY] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_HEAVY_HANDED:
            if (canChangeSpecial(player, ST_STRENGTH, -1, reason)) {
                player.StatBase[ST_STRENGTH] += -1;
                player.StatBase[ST_MELEE_DAMAGE] += -5;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_JINXED:
            if (canChangeSpecial(player, ST_LUCK, +1, reason)) {
                player.StatBase[ST_LUCK] += +1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_GOOD_NATURED:
            if (canChangeSpecial(player, ST_CHARISMA, -1, reason)) {
                player.StatBase[ST_CHARISMA] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_BRUTISH_HULK:
            if (canChangeSpecial(player, ST_CHARISMA, +1, reason)) {
                player.StatBase[ST_CHARISMA] += +1;
                player.StatBase[ST_MAX_LIFE] -= 12;
                player.StatBase[ST_MELEE_DAMAGE] += -3;
                player.TraitBase[traitIndex] = 0;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_CAUTIOUS_NATURE:
            if (canChangeSpecial(player, ST_PERCEPTION, -1, reason)) {
                player.StatBase[ST_PERCEPTION] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_GIFTED:
            canChangeGifted = true;
            for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                if (!canChangeSpecial(player, i, -1, reason)) {
                    canChangeGifted = false;
                }
            }
            if (canChangeGifted) {
                for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                    player.StatBase[i] += -1;
                }
                player.TraitBase[traitIndex] = 0;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_LONER:
            if (canRemoveTrait(player, TRAIT_LONER, reason)) {
                player.TraitBase[traitIndex] = 0;
            }
            break;
        default:
    }
}

bool hasExclusiveTrait(Critter& player) {
    if (player.Trait[TRAIT_FAST_SHOT] > 0 || player.Trait[TRAIT_FINESSE] > 0 || player.Trait[TRAIT_DOUBLE_TAP] > 0 || player.Trait[TRAIT_CAUTIOUS_NATURE] > 0 || player.Trait[TRAIT_KAMIKAZE] > 0) {
        return true;
    } else {
        return false;
    }
}

int usedTraitPoints(Critter& player) {
    int traits = 0;
    for (uint i = TRAIT_BEGIN; i <= TRAIT_END; i++) {
        if (player.Trait[i] > 0) {
            if (i == TRAIT_GIFTED) {
                traits += 2;
            } else {
                traits++;
            }
        }
    }
    //player.Say(SAY_NETMSG, "Trait END = " + TRAIT_END + ", usedTraitPoints = " + traits);
    return traits;
}

bool isCharPointsChecksumOk(Critter& player, string& reason) {
    reason = "";
    int totalBaseStats = 40;
    if (usedTraitPoints(player) > 2) {
        reason = "Too many Traits.";
        return false;
    }

    //  extra specials from traits
    if (player.Trait[TRAIT_GIFTED] > 0) {
        totalBaseStats += 7;
    }
    if (player.Trait[TRAIT_BRUISER] > 0) {
        totalBaseStats += 3;
    }
    if (player.Trait[TRAIT_FAST_SHOT] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_FINESSE] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_DOUBLE_TAP] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_CAUTIOUS_NATURE] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_KAMIKAZE] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_HEAVY_HANDED] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_GOOD_NATURED] > 0) {
        totalBaseStats += 1;
    }
    if (player.Trait[TRAIT_BRUTISH_HULK] > 0) {
        totalBaseStats -= 1;
    }
    if (player.Trait[TRAIT_JINXED] > 0) {
        totalBaseStats -= 1;
    }

    //  extra specials from perks
    if (player.Perk[PE_GAIN_STRENGTH] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_STRENGTH];
    }
    if (player.Perk[PE_GAIN_PERCEPTION] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_PERCEPTION];
    }
    if (player.Perk[PE_GAIN_ENDURANCE] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_ENDURANCE];
    }
    if (player.Perk[PE_GAIN_CHARISMA] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_CHARISMA];
    }
    if (player.Perk[PE_GAIN_INTELLIGENCE] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_INTELLIGENCE];
    }
    if (player.Perk[PE_GAIN_AGILITY] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_STRENGTH];
    }
    if (player.Perk[PE_GAIN_LUCK] > 0) {
        totalBaseStats += 2 * player.Perk[PE_GAIN_LUCK];
    }

    int currentBaseStats = 0;
    for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
        currentBaseStats += player.StatBase[i];
    }
    if (currentBaseStats > totalBaseStats) {
        reason = "Player: " + player.Name + " has MORE base SPECIAL stats than it should: " + currentBaseStats + " vs " + totalBaseStats;
        return false;
    }
    if (currentBaseStats < totalBaseStats) {
        reason = "Player: " + player.Name + " has LESS base SPECIAL stats than it should: " + currentBaseStats + " vs " + totalBaseStats;
        return false;
    }
    return true;
}


#endif 	//	__MUTATION_FEATURE__
