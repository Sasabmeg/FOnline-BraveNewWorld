#ifndef __MUTATION_FEATURE__
#define __MUTATION_FEATURE__

#include "_macros.fos"
#include "_colors.fos"

string colorError = "|" + COLOR_RED + " ";
string colorWarn = "|" + COLOR_DORANGE + " ";
string colorAlreadyHave = "|" + COLOR_GOLDEN_YELLOW + " ";
string colorNormal = "|" + COLOR_LGREEN + " ";

#define MUTATION_LOGGING_LEVEL  (3)     //  0 = no logging, 1 = only errors, 2 = warnings too, 3 = log everything (for debugging local use only)

void MutationLog(string@ str) {
    if (MUTATION_LOGGING_LEVEL > 2) {
        Log("MUTATION:\t" + str);
    }
}

void MutationLogWarn(string@ str) {
    if (MUTATION_LOGGING_LEVEL > 1) {
        Log("MUTATION ERROR:\t" + str);
    }
}

void MutationLogError(string@ str) {
    if (MUTATION_LOGGING_LEVEL > 0) {
        Log("MUTATION ERROR:\t" + str);
    }
}

import bool     HasItem(Critter@ cr, uint pid) from "utils";

bool d_HasItemExt(Critter& player, Critter@ npc, int val1, int val2) {
    Item@ existItem = player.GetItem(val1, -1);
    if (valid(existItem)) {
        if (int(existItem.GetCount()) >= val2) {
            return true;
        }
    }
    return false;
}

void r_RemoveItemExt(Critter& player, Critter@ npc, int val1, int val2) {
    player.DeleteItem(val1, val2);
}


///
///     TAGGED SKILL
///


bool d_IsNotTaggedSkill(Critter& player, Critter@ npc, int val1) {
    return !d_IsTaggedSkill(player, npc, val1);
}

bool d_IsTaggedSkill(Critter& player, Critter@ npc, int val1) {
    string reason = "";
    if (player.Param[TAG_SKILL1] == val1) {
        return true;
    } else {
        return false;
    }
}

void r_SwapTagSkill(Critter& player, Critter@ npc, int val) {
    uint skillIndex = uint(val);
    string reason = "";
    if (canSwapTag(player, skillIndex, reason)) {
        uint oldTagIndex = player.ParamBase[TAG_SKILL1];
        int oldSkillVal = player.SkillBase[oldTagIndex];
        player.SkillBase[oldTagIndex] = player.SkillBase[skillIndex];
        player.SkillBase[skillIndex] = oldSkillVal;
        player.ParamBase[TAG_SKILL1] = skillIndex;
    } else {
        Log("MUTATION DIALONG ERROR: RESULT - CANNOT SWAP PERK: " + getSkillName(skillIndex) + ", player: " + player.Name + ", reason: " + reason);
    }
}

bool d_CanSwapTagSkill(Critter& player, Critter@ npc, int val1) {
    string reason = "";
    return canSwapTag(player, val1, reason);
}

/**
 * Show the SPECIALs the player currently has and the reason they can be decreased or increased. @lex tagSkill@ is used.
 */
void dlg_TagSkillList(Critter& player, Critter@ npc, string@ text) {
    if (!IS_DIALOG_GENERATED(text))
        return;

    if (player.Param[TAG_SKILL1] < int(SKILL_BEGIN) || player.Param[TAG_SKILL1] > int(SKILL_END)) {
        text = "$tagSkill " + "Error: Tag skill N/A.?!";
        return;
    }

    string taggable = "-tag swappable-";
    string str = "";
    string listPrefix = "\t";
    string reason = "";

    str += "\n\n[List of your combat specialization skills:]\n";

    str += listPrefix + "[Small Guns: \t\t " + player.SkillBase[SK_SMALL_GUNS] + "\t";
    if (canSwapTag(player, SK_SMALL_GUNS, reason)) {
        str += taggable + "]\n";
    } else {
        str += reason + "]\n";
    }
    str += listPrefix + "[Big Guns: \t\t\t" + player.SkillBase[SK_BIG_GUNS] + "\t";
    if (canSwapTag(player, SK_BIG_GUNS, reason)) {
        str += taggable + "]\n";
    } else {
        str += reason + "]\n";
    }
    str += listPrefix + "[Energy Weapons:  " + player.SkillBase[SK_ENERGY_WEAPONS] + "\t";
    if (canSwapTag(player, SK_ENERGY_WEAPONS, reason)) {
        str += taggable + "]\n";
    } else {
        str += reason + "]\n";
    }
    str += listPrefix + "[Close Combat: \t " + player.SkillBase[SK_UNARMED] + "\t";
    if (canSwapTag(player, SK_UNARMED, reason)) {
        str += taggable + "]\n";
    } else {
        str += reason + "]\n";
    }
    str += listPrefix + "[Throwing: \t\t\t" + player.SkillBase[SK_THROWING] + "\t";
    if (canSwapTag(player, SK_THROWING, reason)) {
        str += taggable + "]\n";
    } else {
        str += reason + "]\n";
    }
    str += listPrefix + "[Doctor: \t\t\t   " + player.SkillBase[SK_DOCTOR] + "\t";
    if (canSwapTag(player, SK_DOCTOR, reason)) {
        str += taggable + "]\n";
    } else {
        str += reason + "]\n";
    }
    str += listPrefix + "[Sneak: \t\t\t\t" + player.SkillBase[SK_SNEAK] + "\t";
    if (canSwapTag(player, SK_SNEAK, reason)) {
        str += taggable + "]\n";
    } else {
        str += reason + "]\n";
    }
    str += listPrefix + "[Traps: \t\t\t\t " + player.SkillBase[SK_TRAPS] + "\t";
    if (canSwapTag(player, SK_TRAPS, reason)) {
        str += taggable + "]\n";
    } else {
        str += reason + "]\n";
    }

    text = "$tagSkill " + str;
    if (text.length() > 998) {
        text = substring(text, 0, 998);
    }
}

bool canSwapTag(Critter& player, uint skillIndex, string@ reason) {
    uint currentTagIndex = player.Param[TAG_SKILL1];
    MutationLog("CAN SWAP TAG: " + getSkillName(currentTagIndex) + " -> " + getSkillName(skillIndex));
    if (player.Param[TAG_SKILL1] < int(SKILL_BEGIN) || player.Param[TAG_SKILL1] > int(SKILL_END)) {
        reason = "Error: Tag skill N/A.?!";
        return false;
    }
    if (skillIndex < SKILL_BEGIN || skillIndex > SKILL_END) {
        reason = colorWarn + "Error: Skill index out of bounds." + colorNormal;
        return false;
    }
    if (currentTagIndex == skillIndex) {
        reason = colorAlreadyHave + "This is your Tag Skill." + colorNormal;
        return false;
    }


    if (isRangedSkill(skillIndex) && isRangedSkill(currentTagIndex)) {
        if (skillIndex == SK_THROWING || currentTagIndex == SK_THROWING) {
            if (player.Perk[PE_HEAVE_HO] > 0 && (player.Skill[skillIndex] < 100 || player.Skill[currentTagIndex] < 100)) {
                reason = colorWarn + "Heave Ho!" + colorNormal;
                return false;
            }
        }
        //MutationLog("Both Ranged skill. OK");
        return true;
    }

    if (isRangedSkill(skillIndex) || isRangedSkill(currentTagIndex)) {
        if (skillIndex == SK_UNARMED || currentTagIndex == SK_UNARMED) {
            if (player.Perk[PE_WEAPON_HANDLING] > 0 && player.Skill[SK_UNARMED] < 50 && !hasRangedSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn + "Weapon Handling" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RANGED_DAMAGE] > 0 && player.Skill[SK_UNARMED] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn + "Bonus Ranged Damage" + colorNormal; return false; }
            if (player.Perk[PE_MORE_RANGED_DAMAGE] > 0 && player.Skill[SK_UNARMED] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "More Ranged Damage" + colorNormal; return false; }
            if (player.Perk[PE_PYROMANIAC] > 0 && player.Skill[SK_UNARMED] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  colorWarn + "Pyromaniac" + colorNormal; return false; }
            if (player.Perk[PE_SNIPER] > 0 && player.Skill[SK_UNARMED] < 175 && !hasRangedSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Sniper" + colorNormal; return false; }

            if (player.Perk[PE_IN_YOUR_FACE] > 0 && player.Skill[currentTagIndex] < 75) { reason = colorWarn +  "In Your Face" + colorNormal; return false; }
            if (player.Perk[PE_CLOSE_COMBAT_MASTER] > 0 && player.Skill[currentTagIndex] < 100) { reason = colorWarn +  "Close Combat Master" + colorNormal; return false; }
        }
        if (skillIndex == SK_SNEAK || currentTagIndex == SK_SNEAK) {
            if (player.Perk[PE_WEAPON_HANDLING] > 0 && player.Skill[SK_SNEAK] < 50 && !hasRangedSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn +  "Weapon Handling" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RANGED_DAMAGE] > 0 && player.Skill[SK_SNEAK] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Bonus Ranged Damage" + colorNormal; return false; }
            if (player.Perk[PE_MORE_RANGED_DAMAGE] > 0 && player.Skill[SK_SNEAK] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "More Ranged Damage" + colorNormal; return false; }
            if (player.Perk[PE_PYROMANIAC] > 0 && player.Skill[SK_SNEAK] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Pyromaniac" + colorNormal; return false; }
            if (player.Perk[PE_SNIPER] > 0 && player.Skill[SK_SNEAK] < 175 && !hasRangedSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Sniper" + colorNormal; return false; }

            if (player.Perk[PE_MORE_CRITICALS] > 0 && player.Skill[SK_SNEAK] < 50 && !hasCombatSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn +  "More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_EVEN_MORE_CRITICALS] > 0 && player.Skill[SK_SNEAK] < 75 && !hasCombatSkillAtLeastWithout(player, 75, currentTagIndex)) { reason = colorWarn +  "Even More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_SHARPSHOOTER] > 0 && player.Skill[SK_SNEAK] < 100 && !hasCombatSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Sharpshooter" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RATE_OF_ATTACK] > 0 && player.Skill[SK_SNEAK] < 175 && !hasCombatSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Bonus Rate of Attack" + colorNormal; return false; }

            if (player.Perk[PE_SILENT_RUNNING] > 0 && player.Skill[currentTagIndex] < 75) { reason = colorWarn +  "Silent Running" + colorNormal; return false; }
            if (player.Perk[PE_GHOST] > 0 && player.Skill[currentTagIndex] < 125) { reason = colorWarn +  "Ghost" + colorNormal; return false; }
            if (player.Perk[PE_SILENT_DEATH] > 0 && player.Skill[currentTagIndex] < 175) { reason = colorWarn +  "Silent Death" + colorNormal; return false; }
            if (player.Perk[PE_STEALTH_GIRL] > 0 && player.Skill[currentTagIndex] < 100) { reason = colorWarn +  "Stealth Girl" + colorNormal; return false; }
        }
        if (skillIndex == SK_DOCTOR || currentTagIndex == SK_DOCTOR) {
            if (player.Perk[PE_WEAPON_HANDLING] > 0 && player.Skill[SK_DOCTOR] < 50 && !hasRangedSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn +  "Weapon Handling" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RANGED_DAMAGE] > 0 && player.Skill[SK_DOCTOR] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Bonus Ranged Damage" + colorNormal; return false; }
            if (player.Perk[PE_MORE_RANGED_DAMAGE] > 0 && player.Skill[SK_DOCTOR] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "More Ranged Damage" + colorNormal; return false; }
            if (player.Perk[PE_PYROMANIAC] > 0 && player.Skill[SK_DOCTOR] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Pyromaniac" + colorNormal; return false; }
            if (player.Perk[PE_SNIPER] > 0 && player.Skill[SK_DOCTOR] < 175 && !hasRangedSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Sniper" + colorNormal; return false; }

            if (player.Perk[PE_MORE_CRITICALS] > 0 && player.Skill[SK_DOCTOR] < 50 && !hasCombatSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn +  "More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_EVEN_MORE_CRITICALS] > 0 && player.Skill[SK_DOCTOR] < 75 && !hasCombatSkillAtLeastWithout(player, 75, currentTagIndex)) { reason = colorWarn +  "Even More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_SHARPSHOOTER] > 0 && player.Skill[SK_DOCTOR] < 100 && !hasCombatSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Sharpshooter" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RATE_OF_ATTACK] > 0 && player.Skill[SK_DOCTOR] < 175 && !hasCombatSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Bonus Rate of Attack" + colorNormal; return false; }

            if (player.Perk[PE_MEDIC] > 0 && player.Skill[currentTagIndex] < 75) { reason = colorWarn +  "Medic" + colorNormal; return false; }
            if (player.Perk[PE_FIELD_MEDIC] > 0 && player.Skill[currentTagIndex] < 150) { reason = colorWarn +  "Field Medic" + colorNormal; return false; }
            if (player.Perk[PE_DEAD_MAN_WALKING] > 0 && player.Skill[currentTagIndex] < 50) { reason = colorWarn +  "Dead Man Walking" + colorNormal; return false; }
            if (player.Perk[PE_FASTER_HEALING] > 0 && player.Skill[currentTagIndex] < 75) { reason = colorWarn +  "Faster Healing" + colorNormal; return false; }
            if (player.Perk[PE_RAD_RESISTANCE] > 0 && player.Skill[currentTagIndex] < 100) { reason = colorWarn +  "Rad Resistance" + colorNormal; return false; }
        }
        if (skillIndex == SK_TRAPS || currentTagIndex == SK_TRAPS) {
            if (player.Perk[PE_WEAPON_HANDLING] > 0 && player.Skill[SK_TRAPS] < 50 && !hasRangedSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn +  "Weapon Handling" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RANGED_DAMAGE] > 0 && player.Skill[SK_TRAPS] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Bonus Ranged Damage" + colorNormal; return false; }
            if (player.Perk[PE_MORE_RANGED_DAMAGE] > 0 && player.Skill[SK_TRAPS] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "More Ranged Damage" + colorNormal; return false; }
            if (player.Perk[PE_PYROMANIAC] > 0 && player.Skill[SK_TRAPS] < 100 && !hasRangedSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Pyromaniac" + colorNormal; return false; }
            if (player.Perk[PE_SNIPER] > 0 && player.Skill[SK_TRAPS] < 175 && !hasRangedSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Sniper" + colorNormal; return false; }

            if (player.Perk[PE_MORE_CRITICALS] > 0 && player.Skill[SK_TRAPS] < 50 && !hasCombatSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn +  "More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_EVEN_MORE_CRITICALS] > 0 && player.Skill[SK_TRAPS] < 75 && !hasCombatSkillAtLeastWithout(player, 75, currentTagIndex)) { reason = colorWarn +  "Even More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_SHARPSHOOTER] > 0 && player.Skill[SK_TRAPS] < 100 && !hasCombatSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Sharpshooter" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RATE_OF_ATTACK] > 0 && player.Skill[SK_TRAPS] < 175 && !hasCombatSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Bonus Rate of Attack" + colorNormal; return false; }

            if (player.Perk[PE_LIGHT_STEP] > 0 && player.Skill[currentTagIndex] < 50) { reason = colorWarn +  "Light Step" + colorNormal; return false; }
            if (player.Perk[PE_DEMOLITION_EXPERT] > 0 && player.Skill[currentTagIndex] < 125) { reason = colorWarn +  "Demolition Expert" + colorNormal; return false; }
        }
    }
    if (skillIndex == SK_UNARMED || currentTagIndex == SK_UNARMED) {
        if (skillIndex == SK_THROWING || currentTagIndex == SK_THROWING) {
            if (player.Perk[PE_HEAVE_HO] > 0 && player.Skill[SK_UNARMED] < 100) { reason = colorWarn +  "Heave Ho!" + colorNormal; return false; }
        }
        if (skillIndex == SK_SNEAK || currentTagIndex == SK_SNEAK) {
            if (player.Perk[PE_IN_YOUR_FACE] > 0 && player.Skill[SK_SNEAK] < 75) { reason = colorWarn +  "In Your Face" + colorNormal; return false; }
            if (player.Perk[PE_CLOSE_COMBAT_MASTER] > 0 && player.Skill[SK_SNEAK] < 100) { reason = colorWarn +  "Close Combat Master" + colorNormal; return false; }

            if (player.Perk[PE_MORE_CRITICALS] > 0 && player.Skill[SK_SNEAK] < 50 && !hasCombatSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn +  "More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_EVEN_MORE_CRITICALS] > 0 && player.Skill[SK_SNEAK] < 75 && !hasCombatSkillAtLeastWithout(player, 75, currentTagIndex)) { reason = colorWarn +  "Even More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_SHARPSHOOTER] > 0 && player.Skill[SK_SNEAK] < 100 && !hasCombatSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Sharpshooter" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RATE_OF_ATTACK] > 0 && player.Skill[SK_SNEAK] < 175 && !hasCombatSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Bonus Rate of Attack" + colorNormal; return false; }

            if (player.Perk[PE_SILENT_RUNNING] > 0 && player.Skill[SK_UNARMED] < 75) { reason = colorWarn +  "Silent Running" + colorNormal; return false; }
            if (player.Perk[PE_GHOST] > 0 && player.Skill[SK_UNARMED] < 125) { reason = colorWarn +  "Ghost" + colorNormal; return false; }
            if (player.Perk[PE_SILENT_DEATH] > 0 && player.Skill[SK_UNARMED] < 175) { reason = colorWarn +  "Silent Death" + colorNormal; return false; }
            if (player.Perk[PE_STEALTH_GIRL] > 0 && player.Skill[SK_UNARMED] < 100) { reason = colorWarn +  "Stealth Girl" + colorNormal; return false; }
        }
        if (skillIndex == SK_DOCTOR || currentTagIndex == SK_DOCTOR) {
            if (player.Perk[PE_IN_YOUR_FACE] > 0 && player.Skill[SK_DOCTOR] < 75) { reason = colorWarn +  "In Your Face" + colorNormal; return false; }
            if (player.Perk[PE_CLOSE_COMBAT_MASTER] > 0 && player.Skill[SK_DOCTOR] < 100) { reason = colorWarn +  "Close Combat Master" + colorNormal; return false; }

            if (player.Perk[PE_MORE_CRITICALS] > 0 && player.Skill[SK_DOCTOR] < 50 && !hasCombatSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn +  "More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_EVEN_MORE_CRITICALS] > 0 && player.Skill[SK_DOCTOR] < 75 && !hasCombatSkillAtLeastWithout(player, 75, currentTagIndex)) { reason = colorWarn +  "Even More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_SHARPSHOOTER] > 0 && player.Skill[SK_DOCTOR] < 100 && !hasCombatSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Sharpshooter" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RATE_OF_ATTACK] > 0 && player.Skill[SK_DOCTOR] < 175 && !hasCombatSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Bonus Rate of Attack" + colorNormal; return false; }

            if (player.Perk[PE_MEDIC] > 0 && player.Skill[SK_UNARMED] < 75) { reason = colorWarn +  "Medic" + colorNormal; return false; }
            if (player.Perk[PE_FIELD_MEDIC] > 0 && player.Skill[SK_UNARMED] < 150) { reason = colorWarn +  "Field Medic" + colorNormal; return false; }
            if (player.Perk[PE_DEAD_MAN_WALKING] > 0 && player.Skill[SK_UNARMED] < 50) { reason = colorWarn +  "Dead Man Walking" + colorNormal; return false; }
            if (player.Perk[PE_FASTER_HEALING] > 0 && player.Skill[SK_UNARMED] < 75) { reason = colorWarn +  "Faster Healing" + colorNormal; return false; }
            if (player.Perk[PE_RAD_RESISTANCE] > 0 && player.Skill[SK_UNARMED] < 100) { reason = colorWarn +  "Rad Resistance" + colorNormal; return false; }
        }
        if (skillIndex == SK_TRAPS || currentTagIndex == SK_TRAPS) {
            if (player.Perk[PE_IN_YOUR_FACE] > 0 && player.Skill[SK_TRAPS] < 75) { reason = colorWarn +  "In Your Face" + colorNormal; return false; }
            if (player.Perk[PE_CLOSE_COMBAT_MASTER] > 0 && player.Skill[SK_TRAPS] < 100) { reason = colorWarn +  "Close Combat Master" + colorNormal; return false; }

            if (player.Perk[PE_MORE_CRITICALS] > 0 && player.Skill[SK_TRAPS] < 50 && !hasCombatSkillAtLeastWithout(player, 50, currentTagIndex)) { reason = colorWarn +  "More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_EVEN_MORE_CRITICALS] > 0 && player.Skill[SK_TRAPS] < 75 && !hasCombatSkillAtLeastWithout(player, 75, currentTagIndex)) { reason = colorWarn +  "Even More Criticals" + colorNormal; return false; }
            if (player.Perk[PE_SHARPSHOOTER] > 0 && player.Skill[SK_TRAPS] < 100 && !hasCombatSkillAtLeastWithout(player, 100, currentTagIndex)) { reason = colorWarn +  "Sharpshooter" + colorNormal; return false; }
            if (player.Perk[PE_BONUS_RATE_OF_ATTACK] > 0 && player.Skill[SK_TRAPS] < 175 && !hasCombatSkillAtLeastWithout(player, 175, currentTagIndex)) { reason = colorWarn +  "Bonus Rate of Attack" + colorNormal; return false; }

            if (player.Perk[PE_LIGHT_STEP] > 0 && player.Skill[SK_UNARMED] < 50) { reason = colorWarn +  "Light Step" + colorNormal; return false; }
            if (player.Perk[PE_DEMOLITION_EXPERT] > 0 && player.Skill[SK_UNARMED] < 125) { reason = colorWarn +  "Demolition Expert" + colorNormal; return false; }
        }
    }
    if (skillIndex == SK_SNEAK || currentTagIndex == SK_SNEAK) {
        if (skillIndex == SK_THROWING || currentTagIndex == SK_THROWING) {
            if (player.Perk[PE_HEAVE_HO] > 0 && player.Skill[SK_SNEAK] < 100) { reason = colorWarn +  "Heave Ho!" + colorNormal; return false; }
        }
        if (skillIndex == SK_DOCTOR || currentTagIndex == SK_DOCTOR) {
            if (player.Perk[PE_SILENT_RUNNING] > 0 && player.Skill[SK_DOCTOR] < 75) { reason = colorWarn +  "Silent Running" + colorNormal; return false; }
            if (player.Perk[PE_GHOST] > 0 && player.Skill[SK_DOCTOR] < 125) { reason = colorWarn +  "Ghost" + colorNormal; return false; }
            if (player.Perk[PE_SILENT_DEATH] > 0 && player.Skill[SK_DOCTOR] < 175) { reason = colorWarn +  "Silent Death" + colorNormal; return false; }
            if (player.Perk[PE_STEALTH_GIRL] > 0 && player.Skill[SK_DOCTOR] < 100) { reason = colorWarn +  "Stealth Girl" + colorNormal; return false; }

            if (player.Perk[PE_MEDIC] > 0 && player.Skill[SK_SNEAK] < 75) { reason = colorWarn +  "Medic" + colorNormal; return false; }
            if (player.Perk[PE_FIELD_MEDIC] > 0 && player.Skill[SK_SNEAK] < 150) { reason = colorWarn +  "Field Medic" + colorNormal; return false; }
            if (player.Perk[PE_DEAD_MAN_WALKING] > 0 && player.Skill[SK_SNEAK] < 50) { reason = colorWarn +  "Dead Man Walking" + colorNormal; return false; }
            if (player.Perk[PE_FASTER_HEALING] > 0 && player.Skill[SK_SNEAK] < 75) { reason = colorWarn +  "Faster Healing" + colorNormal; return false; }
            if (player.Perk[PE_RAD_RESISTANCE] > 0 && player.Skill[SK_SNEAK] < 100) { reason = colorWarn +  "Rad Resistance" + colorNormal; return false; }
        }
        if (skillIndex == SK_TRAPS || currentTagIndex == SK_TRAPS) {
            if (player.Perk[PE_SILENT_RUNNING] > 0 && player.Skill[SK_TRAPS] < 75) { reason = colorWarn +  "Silent Running" + colorNormal; return false; }
            if (player.Perk[PE_GHOST] > 0 && player.Skill[SK_TRAPS] < 125) { reason = colorWarn +  "Ghost" + colorNormal; return false; }
            if (player.Perk[PE_SILENT_DEATH] > 0 && player.Skill[SK_TRAPS] < 175) { reason = colorWarn +  "Silent Death" + colorNormal; return false; }
            if (player.Perk[PE_STEALTH_GIRL] > 0 && player.Skill[SK_TRAPS] < 100) { reason = colorWarn +  "Stealth Girl" + colorNormal; return false; }

            if (player.Perk[PE_LIGHT_STEP] > 0 && player.Skill[SK_SNEAK] < 50) { reason = colorWarn +  "Light Step" + colorNormal; return false; }
            if (player.Perk[PE_DEMOLITION_EXPERT] > 0 && player.Skill[SK_SNEAK] < 125) { reason = colorWarn +  "Demolition Expert" + colorNormal; return false; }
        }
    }
    if (skillIndex == SK_DOCTOR || currentTagIndex == SK_DOCTOR) {
        if (skillIndex == SK_THROWING || currentTagIndex == SK_THROWING) {
            if (player.Perk[PE_HEAVE_HO] > 0 && player.Skill[SK_DOCTOR] < 100) { reason = colorWarn +  "Heave Ho!" + colorNormal; return false; }
        }
        if (skillIndex == SK_TRAPS || currentTagIndex == SK_TRAPS) {
            if (player.Perk[PE_MEDIC] > 0 && player.Skill[SK_TRAPS] < 75) { reason = colorWarn +  "Medic" + colorNormal; return false; }
            if (player.Perk[PE_FIELD_MEDIC] > 0 && player.Skill[SK_TRAPS] < 150) { reason = colorWarn +  "Field Medic" + colorNormal; return false; }
            if (player.Perk[PE_DEAD_MAN_WALKING] > 0 && player.Skill[SK_TRAPS] < 50) { reason = colorWarn +  "Dead Man Walking" + colorNormal; return false; }
            if (player.Perk[PE_FASTER_HEALING] > 0 && player.Skill[SK_TRAPS] < 75) { reason = colorWarn +  "Faster Healing" + colorNormal; return false; }
            if (player.Perk[PE_RAD_RESISTANCE] > 0 && player.Skill[SK_TRAPS] < 100) { reason = colorWarn +  "Rad Resistance" + colorNormal; return false; }

            if (player.Perk[PE_LIGHT_STEP] > 0 && player.Skill[SK_DOCTOR] < 50) { reason = colorWarn +  "Light Step" + colorNormal; return false; }
            if (player.Perk[PE_DEMOLITION_EXPERT] > 0 && player.Skill[SK_DOCTOR] < 125) { reason = colorWarn +  "Demolition Expert" + colorNormal; return false; }
        }
    }

    return true;
}

bool isRangedSkill(uint skillIndex) {
    if (skillIndex == SK_SMALL_GUNS || skillIndex == SK_BIG_GUNS || skillIndex == SK_ENERGY_WEAPONS || skillIndex == SK_THROWING) {
        return true;
    } else {
        return false;
    }
}

string getSkillName(uint skillIndex) {
    switch (skillIndex) {
        case SK_SMALL_GUNS: return "Small Guns";
        case SK_BIG_GUNS: return "Big Guns";
        case SK_ENERGY_WEAPONS: return "Energy Weapons";
        case SK_UNARMED: return "Unarmed";
        case SK_SCAVENGING: return "Scavenging";
        case SK_THROWING: return "Throwing";
        case SK_FIRST_AID: return "First Aid";
        case SK_DOCTOR: return "Doctor";
        case SK_SNEAK: return "Sneak";
        case SK_LOCKPICK: return "Lockpick";
        case SK_STEAL: return "Steal";
        case SK_TRAPS: return "Traps";
        case SK_SCIENCE: return "Science";
        case SK_REPAIR: return "Repair";
        case SK_SPEECH: return "Speech";
        case SK_BARTER: return "Barter";
        case SK_GAMBLING: return "Gambling";
        case SK_OUTDOORSMAN: return "Outdoorsman";
    }
    return "Index: " + skillIndex + " unknown.";
}

///
///     SPECIALS
///


bool d_CanChangeSpecial(Critter& player, Critter@ npc, int val1, int val2) {
    string reason = "";
    return canChangeSpecial(player, val1, val2, 0, reason);
}

void r_ChangeSpecial(Critter& player, Critter@ npc, int val1, int val2, int val3, int val4) {
    string reason = "";
    if (canChangeSpecial(player, val1, val2, 0, reason) && canChangeSpecial(player, val3, val4, 0, reason)) {
        changeSpecial(player, val1, val2);
        changeSpecial(player, val3, val4);
        int maxLife = recalcMaxLife(player);
        player.StatBase[ST_MAX_LIFE] = maxLife;
        int radiationResistBase = recalcRadiationResistBase(player);
        player.StatBase[ST_RADIATION_RESISTANCE] = radiationResistBase;
        int radiationResistExt = recalcRadiationResistExt(player);
        player.StatBase[ST_RADIATION_RESISTANCE_EXT] = radiationResistExt;
    }
}

/**
 * Show the SPECIALs the player currently has and the reason they can be decreased or increased. @lex specials@ is used.
 */
void dlg_SpecialList(Critter& player, Critter@ npc, string@ text) {
    if (!IS_DIALOG_GENERATED(text))
        return;

    string decreaseable = "-decreaseable-";
    string increaseable = "-increaseable-";
    string str = "";
    array<string> randomText = {"The radiated wind is killing me!", "Hey... is this thick hair or a tree growing on my head?!?", "Is my skin green?"
                                , "Why am I glowing? I haven't drunk that many bottles of Roentgen Rum!", "I'll sure leave behind a radiated corpse."};
    string listPrefix = "\t";
    string reason = "";

    str += randomText[Random(0, randomText.length() - 1)];
    str += "\n\n[List of your S.P.E.C.I.A.L.:]\n";
    str += listPrefix + "[ST " + ((player.StatBase[ST_STRENGTH] == 10) ? "" : ((player.StatBase[ST_STRENGTH] == 1) ? "  " : " ")) + player.StatBase[ST_STRENGTH] + ":  ";
    if (canChangeSpecial(player, 0, -1, 0, reason)) {
        str += decreaseable + ", ";
    } else {
        str += reason + ", ";
    }
    if (canChangeSpecial(player, 0, 1, 0, reason)) {
        str += increaseable + "]\n";
    } else {
        str += reason + "]\n";
    }

    str += listPrefix + "[PE " + ((player.StatBase[ST_PERCEPTION] == 10) ? "" : ((player.StatBase[ST_PERCEPTION] == 1) ? "  " : " ")) + player.StatBase[ST_PERCEPTION] + ":  ";
    if (canChangeSpecial(player, 1, -1, 0, reason)) {
        str += decreaseable + ", ";
    } else {
        str += reason + ", ";
    }
    if (canChangeSpecial(player, 1, 1, 0, reason)) {
        str += increaseable + "]\n";
    } else {
        str += reason + "]\n";
    }

    str += listPrefix + "[EN " + ((player.StatBase[ST_ENDURANCE] == 10) ? "" : ((player.StatBase[ST_ENDURANCE] == 1) ? "  " : " ")) + player.StatBase[ST_ENDURANCE] + ":  ";
    if (canChangeSpecial(player, 2, -1, 0, reason)) {
        str += decreaseable + ", ";
    } else {
        str += reason + ", ";
    }
    if (canChangeSpecial(player, 2, 1, 0, reason)) {
        str += increaseable + "]\n";
    } else {
        str += reason + "]\n";
    }

    str += listPrefix + "[CH " + ((player.StatBase[ST_CHARISMA] == 10) ? "" : ((player.StatBase[ST_CHARISMA] == 1) ? "  " : " ")) + player.StatBase[ST_CHARISMA] + ":  ";
    if (canChangeSpecial(player, 3, -1, 0, reason)) {
        str += decreaseable + ", ";
    } else {
        str += reason + ", ";
    }
    if (canChangeSpecial(player, 3, 1, 0, reason)) {
        str += increaseable + "]\n";
    } else {
        str += reason + "]\n";
    }

    str += listPrefix + "[IN " + ((player.StatBase[ST_INTELLECT] == 10) ? "" : ((player.StatBase[ST_INTELLECT] == 1) ? "  " : " ")) + player.StatBase[ST_INTELLECT] + ":  ";
    if (canChangeSpecial(player, 4, -1, 0, reason)) {
        str += decreaseable + ", ";
    } else {
        str += reason + ", ";
    }
    if (canChangeSpecial(player, 4, 1, 0, reason)) {
        str += increaseable + "]\n";
    } else {
        str += reason + "]\n";
    }

    str += listPrefix + "[AG" + ((player.StatBase[ST_AGILITY] == 10) ? "" : ((player.StatBase[ST_AGILITY] == 1) ? "  " : " ")) + player.StatBase[ST_AGILITY] + ":  ";
    if (canChangeSpecial(player, 5, -1, 0, reason)) {
        str += decreaseable + ", ";
    } else {
        str += reason + ", ";
    }
    if (canChangeSpecial(player, 5, 1, 0, reason)) {
        str += increaseable + "]\n";
    } else {
        str += reason + "]\n";
    }

    str += listPrefix + "[LK " + ((player.StatBase[ST_LUCK] == 10) ? "" : ((player.StatBase[ST_LUCK] == 1) ? "  " : " ")) + player.StatBase[ST_LUCK] + ":  ";
    if (canChangeSpecial(player, 6, -1, 0, reason)) {
        str += decreaseable + ", ";
    } else {
        str += reason + ", ";
    }
    if (canChangeSpecial(player, 6, 1, 0, reason)) {
        str += increaseable + "]\n";
    } else {
        str += reason + "]\n";
    }


    text = "$specials " + str;
    if (text.length() > 998) {
        text = substring(text, 0, 998);
    }
}

string getSpecialName(uint specialIndex) {
    string specialName = "";
    switch (specialIndex) {
        case ST_STRENGTH:
            specialName = "Strength";
            break;
        case ST_PERCEPTION:
            specialName = "Perception";
            break;
        case ST_ENDURANCE:
            specialName = "Endurance";
            break;
        case ST_CHARISMA:
            specialName = "Charisma";
            break;
        case ST_INTELLECT:
            specialName = "Intellect";
            break;
        case ST_AGILITY:
            specialName = "Agility";
            break;
        case ST_LUCK:
            specialName = "Luck";
            break;
        default:
            specialName = "Special";
    }
    return specialName;
}

bool canChangeSpecial(Critter& player, uint specialIndex, int byValue, uint ignoreIndex, string@ reason) {
    if (ST_STRENGTH > specialIndex || ST_LUCK < specialIndex) {
        reason = colorError + " Error: Special index out of bounds." + colorNormal;
        return false;
    }
    string specialName = getSpecialName(specialIndex);

    if (player.StatBase[specialIndex] + byValue < 1) {
        reason = colorWarn + specialName + " too low." + colorNormal;
        return false;
    }
    if (player.StatBase[specialIndex] + byValue > 10) {
        reason = colorWarn + specialName + " too high." + colorNormal;
        return false;
    }
    switch (specialIndex) {
        case ST_STRENGTH:
            if (player.Perk[PE_ADRENALINE_RUSH] > 0 && player.StatBase[ST_STRENGTH] + byValue < 5) {
                reason = colorWarn + "Blocked by Adrenaline Rush perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_STONEWALL] > 0 && player.StatBase[ST_STRENGTH] + byValue < 6) {
                reason = colorWarn + "Blocked by Stonewall perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_GAIN_STRENGTH] > 0 && ignoreIndex != PE_GAIN_STRENGTH) {
                if (player.StatBase[ST_STRENGTH] + byValue < 3) {
                    reason = colorWarn + "Blocked by Gain Strength perk." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_BRUISER] > 0 && ignoreIndex != TRAIT_BRUISER && player.StatBase[ST_STRENGTH] + byValue < 6) {
                    reason = colorWarn + "Blocked by Gain Strength perk and Bruiser trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_HEAVY_HANDED] > 0 && ignoreIndex != TRAIT_HEAVY_HANDED && player.StatBase[ST_STRENGTH] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Strength perk and Bruiser trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_BRUISER] > 0 && ignoreIndex != TRAIT_BRUISER && player.Trait[TRAIT_HEAVY_HANDED] > 0
                        && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_STRENGTH] + byValue < 7) {
                    reason = colorWarn + "Blocked by Gain Strength perk, Bruiser and Heavy Handed traits." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_STRENGTH] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Strength perk and Gifted trait." + colorNormal;
                    return false;
                }
            } else {
                if (player.Trait[TRAIT_BRUISER] > 0 && ignoreIndex != TRAIT_BRUISER && player.StatBase[ST_STRENGTH] + byValue < 4) {
                    reason = colorWarn + "Blocked by Bruiser trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_HEAVY_HANDED] > 0 && ignoreIndex != TRAIT_HEAVY_HANDED && player.StatBase[ST_STRENGTH] + byValue < 2) {
                    reason = colorWarn + "Blocked by Bruiser trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_BRUISER] > 0 && ignoreIndex != TRAIT_BRUISER
                        && player.Trait[TRAIT_HEAVY_HANDED] > 0 && ignoreIndex != TRAIT_HEAVY_HANDED && player.StatBase[ST_STRENGTH] + byValue < 5) {
                    reason = colorWarn + "Blocked by Bruiser and Heavy Handed traits." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_STRENGTH] + byValue < 2) {
                    reason = colorWarn + "Blocked by Gifted trait." + colorNormal;
                    return false;
                }
            }
            break;
        case ST_PERCEPTION:
            if (player.Perk[PE_SHARPSHOOTER] > 0 && player.StatBase[ST_PERCEPTION] + byValue < 7) {
                reason = colorWarn + "Blocked by Sharpshooter perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_GAIN_PERCEPTION] > 0 && ignoreIndex != PE_GAIN_PERCEPTION) {
                if (player.StatBase[ST_PERCEPTION] + byValue < 3) {
                    reason = colorWarn + "Blocked by Gain Perception perk." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_CAUTIOUS_NATURE] > 0 && ignoreIndex != TRAIT_CAUTIOUS_NATURE && player.StatBase[ST_PERCEPTION] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Perception perk and Cautious Nature trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_PERCEPTION] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Perception perk and Gifted trait." + colorNormal;
                    return false;
                }
            } else {
                if (player.Trait[TRAIT_CAUTIOUS_NATURE] > 0 && ignoreIndex != TRAIT_CAUTIOUS_NATURE && player.StatBase[ST_PERCEPTION] + byValue < 2) {
                    reason = colorWarn + "Blocked by Cautious Nature trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_PERCEPTION] + byValue < 2) {
                    reason = colorWarn + "Blocked by Gifted trait." + colorNormal;
                    return false;
                }
            }
            break;
        case ST_ENDURANCE:
            if (player.Perk[PE_IRON_LIMBS] > 0 && player.StatBase[ST_ENDURANCE] + byValue < 6) {
                reason = colorWarn + "Blocked by Iron Limbs perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_TOUGHNESS] > 0 && player.StatBase[ST_ENDURANCE] + byValue < 4) {
                reason = colorWarn + "Blocked by Toughness perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_EVEN_TOUGHER] > 0 && player.StatBase[ST_ENDURANCE] + byValue < 5) {
                reason = colorWarn + "Blocked by Even Tougher perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_MAN_OF_STEEL] > 0 && player.StatBase[ST_ENDURANCE] + byValue < 6) {
                reason = colorWarn + "Blocked by Man of Steel perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_GAIN_ENDURANCE] > 0 && ignoreIndex != PE_GAIN_ENDURANCE) {
                if (player.StatBase[ST_ENDURANCE] + byValue < 3) {
                    reason = colorWarn + "Blocked by Gain Endurance perk." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_ENDURANCE] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Endurance perk and Gifted trait." + colorNormal;
                    return false;
                }
            } else {
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_ENDURANCE] + byValue < 2) {
                    reason = colorWarn + "Blocked by Gifted trait." + colorNormal;
                    return false;
                }
            }
            break;
        case ST_CHARISMA:
            if (player.Perk[PE_WAY_OF_THE_FRUIT] > 0 && player.StatBase[ST_CHARISMA] + byValue < 4) {
                reason = colorWarn + "Blocked by Way of the Fruit perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_SPRAY_AND_PRAY] > 0 && player.StatBase[ST_CHARISMA] + byValue < 3) {
                reason = colorWarn + "Blocked by Way of the Fruit perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_MORE_RANGED_DAMAGE] > 0 && player.StatBase[ST_CHARISMA] + byValue < 4) {
                reason = colorWarn + "Blocked by More Ranged Damage perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_GAIN_CHARISMA] > 0 && ignoreIndex != PE_GAIN_CHARISMA) {
                if (player.StatBase[ST_CHARISMA] + byValue < 3) {
                    reason = colorWarn + "Blocked by Gain Charisma perk." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_CHARISMA] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Charisma perk and Gifted trait." + colorNormal;
                    return false;
                }
            } else {
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_CHARISMA] + byValue < 2) {
                    reason = colorWarn + "Blocked by Gifted trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_BRUTISH_HULK] > 0 && ignoreIndex != TRAIT_BRUTISH_HULK && player.StatBase[ST_CHARISMA] + byValue > 9) {
                    reason = colorWarn + "Blocked by Brutish Hulk trait." + colorNormal;
                    return false;
                }
            }
            break;
        case ST_INTELLECT:
            if (player.Perk[PE_HEALER_II] > 0 && player.StatBase[ST_INTELLECT] + byValue < 4) {
                reason = colorWarn + "Blocked by Healer perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_SHARPSHOOTER] > 0 && player.StatBase[ST_INTELLECT] + byValue < 3) {
                reason = colorWarn + "Blocked by Sharpshooter perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_MEDIC] > 0 && player.StatBase[ST_INTELLECT] + byValue < 5) {
                reason = colorWarn + "Blocked by Medic perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_GAIN_INTELLIGENCE] > 0 && ignoreIndex != PE_GAIN_INTELLIGENCE) {
                if (player.StatBase[ST_INTELLECT] + byValue < 3) {
                    reason = colorWarn + "Blocked by Gain Intellect perk." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_FINESSE] > 0 && ignoreIndex != TRAIT_FINESSE && player.StatBase[ST_INTELLECT] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Intellect perk and Finesse trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_INTELLECT] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Intellect perk and Gifted trait." + colorNormal;
                    return false;
                }
            } else {
                if (player.Trait[TRAIT_FINESSE] > 0 && ignoreIndex != TRAIT_FINESSE && player.StatBase[ST_INTELLECT] + byValue < 2) {
                    reason = colorWarn + "Blocked by Finesse trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_INTELLECT] + byValue < 2) {
                    reason = colorWarn + "Blocked by Gifted trait." + colorNormal;
                    return false;
                }
            }
            break;
        case ST_AGILITY:
            if (player.Perk[PE_QUICK_POCKETS] > 0 && player.StatBase[ST_AGILITY] + byValue < 5) {
                reason = colorWarn + "Blocked by Quick Pockets perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_QUICK_RECOVERY] > 0 && player.StatBase[ST_AGILITY] + byValue < 6) {
                reason = colorWarn + "Blocked by Quick Recovery perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_LIVEWIRE] > 0 && player.StatBase[ST_AGILITY] + byValue < 7) {
                reason = colorWarn + "Blocked by Livewire perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_ACTION_BOY] > 0 && player.StatBase[ST_AGILITY] + byValue < 5) {
                reason = colorWarn + "Blocked by Action Boy perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_GAIN_AGILITY] > 0 && ignoreIndex != PE_GAIN_AGILITY) {
                if (player.StatBase[ST_AGILITY] + byValue < 3) {
                    reason = colorWarn + "Blocked by Gain Agility perk." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_KAMIKAZE] > 0 && ignoreIndex != TRAIT_KAMIKAZE && player.StatBase[ST_AGILITY] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Agility perk and Kamikaze trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_FAST_SHOT] > 0 && ignoreIndex != TRAIT_FAST_SHOT && player.StatBase[ST_AGILITY] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Agility perk and Fast Shot trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_DOUBLE_TAP] > 0 && ignoreIndex != TRAIT_DOUBLE_TAP && player.StatBase[ST_AGILITY] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Agility perk and Double Tap trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_AGILITY] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Agility perk and Gifted trait." + colorNormal;
                    return false;
                }
            } else {
                if (player.Trait[TRAIT_KAMIKAZE] > 0 && ignoreIndex != TRAIT_KAMIKAZE && player.StatBase[ST_AGILITY] + byValue < 2) {
                    reason = colorWarn + "Blocked by Kamikaze trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_FAST_SHOT] > 0 && ignoreIndex != TRAIT_FAST_SHOT && player.StatBase[ST_AGILITY] + byValue < 2) {
                    reason = colorWarn + "Blocked by Fast Shot trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_DOUBLE_TAP] > 0 && ignoreIndex != TRAIT_DOUBLE_TAP && player.StatBase[ST_AGILITY] + byValue < 2) {
                    reason = colorWarn + "Blocked by Double Tap trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_AGILITY] + byValue < 2) {
                    reason = colorWarn + "Blocked by Gifted trait." + colorNormal;
                    return false;
                }
            }
            break;
        case ST_LUCK:
            if (player.Perk[PE_SPRAY_AND_PRAY] > 0 && player.StatBase[ST_LUCK] + byValue < 5) {
                reason = colorWarn + "Blocked by Spray and Pray perk." + colorNormal;
                return false;
            }
            if (player.Perk[PE_GAIN_LUCK] > 0 && ignoreIndex != PE_GAIN_LUCK) {
                if (player.StatBase[ST_LUCK] + byValue < 3) {
                    reason = colorWarn + "Blocked by Gain Luck perk." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_LUCK] + byValue < 4) {
                    reason = colorWarn + "Blocked by Gain Luck perk and Gifted trait." + colorNormal;
                    return false;
                }
            } else {
                if (player.Trait[TRAIT_GIFTED] > 0 && ignoreIndex != TRAIT_GIFTED && player.StatBase[ST_LUCK] + byValue < 2) {
                    reason = colorWarn + "Blocked by Gifted trait." + colorNormal;
                    return false;
                }
                if (player.Trait[TRAIT_JINXED] > 0 && ignoreIndex != TRAIT_JINXED && player.StatBase[ST_LUCK] + byValue > 9) {
                    reason = colorWarn + "Blocked by Jinxed trait." + colorNormal;
                    return false;
                }
            }
            break;
        default:
            return true;
    }
    return true;
}

void changeSpecial(Critter& player, uint specialIndex, int byValue) {
    string reason = "";
    if (canChangeSpecial(player, specialIndex, byValue, 0, reason)) {
        player.StatBase[specialIndex] += byValue;
        if (player.StatBase[specialIndex] > 10 || player.StatBase[specialIndex] < 1) {
            MutationLogWarn("Invalid SPECIAL base for player/critter. Investigate. (" + player.Name + ", " + getSpecialName(specialIndex) + ", " + player.StatBase[specialIndex]);
        }
    } else {
        MutationLogError("Try to change special code reached but special cannot be changed. Investigate.");
    }
}

///
///     TRAITS
///


bool d_CanRemoveTrait(Critter& player, Critter@ npc, int val) {
    uint traitIndex = uint(val);
    string reason = "";
    return canRemoveTrait(player, traitIndex, reason);
}

bool d_CanAddTrait(Critter& player, Critter@ npc, int val) {
    uint traitIndex = uint(val);
    string reason = "";
    return canAddTrait(player, traitIndex, reason);
}

void r_RemoveTrait(Critter& player, Critter@ npc, int val) {
    uint traitIndex = uint(val);
    string reason = "";
    if (canRemoveTrait(player, traitIndex, reason)) {
        removeTrait(player, traitIndex);
    }
    int maxLife = recalcMaxLife(player);
    player.StatBase[ST_MAX_LIFE] = maxLife;
    int radiationResistBase = recalcRadiationResistBase(player);
    player.StatBase[ST_RADIATION_RESISTANCE] = radiationResistBase;
    int radiationResistExt = recalcRadiationResistExt(player);
    player.StatBase[ST_RADIATION_RESISTANCE_EXT] = radiationResistExt;
}

void r_AddTrait(Critter& player, Critter@ npc, int val) {
    uint traitIndex = uint(val);
    string reason = "";
    if (canAddTrait(player, traitIndex, reason)) {
        addTrait(player, traitIndex);
    }
    int maxLife = recalcMaxLife(player);
    player.StatBase[ST_MAX_LIFE] = maxLife;
    int radiationResistBase = recalcRadiationResistBase(player);
    player.StatBase[ST_RADIATION_RESISTANCE] = radiationResistBase;
    int radiationResistExt = recalcRadiationResistExt(player);
    player.StatBase[ST_RADIATION_RESISTANCE_EXT] = radiationResistExt;
}

bool canRemoveTrait(Critter& player, uint traitIndex, string@ reason) {
    if (TRAIT_BEGIN > traitIndex || TRAIT_END < traitIndex) {
        reason = colorError + "Error: Trait index out of bounds." + colorNormal;
        return false;
    }
    if (player.Trait[traitIndex] <= 0) {
        reason = colorWarn + "Does not have this trait." + colorNormal;
        return false;
    }
    switch (traitIndex) {
        case TRAIT_FAST_METABOLISM:
        case TRAIT_ONE_HANDER:
        case TRAIT_BLOODY_MESS:
        case TRAIT_CHEM_RELIANT:
            return true;
        case TRAIT_HEAVY_HANDED:
            if (!canChangeSpecial(player, ST_STRENGTH, -1, TRAIT_HEAVY_HANDED, reason)) {
                return false;
            }
            return true;
        case TRAIT_BRUISER:
            if (!canChangeSpecial(player, ST_STRENGTH, -3, TRAIT_BRUISER, reason)) {
                return false;
            }
            return true;
        case TRAIT_FINESSE:
            if (!canChangeSpecial(player, ST_INTELLECT, -1, TRAIT_FINESSE, reason)) {
                return false;
            }
            return true;
        case TRAIT_KAMIKAZE:
            if (!canChangeSpecial(player, ST_AGILITY, -1, TRAIT_KAMIKAZE, reason)) {
                return false;
            }
            return true;
        case TRAIT_FAST_SHOT:
            if (!canChangeSpecial(player, ST_AGILITY, -1, TRAIT_FAST_SHOT, reason)) {
                return false;
            }
            return true;
        case TRAIT_DOUBLE_TAP:
            if (!canChangeSpecial(player, ST_AGILITY, -1, TRAIT_DOUBLE_TAP, reason)) {
                return false;
            }
            return true;
        case TRAIT_JINXED:
            if (!canChangeSpecial(player, ST_LUCK, +1, TRAIT_JINXED, reason)) {
                return false;
            }
            return true;
        case TRAIT_GOOD_NATURED:
            if (!canChangeSpecial(player, ST_CHARISMA, -1, TRAIT_GOOD_NATURED, reason)) {
                return false;
            }
            return true;
        case TRAIT_BRUTISH_HULK:
            if (!canChangeSpecial(player, ST_CHARISMA, +1, TRAIT_BRUTISH_HULK, reason)) {
                return false;
            }
            return true;
        case TRAIT_CAUTIOUS_NATURE:
            if (!canChangeSpecial(player, ST_PERCEPTION, -1, TRAIT_CAUTIOUS_NATURE, reason)) {
                return false;
            }
            return true;
        case TRAIT_GIFTED:
            for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                if (!canChangeSpecial(player, i, -1, TRAIT_GIFTED, reason)) {
                    return false;
                }
            }
            return true;
        case TRAIT_LONER:
            reason = colorError + "This HARDCORE MODE trait cannot be altered."  + colorNormal;
            return false;
        default:
            return false;
    }
    return false;
}

bool canAddTrait(Critter& player, uint traitIndex, string@ reason) {
    reason = "";
    string exclusiveTrait = "Exclusive Trait of this type.";
    if (TRAIT_BEGIN > traitIndex || TRAIT_END < traitIndex) {
        reason = colorError + "Error: Trait index out of bounds." + colorNormal;
        return false;
    }
    if (player.Trait[traitIndex] > 0) {
        reason = colorAlreadyHave + "Already have." + colorNormal;
        return false;
    }
    if (usedTraitPoints(player) >= 2) {
        reason = colorWarn + "Maximum 2 traits." + colorNormal;
        return false;
    }
    switch (traitIndex) {
        case TRAIT_FAST_METABOLISM:
        case TRAIT_ONE_HANDER:
        case TRAIT_BLOODY_MESS:
        case TRAIT_CHEM_RELIANT:
            return true;
        case TRAIT_HEAVY_HANDED:
            if (!canChangeSpecial(player, ST_STRENGTH, +1, TRAIT_HEAVY_HANDED, reason)) {
                return false;
            }
            return true;
        case TRAIT_BRUISER:
            if (!canChangeSpecial(player, ST_STRENGTH, +3, TRAIT_BRUISER, reason)) {
                return false;
            }
            return true;
        case TRAIT_FINESSE:
            if (hasExclusiveTrait(player)) {
                reason = colorWarn + exclusiveTrait + colorNormal;
                return false;
            }
            if (!canChangeSpecial(player, ST_INTELLECT, +1, TRAIT_FINESSE, reason)) {
                return false;
            }
            return true;
        case TRAIT_KAMIKAZE:
            if (hasExclusiveTrait(player)) {
                reason = colorWarn + exclusiveTrait + colorNormal;
                return false;
            }
            if (!canChangeSpecial(player, ST_AGILITY, +1, TRAIT_KAMIKAZE, reason)) {
                return false;
            }
            return true;
        case TRAIT_FAST_SHOT:
            if (hasExclusiveTrait(player)) {
                reason = colorWarn + exclusiveTrait + colorNormal;
                return false;
            }
            if (!canChangeSpecial(player, ST_AGILITY, +1, TRAIT_FAST_SHOT, reason)) {
                return false;
            }
            return true;
        case TRAIT_DOUBLE_TAP:
            if (hasExclusiveTrait(player)) {
                reason = colorWarn + exclusiveTrait + colorNormal;
                return false;
            }
            if (!canChangeSpecial(player, ST_AGILITY, +1, TRAIT_DOUBLE_TAP, reason)) {
                return false;
            }
            return true;
        case TRAIT_JINXED:
            if (!canChangeSpecial(player, ST_LUCK, -1, TRAIT_JINXED, reason)) {
                return false;
            }
            return true;
        case TRAIT_GOOD_NATURED:
            if (!canChangeSpecial(player, ST_CHARISMA, +1, TRAIT_GOOD_NATURED, reason)) {
                return false;
            }
            return true;
        case TRAIT_BRUTISH_HULK:
            if (!canChangeSpecial(player, ST_CHARISMA, -1, TRAIT_BRUTISH_HULK, reason)) {
                return false;
            }
            return true;
        case TRAIT_CAUTIOUS_NATURE:
            if (hasExclusiveTrait(player)) {
                reason = colorWarn + exclusiveTrait + colorNormal;
                return false;
            }
            if (!canChangeSpecial(player, ST_PERCEPTION, +1, TRAIT_CAUTIOUS_NATURE, reason)) {
                return false;
            }
            return true;
        case TRAIT_GIFTED:
            if (usedTraitPoints(player) > 0) {
                reason = colorWarn + "Needs 2 unused trait points." + colorNormal;
                return false;
            }
            for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                if (!canChangeSpecial(player, i, +1, TRAIT_GIFTED, reason)) {
                    return false;
                }
            }
            return true;
        case TRAIT_LONER:
            reason = colorError + "This HARDCORE MODE trait cannot be altered." + colorNormal;
            return false;
        default:
            return false;
    }
    return false;
}

/**
