void addTrait(Critter& player, uint traitIndex) {
    string reason = "";
    bool canChangeGifted = false;

    if (player.TraitBase[traitIndex] > 0) {
        return;
    }
    if (usedTraitPoints(player) >= 2) {
        return;
    }

    switch (traitIndex) {
        case TRAIT_FAST_METABOLISM:
        case TRAIT_ONE_HANDER:
        case TRAIT_BLOODY_MESS:
        case TRAIT_CHEM_RELIANT:
            player.TraitBase[traitIndex] = 1;
            break;
        case TRAIT_BRUISER:
            if (canChangeSpecial(player, ST_STRENGTH, +3, TRAIT_BRUISER, reason)) {
                player.StatBase[ST_STRENGTH] += 3;
                player.StatBase[ST_ACTION_POINTS] += -1;
                player.TraitBase[traitIndex] = 1;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_FINESSE:
            if (canChangeSpecial(player, ST_INTELLECT, +1, TRAIT_FINESSE, reason) && !hasExclusiveTrait(player)) {
                player.StatBase[ST_INTELLECT] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_KAMIKAZE:
            if (canChangeSpecial(player, ST_AGILITY, +1, TRAIT_KAMIKAZE, reason) && !hasExclusiveTrait(player)) {
                player.StatBase[ST_AGILITY] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_FAST_SHOT:
            if (canChangeSpecial(player, ST_AGILITY, +1, TRAIT_FAST_SHOT, reason) && !hasExclusiveTrait(player)) {
                player.StatBase[ST_AGILITY] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_DOUBLE_TAP:
            if (canChangeSpecial(player, ST_AGILITY, +1, TRAIT_DOUBLE_TAP, reason) && !hasExclusiveTrait(player)) {
                player.StatBase[ST_AGILITY] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_HEAVY_HANDED:
            if (canChangeSpecial(player, ST_STRENGTH, +1, TRAIT_HEAVY_HANDED, reason)) {
                player.StatBase[ST_STRENGTH] += 1;
                player.StatBase[ST_MELEE_DAMAGE] += 5;
                player.TraitBase[traitIndex] = 1;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_JINXED:
            if (canChangeSpecial(player, ST_LUCK, -1, TRAIT_JINXED, reason)) {
                player.StatBase[ST_LUCK] += -1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_GOOD_NATURED:
            if (canChangeSpecial(player, ST_CHARISMA, +1, TRAIT_GOOD_NATURED, reason)) {
                player.StatBase[ST_CHARISMA] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_BRUTISH_HULK:
            if (canChangeSpecial(player, ST_CHARISMA, -1, TRAIT_BRUTISH_HULK, reason)) {
                player.StatBase[ST_CHARISMA] += -1;
                player.StatBase[ST_MELEE_DAMAGE] += +3;
                player.StatBase[ST_MAX_LIFE] += 12;
                player.TraitBase[traitIndex] = 1;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_CAUTIOUS_NATURE:
            if (canChangeSpecial(player, ST_PERCEPTION, +1, TRAIT_CAUTIOUS_NATURE, reason) && !hasExclusiveTrait(player)) {
                player.StatBase[ST_PERCEPTION] += 1;
                player.TraitBase[traitIndex] = 1;
            }
            break;
        case TRAIT_GIFTED:
            if (usedTraitPoints(player) > 0) {
                return;
            }
            canChangeGifted = true;
            for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                if (!canChangeSpecial(player, i, +1, TRAIT_GIFTED, reason)) {
                    canChangeGifted = false;
                }
            }
            if (canChangeGifted) {
                for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                    player.StatBase[i] += 1;
                }
                player.TraitBase[traitIndex] = 1;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_LONER:
            if (canAddTrait(player, TRAIT_LONER, reason)) {
                player.TraitBase[traitIndex] = 1;
            }
            break;
        default:
    }
}

void removeTrait(Critter& player, uint traitIndex) {
    string reason = "";
    bool canChangeGifted = false;

    if (player.TraitBase[traitIndex] == 0) {
        return;
    }

    switch (traitIndex) {
        case TRAIT_FAST_METABOLISM:
        case TRAIT_ONE_HANDER:
        case TRAIT_BLOODY_MESS:
        case TRAIT_CHEM_RELIANT:
            player.TraitBase[traitIndex] = 0;
            break;
        case TRAIT_BRUISER:
            if (canChangeSpecial(player, ST_STRENGTH, -3, TRAIT_BRUISER, reason)) {
                player.StatBase[ST_STRENGTH] += -3;
                player.StatBase[ST_ACTION_POINTS] += 1;
                player.TraitBase[traitIndex] = 0;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_FINESSE:
            if (canChangeSpecial(player, ST_INTELLECT, -1, TRAIT_FINESSE, reason)) {
                player.StatBase[ST_INTELLECT] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_KAMIKAZE:
            if (canChangeSpecial(player, ST_AGILITY, -1, TRAIT_KAMIKAZE, reason)) {
                player.StatBase[ST_AGILITY] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_FAST_SHOT:
            if (canChangeSpecial(player, ST_AGILITY, -1, TRAIT_FAST_SHOT, reason)) {
                player.StatBase[ST_AGILITY] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_DOUBLE_TAP:
            if (canChangeSpecial(player, ST_AGILITY, -1, TRAIT_DOUBLE_TAP, reason)) {
                player.StatBase[ST_AGILITY] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_HEAVY_HANDED:
            if (canChangeSpecial(player, ST_STRENGTH, -1, TRAIT_HEAVY_HANDED, reason)) {
                player.StatBase[ST_STRENGTH] += -1;
                player.StatBase[ST_MELEE_DAMAGE] += -5;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_JINXED:
            if (canChangeSpecial(player, ST_LUCK, +1, TRAIT_JINXED, reason)) {
                player.StatBase[ST_LUCK] += +1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_GOOD_NATURED:
            if (canChangeSpecial(player, ST_CHARISMA, -1, TRAIT_GOOD_NATURED, reason)) {
                player.StatBase[ST_CHARISMA] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_BRUTISH_HULK:
            if (canChangeSpecial(player, ST_CHARISMA, +1, TRAIT_BRUTISH_HULK, reason)) {
                player.StatBase[ST_CHARISMA] += +1;
                player.StatBase[ST_MAX_LIFE] -= 12;
                player.StatBase[ST_MELEE_DAMAGE] += -3;
                player.TraitBase[traitIndex] = 0;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_CAUTIOUS_NATURE:
            if (canChangeSpecial(player, ST_PERCEPTION, -1, TRAIT_CAUTIOUS_NATURE, reason)) {
                player.StatBase[ST_PERCEPTION] += -1;
                player.TraitBase[traitIndex] = 0;
            }
            break;
        case TRAIT_GIFTED:
            canChangeGifted = true;
            for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                if (!canChangeSpecial(player, i, -1, TRAIT_GIFTED, reason)) {
                    canChangeGifted = false;
                }
            }
            if (canChangeGifted) {
                for (uint i = ST_STRENGTH; i <= ST_LUCK; i++) {
                    player.StatBase[i] += -1;
                }
                player.TraitBase[traitIndex] = 0;
                if (player.Stat[ST_CURRENT_HP] > player.Stat[ST_MAX_LIFE]) {
                    player.StatBase[ST_CURRENT_HP] = player.Stat[ST_MAX_LIFE];
                }
            }
            break;
        case TRAIT_LONER:
            if (canRemoveTrait(player, TRAIT_LONER, reason)) {
                player.TraitBase[traitIndex] = 0;
            }
            break;
        default:
    }
}

bool hasExclusiveTrait(Critter& player) {
    if (player.Trait[TRAIT_FAST_SHOT] > 0 || player.Trait[TRAIT_FINESSE] > 0 || player.Trait[TRAIT_DOUBLE_TAP] > 0 || player.Trait[TRAIT_CAUTIOUS_NATURE] > 0 || player.Trait[TRAIT_KAMIKAZE] > 0) {
        return true;
    } else {
        return false;
    }
}

int usedTraitPoints(Critter& player) {
    int traits = 0;
    for (uint i = TRAIT_BEGIN; i <= TRAIT_END; i++) {
        if (player.Trait[i] > 0) {
            if (i == TRAIT_GIFTED) {
                traits += 2;
            } else {
                traits++;
            }
        }
    }
    return traits;
}


