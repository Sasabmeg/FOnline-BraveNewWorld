//  shared between client and server scripts

// Returns the number of item bonuses
uint BonusNumber(Item@ it)
{
	uint number=0;
	if(it.Val4!=0) return 5;
	else if(it.Val3!=0) return 4;
	else if(it.Val2!=0) return 3;
	else if(it.Val1!=0) return 2;
	else if(it.Val0!=0) return 1;
	else return 0;
}

string itemBonusColor(uint bonusType, int value) {
    string result = "";
    int minRoll = 0;
    int maxRoll = 0;
    if (getMinMaxRoll(bonusType, minRoll, maxRoll) > 0) {
        int dif = maxRoll - minRoll + 1;
        if (value < minRoll + (dif * 25) / 100) {
            result = "|" + COLOR_GRAY + " ";
        } else if (value < minRoll + (dif * 45) / 100) {
            result = "|" + COLOR_LGRAY + " ";
        } else if (value < minRoll + (dif * 65) / 100) {
            result = "|" + COLOR_WHITE + " ";
        } else if (value < minRoll + (dif * 85) / 100) {
            result = "|" + COLOR_GREEN_RED + " ";
        } else {
            result = "|" + COLOR_SAND + " ";
        }
    }
    return result;
}

int getMinMaxRoll(uint bonusType, int& minRoll, int& maxRoll) {
    minRoll = 1;
    maxRoll = 0;
    //  armors
	switch(bonusType) {
		// Armors and helmets
		case BONUS_ARMOR_CRIT_CHANCE:   {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_CRIT_POWER:    {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_NORMAL_DT:     {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_LASER_DT:      {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_FIRE_DT:       {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_PLASMA_DT:     {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_NORMAL_DR:     {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_LASER_DR:      {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_FIRE_DR:       {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_PLASMA_DR:     {minRoll=2; maxRoll=6; break;}
		case BONUS_ARMOR_PERCEPTION:    {minRoll=1; maxRoll=1; break;}
		case BONUS_ARMOR_INTELLIGENCE:  {minRoll=1; maxRoll=1; break;}

		// Both body armor and helmet bonuses
		case BONUS_ARMOR_CHARISMA:      {minRoll=1; maxRoll=1; break;}
		case BONUS_ARMOR_LUCK:          {minRoll=1; maxRoll=1; break;}

		// Only armors
		case BONUS_ARMOR_EXPLODE_DT:    {minRoll=3; maxRoll=9; break;}
		case BONUS_ARMOR_EXPLODE_DR:    {minRoll=3; maxRoll=9; break;}
		case BONUS_ARMOR_MAX_AP:        {minRoll=1; maxRoll=1; break;}
		case BONUS_ARMOR_RAD_RES:       {minRoll=10;maxRoll=30;break;}
		case BONUS_ARMOR_POISON_RES:    {minRoll=10;maxRoll=30;break;}
		case BONUS_ARMOR_STRENGTH:      {minRoll=1; maxRoll=1; break;}
		case BONUS_ARMOR_ENDURANCE:     {minRoll=1; maxRoll=1; break;}
		case BONUS_ARMOR_AGILITY:       {minRoll=1; maxRoll=1; break;}
		case BONUS_ARMOR_CARRY_WEIGHT:  {minRoll=20;maxRoll=60;break;}
		case BONUS_ARMOR_HEALING_RATE:  {minRoll=2; maxRoll=6; break;}
		default: break;
	}
	//  weapons
    switch(bonusType)
	{
		case BONUS_WEAPON_CRITICAL_ROLL:    {minRoll=2; maxRoll=6; break;}
		case BONUS_WEAPON_CRITICAL_CHANCE:  {minRoll=2; maxRoll=6; break;}
		case BONUS_WEAPON_MIN_DMG:          {minRoll=10;maxRoll=25;break;}
		case BONUS_WEAPON_MAX_DMG:          {minRoll=10;maxRoll=25;break;}
		case BONUS_WEAPON_ACCURACY:         {minRoll=10;maxRoll=25;break;}
		case BONUS_WEAPON_MAX_RANGE:        {minRoll=1; maxRoll=3; break;}
		case BONUS_WEAPON_MAX_AP:           {minRoll=1; maxRoll=1; break;}
		default: break;
	}

	if (maxRoll > minRoll) {
        return Random(maxRoll, minRoll);
	} else {
	    return minRoll;
	}
}

bool isBonusForBodyArmor(uint bonusType) {
	switch (bonusType) {
		// Armors and helmets
		case BONUS_ARMOR_CRIT_CHANCE:
		case BONUS_ARMOR_CRIT_POWER:
		case BONUS_ARMOR_NORMAL_DT:
		case BONUS_ARMOR_LASER_DT:
		case BONUS_ARMOR_FIRE_DT:
		case BONUS_ARMOR_PLASMA_DT:
		case BONUS_ARMOR_NORMAL_DR:
		case BONUS_ARMOR_LASER_DR:
		case BONUS_ARMOR_FIRE_DR:
		case BONUS_ARMOR_PLASMA_DR:
		// Both body armor and helmet
		case BONUS_ARMOR_CHARISMA:
		case BONUS_ARMOR_LUCK:
		// Only armors
		case BONUS_ARMOR_EXPLODE_DT:
		case BONUS_ARMOR_EXPLODE_DR:
		case BONUS_ARMOR_MAX_AP:
		case BONUS_ARMOR_RAD_RES:
		case BONUS_ARMOR_POISON_RES:
		case BONUS_ARMOR_STRENGTH:
		case BONUS_ARMOR_ENDURANCE:
		case BONUS_ARMOR_AGILITY:
		case BONUS_ARMOR_CARRY_WEIGHT:
		case BONUS_ARMOR_HEALING_RATE:
            return true;
		default:
		    break;
	}
    return false;
}

