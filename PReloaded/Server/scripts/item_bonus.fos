uint getWeaponsUpgradeType(uint upgradePid, uint weaponPid) {

    int index = -1;
    for (uint i = 0; i < WeaponUpgrades.length(); i++) {
        if (WeaponUpgrades[i][0] == weaponPid) {
            index = int(i);
        }
    }
    if (index >= 0) {
        int foundIndex = WeaponUpgrades[index].find(upgradePid);
        switch (foundIndex) {
            case 1: return BONUS_WEAPON_MAX_RANGE;
            case 2: return BONUS_WEAPON_ACCURACY;
            case 3: return BONUS_WEAPON_MAX_AP;
            case 4: return BONUS_WEAPON_CRITICAL_CHANCE;
            case 5: return BONUS_WEAPON_CRITICAL_ROLL;
            case 6: return BONUS_WEAPON_MIN_DMG;
            case 7: return BONUS_WEAPON_MAX_DMG;
        }
    }
    return 0;
}

uint getUpgradeType(uint upgradeWeaponPartPid) {
    for (uint i = 0; i < UpgradeTypes.length(); i++) {
        if (UpgradeTypes[i][0] == upgradeWeaponPartPid) {
            return UpgradeTypes[i][1];
        }
    }
    return 0;
}

uint getDecraftComponentPid(uint weaponPid, uint bonusType) {
    int index = -1;
    for (uint i = 0; i < WeaponUpgrades.length(); i++) {
        if (WeaponUpgrades[i][0] == weaponPid) {
            index = int(i);
        }
    }
    if (index >= 0) {
        switch (bonusType) {
            case BONUS_WEAPON_MAX_RANGE:        return WeaponUpgrades[index][1];
            case BONUS_WEAPON_ACCURACY:         return WeaponUpgrades[index][2];
            case BONUS_WEAPON_MAX_AP:           return WeaponUpgrades[index][3];
            case BONUS_WEAPON_CRITICAL_CHANCE:  return WeaponUpgrades[index][4];
            case BONUS_WEAPON_CRITICAL_ROLL:    return WeaponUpgrades[index][5];
            case BONUS_WEAPON_MIN_DMG:          return WeaponUpgrades[index][6];
            case BONUS_WEAPON_MAX_DMG:          return WeaponUpgrades[index][7];
        }
    }
    return 0;
}

//  this part is not shared with client, server only

#ifndef __CLIENT

import void   SetLexem(Item& item, string& lex, string& value) from "lexems";

int CheckBonus( Item@ item, int bonusType )
{
	if( valid(item) )
	{
		if( item.Val0 == bonusType ) return item.Val5;
		if( item.Val1 == bonusType ) return item.Val6;
		if( item.Val2 == bonusType ) return item.Val7;
		if( item.Val3 == bonusType ) return item.Val8;
		if( item.Val4 == bonusType ) return item.Val9;
	}

	return( 0 );
}

//used to add bonuses to gear used by raiders in farm locations
void AddSpecialBonusRaidersFarm(Item@ it)
{
	if(it.GetType() == ITEM_TYPE_WEAPON && !it.IsStackable())
	{
	int roll = Random(0,99);
	if(roll>=0) AddWeaponBonus(it, 1, 100, true); // 100%
	if(roll>34)	AddWeaponBonus(it, 2, 100, true); // 65%
	if(roll>59)	AddWeaponBonus(it, 3, 100, true); // 40%
	if(roll>74)	AddWeaponBonus(it, 4, 100, true); // 25%
	if(roll>84) AddWeaponBonus(it, 5, 100, true); // 15%
	}

	else if(it.GetType() == ITEM_TYPE_ARMOR)
	{
	int roll = Random(0,99);
	if(roll>=0) AddArmorBonus(it, 1);
	if(roll>34)	AddArmorBonus(it, 2);
	if(roll>59)	AddArmorBonus(it, 3);
	if(roll>74)	AddArmorBonus(it, 4);
	if(roll>84) AddArmorBonus(it, 5);
	}
	return;
}

//used to add bonuses to gear used by boss in encounters
void AddSpecialBonusEncounterBoss(Item@ it)
{
	if(it.GetType() == ITEM_TYPE_WEAPON && !it.IsStackable())
	{
        int roll = Random(0,99);
        if(roll>=0) AddWeaponBonus(it, 1, 100, true); // 100%
        if(roll>29)	AddWeaponBonus(it, 2, 100, true); // 70%
        if(roll>59)	AddWeaponBonus(it, 3, 100, true); // 40%
        if(roll>89)	AddWeaponBonus(it, 4, 100, true); // 10%
        if(roll>94) AddWeaponBonus(it, 5, 100, true); // 5%
	}

	else if(it.GetType() == ITEM_TYPE_ARMOR)
	{
        int roll = Random(0,99);
        if(roll>=0) AddArmorBonus(it, 1);
        if(roll>29)	AddArmorBonus(it, 2);
        if(roll>59)	AddArmorBonus(it, 3);
        if(roll>89)	AddArmorBonus(it, 4);
        if(roll>94) AddArmorBonus(it, 5);
	}
	return;
}

//  03-03-2014 Cubik: funkcja dla skrzynek spawnujacych bonusowe bronie/armory o nizјszej jakosci (rzadziej unique, czesciej advanced) - GORSZA WERSJA AddSpecialBonus
//  03-03-2014 Cubik: function for boxes spawning bonus weapons/armor of lower quality (less often unique, more often advanced) - WORSE VERSION of AddSpecialBonus
void AddSpecialBonusLow(Item@ it)
{
	if(it.GetType() == ITEM_TYPE_WEAPON && !it.IsStackable())
	{
		int roll = Random(0,99);
		if(roll>=0) AddWeaponBonus(it, 1); // 100%
		if(roll>34)	AddWeaponBonus(it, 2); // 65%
		if(roll>59)	AddWeaponBonus(it, 3); // 40%
		if(roll>74)	AddWeaponBonus(it, 4); // 25%
		if(roll>84) AddWeaponBonus(it, 5); // 15%
	}

	else if(it.GetType() == ITEM_TYPE_ARMOR)
	{
		int roll = Random(0,99);
		if(roll>=0) AddArmorBonus(it, 1);
		if(roll>34)	AddArmorBonus(it, 2);
		if(roll>59)	AddArmorBonus(it, 3);
		if(roll>74)	AddArmorBonus(it, 4);
		if(roll>84) AddArmorBonus(it, 5);
	}
	return;
}

void AddSpecialBonus(Item@ it)
{
	if(it.GetType() == ITEM_TYPE_WEAPON && !it.IsStackable())
	{
		AddWeaponBonus(it, 1);
		AddWeaponBonus(it, 2);
		AddWeaponBonus(it, 3);
		AddWeaponBonus(it, 4);
		if(Random(0,1)==0) 	AddWeaponBonus(it, 5);
	}

	else if(it.GetType() == ITEM_TYPE_ARMOR)
	{
		AddArmorBonus(it, 1);
		AddArmorBonus(it, 2);
		AddArmorBonus(it, 3);
		AddArmorBonus(it, 4);
		if(Random(0,1)==0) AddArmorBonus(it, 5);
	}
	return;
}
/***
 *  qualityRollBonus - if crafted in danger zone, add some bonus
 *  minQuality - if crafted in danger zone or event, do not allow to be normal item
 *  maxQuality - if crafted in safe zone, like a tent, do not allow to be high rarity item
 *  effectValueRollPercent - if crafted in danger zone or event, allow to never be normal item
*/

void AddBonuses(Item@ it, string@ crafter, int qualityRollBonus, int minQuality, int maxQuality, int effectValueRollPercent) {
    int tresholdQuality = 50;
    int tresholdImproved = 75;
    int tresholdSuperior = 87;
    int tresholdAdvanced = 95;
    int tresholdUnique = 99;
    qualityRollBonus = CLAMP(qualityRollBonus, -99, 99);
    minQuality = CLAMP(minQuality, 0, 5);
    maxQuality = CLAMP(maxQuality, 0, 5);
    effectValueRollPercent = CLAMP(effectValueRollPercent, 0, 1000);

    int roll = Random(1, 100);
    roll = CLAMP(roll + qualityRollBonus, 1, 100);
    switch (minQuality) {
        case 1: roll = CLAMP(roll, tresholdQuality + 1, 100); break;
        case 2: roll = CLAMP(roll, tresholdImproved + 1, 100); break;
        case 3: roll = CLAMP(roll, tresholdSuperior + 1, 100); break;
        case 4: roll = CLAMP(roll, tresholdAdvanced + 1, 100); break;
        case 5: roll = CLAMP(roll, tresholdUnique + 1, 100); break;
    }
    switch (maxQuality) {
        case 1: roll = CLAMP(roll, 1, tresholdQuality + 1); break;
        case 2: roll = CLAMP(roll, 1, tresholdImproved + 1); break;
        case 3: roll = CLAMP(roll, 1, tresholdSuperior + 1); break;
        case 4: roll = CLAMP(roll, 1, tresholdAdvanced + 1); break;
        case 5: roll = CLAMP(roll, 1, tresholdUnique + 1); break;
    }

	if (it.GetType() == ITEM_TYPE_WEAPON && !it.IsStackable()) {
		if (roll > tresholdQuality) AddWeaponBonus(it, 1, effectValueRollPercent, true);
		if (roll > tresholdImproved) AddWeaponBonus(it, 2, effectValueRollPercent, true);
		if (roll > tresholdSuperior) AddWeaponBonus(it, 3, effectValueRollPercent, true);
		if (roll > tresholdAdvanced) AddWeaponBonus(it, 4, effectValueRollPercent, true);
		if (roll > tresholdUnique) AddWeaponBonus(it, 5, effectValueRollPercent, true);
		if (valid(crafter)) {
            SetLexem(it, "$crafter", crafter);
		}
	} else if (it.GetType() == ITEM_TYPE_ARMOR) {
		if (roll > tresholdQuality) AddArmorBonus(it, 1, effectValueRollPercent);
		if (roll > tresholdImproved) AddArmorBonus(it, 2, effectValueRollPercent);
		if (roll > tresholdSuperior) AddArmorBonus(it, 3, effectValueRollPercent);
		if (roll > tresholdAdvanced) AddArmorBonus(it, 4, effectValueRollPercent);
		if (roll > tresholdUnique) AddArmorBonus(it, 5, effectValueRollPercent);
		if (valid(crafter)) {
            SetLexem(it, "$crafter", crafter);
		}
	}
	return;
}

bool AddAnotherBonus(Item@ it)
{
	if(!valid(it))
		return false;

	uint bonusCnt = BonusNumber(it);
	if(bonusCnt > 4)
		return false;

	++bonusCnt;

	if(it.GetType() == ITEM_TYPE_WEAPON && !it.IsStackable())
		AddWeaponBonus(it, bonusCnt, 100, true);
	else if(it.GetType() == ITEM_TYPE_ARMOR)
		AddArmorBonus(it, bonusCnt, 100);
	else
		return false;

	return true;
}

void AddArmorBonus(Item@ it, int number, int effectValueRollPercent = 100)
{
	int minRoll = 1;
	int maxRoll = 1;
	uint bonusType = 0;
	bool isHelmet = (it.GetProtoId()>=725 && it.GetProtoId()<=741);

	// Choose which bonus and specify bonus value range
	do {
        if (isHelmet) {
            bonusType = getRandomHelmetBonusType();
        } else {
            bonusType = getRandomBodyArmorBonusType();
        }
	} while (HasBonusAlready(it, bonusType));

    int roll = getMinMaxRollArmor(bonusType, minRoll, maxRoll, effectValueRollPercent);

	// Choose which value
	switch(number) {
		case 1: {it.Val0=bonusType; it.Val5=roll;break;}
		case 2: {it.Val1=bonusType; it.Val6=roll;break;}
		case 3: {it.Val2=bonusType; it.Val7=roll;break;}
		case 4: {it.Val3=bonusType; it.Val8=roll;break;}
		case 5: {it.Val4=bonusType; it.Val9=roll;break;}
		default: break;
	}
	//Log("Armor bonus: " + getArmorBonusName(bonusType) + ", Value: " + roll + ", Slot number: " + number);
	it.Update();
    return;
}


void AddWeaponBonus(Item@ it, int number, int effectValueRollPercent = 100, bool isCrafting = false) {
	int minRoll=1;
	int maxRoll=1;
	uint bonusType=0;

	int skillNum = it.Proto.Weapon_Skill_0;
    bool isRangeWeapon = (skillNum == SK_SMALL_GUNS || skillNum == SK_BIG_GUNS || skillNum == SK_ENERGY_WEAPONS);
	// Choose which bonus and specify bonus value range
	do {
		if (isRangeWeapon) {
			bonusType=Random(100, BONUS_WEAPON_MAX_RANGE);
		} else {
			bonusType=Random(100, BONUS_WEAPON_MAX_AP);
		}
	} while (HasBonusAlready(it,bonusType) || IsBonusExcluded(isCrafting, bonusType));

    uint roll = getMinMaxRollWeapon(bonusType, minRoll, maxRoll, effectValueRollPercent);

	// Choose which value
	switch(number) {
		case 1: {it.Val0=bonusType; it.Val5=roll;break;}
		case 2: {it.Val1=bonusType; it.Val6=roll;break;}
		case 3: {it.Val2=bonusType; it.Val7=roll;break;}
		case 4: {it.Val3=bonusType; it.Val8=roll;break;}
		case 5: {it.Val4=bonusType; it.Val9=roll;break;}
		default: break;
	}
	//Log("Weapon bonus: " + getWeaponBonusName(bonusType) + ", Value: " + roll + ", Slot number: " + number);
	it.Update();
    return;
}

uint UpgradeWeaponWithBonus(Critter& player, Item@ weapon, Item@ upgrade, int& oldValue, int& newValue) {

    uint bonusType = getWeaponsUpgradeType(upgrade.GetProtoId(), weapon.GetProtoId());

    //  already has that bonus
	if (HasBonusAlready(weapon, bonusType)) {
        return 1;
	}

	int number = -1;
    if (weapon.Val0 == 0) {
        number = 0;
    } else if (weapon.Val1 == 0) {
        number = 1;
    } else if (weapon.Val2 == 0) {
        number = 2;
    } else if (weapon.Val3 == 0) {
        number = 3;
    } else if (weapon.Val4 == 0) {
        number = 4;
    }

    //  no free slots for bonus
    if (number < 0) {
        return 2;
    }
	int minRoll = 1;
	int maxRoll = 1;
    uint roll = getMinMaxRollWeapon(bonusType, minRoll, maxRoll, 100);
    if (upgrade.Val0 > 0) {
        roll = CLAMP(upgrade.Val0, minRoll, maxRoll);
        int percentMin = CLAMP(100 - upgrade.Val1, 25, 75);
        int percentMax = CLAMP(100 - upgrade.Val2 + 25, 50, 125);
        int successPercent = Random(percentMin, percentMax);
        oldValue = roll;
        roll = CLAMP(roll * successPercent / 100, minRoll, maxRoll);
        newValue = roll;
        if (player.GetAccess() > ACCESS_CLIENT) {
            Log("successPercent = " + successPercent + ", (" + (percentMin) + " - " + (percentMax) + "), oldValue = " + oldValue + "    FINAL VALUE = " + roll);
            player.Say(SAY_NETMSG, "successPercent = " + successPercent + ", (" + (percentMin) + " - " + (percentMax) + "), oldValue = " + oldValue + "    FINAL VALUE = " + roll);
        }
    }

	// Choose which value
	switch (number) {
		case 0: { weapon.Val0 = bonusType; weapon.Val5 = roll; break; }
		case 1: { weapon.Val1 = bonusType; weapon.Val6 = roll; break; }
		case 2: { weapon.Val2 = bonusType; weapon.Val7 = roll; break; }
		case 3: { weapon.Val3 = bonusType; weapon.Val8 = roll; break; }
		case 4: { weapon.Val4 = bonusType; weapon.Val9 = roll; break; }
		default: break;
	}

	//Log("Weapon ID: " + weapon.Id + ", PID:" + weapon.GetProtoId() + ", Weapon bonus: " + getWeaponBonusName(bonusType) + ", Value: " + roll + ", Slot number: " + number);
	//Log("\tWeapon ID: " + weapon.Id + ", PID:" + weapon.GetProtoId() + ", Weapon bonus at slot[" + number + "]: " + getWeaponBonusName(weapon.Val0) + ", Value: " + weapon.Val5);
	DeleteItem(upgrade);
	weapon.Update();
    return 0;
}

// Checks if given bonus is allowed - used to exclude some bonuses from crafting
bool IsBonusExcluded(bool isCrafting, int bonusType)
{
	if(!isCrafting)
		return false;

	if(bonusType == BONUS_WEAPON_MAX_AP)
		return true;

	return false;
}

// Checks if there is no such bonus already on an item
bool HasBonusAlready(Item@ it, int bonusType)
{
	if(it.Val0==bonusType) return true;
	if(it.Val1==bonusType) return true;
	if(it.Val2==bonusType) return true;
	if(it.Val3==bonusType) return true;
	if(it.Val4==bonusType) return true;
	return false;
}

// Checks value of specified bonus type

int checkBonus(Item@ it, int bonusType)
{
	if(it.Val0==bonusType) return it.Val5;
	if(it.Val1==bonusType) return it.Val6;
	if(it.Val2==bonusType) return it.Val7;
	if(it.Val3==bonusType) return it.Val8;
	if(it.Val4==bonusType) return it.Val9;
	return 0;
}


//  BNW: Weapon Upgrade components

void _UpgradeInit(Item& item, bool firstTime) {
    /*
    if (firstTime) {
        Log("Upgrade components: FIRSTIME");
    } else {
        Log("Upgrade components.");
    }*/
    item.SetEvent(ITEM_EVENT_USE, "_UseUpgradeComponent");
    //item.SetEvent(ITEM_EVENT_USE_ON_ME, "_UseItemOnUpgradeComponent");
}

bool _UseUpgradeComponent(Item& component, Critter& player, Critter@ onCritter, Item@ onItem, Scenery@ onScenery) {
    //Log("Use upgrade component!");
    if (valid(onCritter) || valid(onItem) || valid(onScenery)) {
        if (player.GetAccess() > ACCESS_CLIENT) {
            player.Say(SAY_NETMSG, "Can only be used without target, affecting the weapon in main hand.");
        }
        return false;
    }
    if (player.GetAccess() > ACCESS_CLIENT) {
        player.Say(SAY_NETMSG, "Component used: " + component.GetProtoId());
    }

    Item@ targetWeapon = player.GetItem(0, SLOT_HAND1);
    if (!valid(targetWeapon)) {
        player.Say(SAY_NETMSG, "|" + COLOR_DTEXT_CAPTION + " ::Pip-Boy:: |" + COLOR_DYELLOW + " To enhance a weapon with an upgrade component, equip the weapon in the active hand slot.");
        return true;
    }

    if (targetWeapon.GetType() != ITEM_TYPE_WEAPON) {
        player.Say(SAY_NETMSG, "|" + COLOR_DTEXT_CAPTION + " ::Pip-Boy:: |" + COLOR_DYELLOW + " Only weapons can be enhanced with such upgrade components! You must have the weapon in the active hand slot.");
        return true;
    }

    uint bonusType = getWeaponsUpgradeType(component.GetProtoId(), targetWeapon.GetProtoId());
    if (bonusType > 0) {
        if (HasBonusAlready(targetWeapon, bonusType)) {
            player.Say(SAY_NETMSG, "|" + COLOR_DTEXT_CAPTION + " ::Pip-Boy:: |" + COLOR_DYELLOW + " Your weapon already has this type of bonus: " + getWeaponBonusName(bonusType));
        } else {
            int oldValue = 0;
            int newValue = 0;
            int errorCode = UpgradeWeaponWithBonus(player, targetWeapon, component, oldValue, newValue);
            if (errorCode == 0) {
                if (newValue == oldValue) {
                    player.Say(SAY_NETMSG, "|" + COLOR_DTEXT_CAPTION + " ::Pip-Boy:: |" + COLOR_DTEXT_BONUS + " The upgrade went without any issues and you upgraded your weapon with " + getWeaponBonusName(bonusType) + " bonus.");
                } else if (newValue > oldValue) {
                    player.Say(SAY_NETMSG, "|" + COLOR_DTEXT_CAPTION + " ::Pip-Boy:: |" + COLOR_DTEXT_BONUS + " The upgrade went smoother than expected and you upgraded your weapon with " + getWeaponBonusName(bonusType) + " bonus.");
                } else {
                    player.Say(SAY_NETMSG, "|" + COLOR_DTEXT_CAPTION + " ::Pip-Boy:: |" + COLOR_DTEXT_BONUS + " The upgrade went worse than usual but you were able to upgrade your weapon with " + getWeaponBonusName(bonusType) + " bonus.");
                }
            } else {
                if (errorCode == 2) {
                    player.Say(SAY_NETMSG, "|" + COLOR_DTEXT_CAPTION + " ::Pip-Boy:: |" + COLOR_DYELLOW + " Your weapon already has the maximum number of bonuses.");
                } else {
                    player.Say(SAY_NETMSG, "|" + COLOR_DTEXT_CAPTION + " ::Pip-Boy:: |" + COLOR_DYELLOW + " You failed up upgrade your weapon for an unknown reason with bonus: " + getWeaponBonusName(bonusType));
                }
            }
        }
    } else {
        player.Say(SAY_NETMSG, "|" + COLOR_DTEXT_CAPTION + " ::Pip-Boy:: |" + COLOR_DYELLOW + " This upgrade component does not match your weapon. Try a different weapon or different upgrade component. ");
    }

    player.PlaySound("CARREPAR.ACM", true);
    return true;
}

//  not used
bool _UseItemOnUpgradeComponent(Item& component, Critter& player, Item@ item) {
    if (!valid(item)) {
        return false;
    }
    if (player.GetAccess() > ACCESS_CLIENT) {
        player.Say(SAY_NETMSG, "Item used on component: " + item.GetProtoId());
    }
    player.PlaySound("GEIGER.ACM", true);
    return true;
}

void CloneItemBonus(Item& from, Item& to) {
    to.Val0 = from.Val0;
    to.Val1 = from.Val1;
    to.Val2 = from.Val2;
    to.Val3 = from.Val3;
    to.Val4 = from.Val4;
    to.Val5 = from.Val5;
    to.Val6 = from.Val6;
    to.Val7 = from.Val7;
    to.Val8 = from.Val8;
    to.Val9 = from.Val9;
    // TODO SetPictureWear( to );
    to.Update();
}

#endif //__NO-CLIENT
