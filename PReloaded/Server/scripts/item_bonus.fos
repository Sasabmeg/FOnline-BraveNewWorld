		case 6:  return BONUS_ARMOR_NORMAL_DR:
		case 7:  return BONUS_ARMOR_LASER_DR:
		case 8:  return BONUS_ARMOR_FIRE_DR:
		case 9:  return BONUS_ARMOR_PLASMA_DR:
		case 10: return BONUS_ARMOR_CHARISMA:
		case 11: return BONUS_ARMOR_LUCK:
		case 12: return BONUS_ARMOR_EXPLODE_DT:
		case 13: return BONUS_ARMOR_EXPLODE_DR:
		case 14: return BONUS_ARMOR_MAX_AP:
