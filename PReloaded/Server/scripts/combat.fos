#define COLOR_DTEXT_MALUS       (COLOR_WRED)
#define COLOR_DTEXT_ROLL        (COLOR_YELLOW)
#define COLOR_DTEXT_CAPTION     (COLOR_TEXT_WHITE)
#define COLOR_DTEXT_REGULAR     (COLOR_TEXT_DDGREEN)


