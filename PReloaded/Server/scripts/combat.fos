    }
    return 0;
}

uint getWeaponAnimationDelayForProjectile(uint16 weaponPid) {
    switch(weaponPid) {
        case PID_LASER_PISTOL:
        case PID_MAGNETO_LASER_PISTOL:
        case PID_PLASMA_PISTOL:
            Log("Laser Pistol");
            return 400;
        case PID_LASER_RIFLE:
        case PID_LASER_RIFLE_EXT_CAP:
        case PID_PLASMA_RIFLE:
            Log("Laser Rifle");
            return 375;
    }
    return 0;
}
