        }
    }
}

int GetSmartItemMoveCount(ItemCl &item) {
    int ret = 5;
    CritterCl@ chosen = GetChosen();
    if (!valid(chosen)) {
        return 0;
    }
    if (!valid(item)) {
        return 0;
    }

    switch (item.GetProtoId()) {
        //  healing drugs
        case PID_HYPO:
        case PID_HEALING_POWDER:
        case PID_STIMPAK:
        case PID_SUPER_STIMPAK:
            ret = smartLoot.HealingDrugs;
            break;
        //  long duration drugs
        case PID_RAD_X:
        case PID_MENTATS:
        case PID_BUFFOUT:
            ret = smartLoot.Drugs;
            break;
        case PID_NUKA_COLA:
            ret = smartLoot.NukaCola;
            break;
        case PID_CIGARETTES:
            ret = smartLoot.Cigarettes;
            break;
        case PID_PSYCHO:
            ret = smartLoot.Psycho;
            break;
        case PID_JET:
            ret = smartLoot.Jet;
            break;
        case PID_JET_ANTIDOTE:
            ret = smartLoot.JetAntidote;
            break;
        case PID_ANTIDOTE:
            ret = smartLoot.Antidote;
            break;
        case PID_RADAWAY:
            ret = smartLoot.RadAway;
            break;
        //  fish
        case PID_FISH_CATFISH:
        case PID_FISH_TUNA:
        case PID_FISH_SALMON:
            ret = smartLoot.Fish;
            break;
        //  alcohol
        case PID_BOOZE:
        case PID_BEER:
        case PID_ROENTGEN_RUM:
        case PID_GAMMA_GULP_BEER:
        case PID_ROT_GUT:
            ret = smartLoot.Alcohol;
            break;
        //  thrown weapons and ammo
        case PID_PLASMA_GRENADE:
        case PID_FRAG_GRENADE:
        case PID_FIRE_GRENADE:
        case PID_MOLOTOV_COCKTAIL:
        case PID_PULSE_GRENADE:
            ret = smartLoot.Grenades;
            break;
        //  flares
        case PID_FLARE:
        case PID_FLARE_GREEN:
        case PID_FLARE_WHITE:
        case PID_FLARE_YELLOW:
            ret = smartLoot.Flares;
            break;
        case PID_EXPLOSIVE_ROCKET:
        case PID_ROCKET_AP:
        case PID_40MM_GRENADE:
            ret = smartLoot.Rockets;
            break;
        //  other thrown
        case PID_ROCK:
        case PID_THROWING_KNIFE:
        case PID_POISONED_THROWING_KNIFE:
        case PID_PASHTSHUUR_SPIKE:
        case PID_PLANT_SPIKE:
        case PID_SPEAR:
        case PID_SHARP_SPEAR:
        case PID_SHARPENED_POLE:
            ret = smartLoot.OtherThrown;
            break;
        //  traps
        case PID_BEAR_TRAP:
            ret = smartLoot.Traps;
            break;
        //  ammo
        //  SEC -> Laser SMG -> 60
        case PID_SMALL_ENERGY_CELL:
            ret = smartLoot.MagMultiplier * 60;
            break;
        //  MFC -> Gatling Laser -> 30
        case PID_MICRO_FUSION_CELL:
            ret = smartLoot.MagMultiplier * 30;
            break;
        //  Shotgun Shells -> Pancor Jackhammer -> 20
        case PID_SHOTGUN_SHELLS:
        case PID_SHOTGUN_SHELLS_EMP:
        case PID_SHOTGUN_SHELLS_FLECHETTE:
        case PID_SHOTGUN_SHELLS_SLUG:
        case PID_SHOTGUN_DRAGON_BREATH_SHELLS:
            ret = smartLoot.MagMultiplier * 20;
            break;
        //  Flamethrower Fuel -> Incinerator -> 5
        case PID_FLAMETHROWER_FUEL:
        case PID_FLAMETHROWER_FUEL_MK_II:
            ret = smartLoot.MagMultiplier * 5;
            break;
        //  HN Needler Cartridge -> Needler Pistol -> 10
        case PID_HN_NEEDLER_CARTRIDGE:
        case PID_HN_AP_NEEDLER_CARTRIDGE:
            ret = smartLoot.MagMultiplier * 10;
            break;
        //  BBS -> Red Ryder BB Gun -> 100
        case PID_BBS:
            ret = smartLoot.MagMultiplier * 100;
            break;
        //  2mm EC -> M72 Gauss Rifle -> 20
        case PID_2MM_EC_AMMO:
            ret = smartLoot.MagMultiplier * 20;
            break;
        //  223 FMJ -> LSW -> 30
        case PID_223_FMJ:
            ret = smartLoot.MagMultiplier * 30;
            break;
        //  .44 Magnum -> Desert Eagle (Exp. Mag.) -> 10
        case PID_44_MAGNUM_FMJ:
        case PID_44_MAGNUM_JHP:
            ret = smartLoot.MagMultiplier * 10;
            break;
        //  .45 Caliber -> Tommy Gun -> 75
        case PID_45_CALIBER_AMMO:
            ret = smartLoot.MagMultiplier * 75;
            break;
        //  4.7mm Caseless -> Vindicator -> 100
        case PID_4_7MM_CASELESS:
            ret = smartLoot.MagMultiplier * 100;
            break;
        //  5mm -> Minigun -> 120
        case PID_5MM_AP:
        case PID_5MM_JHP:
            ret = smartLoot.MagMultiplier * 120;
            break;
        //  7.62mm -> M60 -> 100
        case PID_7_62MM_AMMO:
            ret = smartLoot.MagMultiplier * 100;
            break;
        //  9mm -> Mauser -> 7
        case PID_9MM_AMMO:
        case PID_9MM_BALL:
            ret = smartLoot.MagMultiplier * 7;
            break;
        //  10mm -> HK P90c -> 60
        case PID_10MM_AP:
        case PID_10MM_JHP:
            ret = smartLoot.MagMultiplier * 60;
            break;
        //  14mm AP -> 14mm Pistol -> 10
        case PID_14MM_AP:
            ret = smartLoot.MagMultiplier * 10;
            break;
    }
    return ret;
}


#endif // __CLIENT_SMART_LOOT__
