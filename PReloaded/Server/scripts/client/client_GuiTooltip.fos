        tooltipsKey.insertLast(PE_MAN_OF_STEEL);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(PE_MAN_OF_STEEL)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(PE_MAN_OF_STEEL)) + pipText);
        tooltipsValueExt.insertLast(pipReference
                                     + notes
                                     + "\n\u2022 -10 penalty to enemy critical chance."
                                     + "\n\u2022 -10 penalty to enemy critical power roll."
                                     + requirements
                                     + "\n\t\u2022 Endurance >= 6");

        tooltipsKey.insertLast(PE_FIELD_MEDIC);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(PE_FIELD_MEDIC)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(PE_FIELD_MEDIC)) + pipText);
        tooltipsValueExt.insertLast(pipReference
                                     + notes
                                     + "\n\u2022 Allows you to use First Aid or Doctor and remain in stealth."
                                     + "\n\u2022 Increases HealFactor by 5. (5%) Initial heal value:"
                                     + "\n\t\u2022 CLAMP(missingHP * HealFactor /100, 0, 20 + skill/4 + 25(Medic) + 25(Field Medic) + 3 * ItemFactor)"
                                     + "\n\t\u2022 HealFactor: (30 self or 45 other) + 5(Medic) + 5(Field Medic) + 10(Item Factor)"
                                     + "\n\t\u2022 ItemFactor: 10 if First Aid Kit or similar item is used, otherwise 0."
                                     + "\n\u2022 Allows higher FA values: 20 + FA/4 + 25(Medic) + 25(Field Medic)"
                                     + "\n\u2022 More XP from using Doctor or First Aid skills."
                                     + "\n\t\u2022 2 times the normal amount of XP for First Aid."
                                     + "\n\t\u2022 5 times the normal amount of XP for Doctor."
                                     + "\n\u2022 Shorter cooldown on Doctor and First Aid skills:"
                                     + "\n\t\u2022 CD: 90 sec - Skill/4 - 20(medic) - 10(field medic)"
                                     + requirements
                                     + "\n\t\u2022  First Aid >= 150"
                                     + "\n\t\u2022  Doctor >= 150"
                                     + "\n\t\u2022  Medic Perk");

        //  Level 18 Perks
        tooltipsKey.insertLast(PE_BONUS_RATE_OF_ATTACK);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(PE_BONUS_RATE_OF_ATTACK)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(PE_BONUS_RATE_OF_ATTACK)) + pipText);
        tooltipsValueExt.insertLast(pipReference
                                     + notes
                                     + "\n\u2022 -1 AP cost for all attacks."
