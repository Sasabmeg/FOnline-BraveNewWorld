#ifndef __GUI_TOOLTIP__
#define __GUI_TOOLTIP__

#include "../sprite.fos"
#include "../_defines.fos"
#include "../_client_defines.fos"
#include "../_macros.fos"
#include "../_colors.fos"
#include "../client_gui_h.fos"
#include "../combat_h.fos"
#include "client_InterfaceControl.fos"
#include "client_InterfaceTextbox.fos"
#include "client_InterfaceWindow.fos"
#include "../lexems_h.fos"

import string showItemBonus(ItemCl& it, int type, int value) from "client_interface";

CGuiTooltip characterTooltip;
CGuiTooltip inventoryTooltip;
CTooltips tooltipKeyValue;

class CTooltips {
    array<uint>     tooltipsKey;
    array<string>   tooltipsValue;
    array<string>   tooltipsValueExt;
    CTooltips() {
        InitTooltips();
    }

    string getToolTip(uint key) {
        int index = 0;
        index = tooltipsKey.find(key);
        if (index >= 0) {
            return tooltipsValue[index];
        } else {
            return "N/A";
        }
    }

    string getToolTipExt(uint key) {
        int index = 0;
        index = tooltipsKey.find(key);
        if (index >= 0) {
            return tooltipsValueExt[index];
        } else {
            return "N/A";
        }
    }

    void InitTooltips() {
        string pipText = "\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   «Vault-Tec Pip-Info™»";
        string jjJournal = "\nJournal entry:";
        string jjText = "\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t  - Chief Gadgeteer 'Jinxed' Jack -";
        string pipReference = "\n|" + COLOR_GREEN + " Extended Pip-boy database search results:\n";
        string notes = "\nNotes:";
        string modifies = "\n\nModifies:";
        string noData = "- No additional information available.";
        //   special stats
        tooltipsKey.insertLast(ST_STRENGTH);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_STRENGTH)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_STRENGTH))
                                 + pipText + jjJournal
                                 + "\n\n\"There is a small mining town to north in the mountains, Broken Hills. I saw a huge super-mutant drinking at the local tap house who wanted to arm wrestle every newcomer, I bet he could lift a whole caravan cart with his right arm.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n- Initial Hit Points: (55 + 2*ST + EN)"
                                 + "\n- Melee Damage: (ST - 5) with a minimum of 1."
                                 + "\n- Carry Weight: [(25 + (ST*25 ))/2.2] + 20"
                                 + "\n- Throwing Distance: 3*ST to reach weapon max. distance (+6 with Heave Ho!)"
                                 + "\n- Throwing Damage: min. ST/2, max. ST (more with Heave Ho!)"
                                 + "\n- To hit chance: if lower than weapon ST requirement then -20 To Hit for each missing ST"
                                 + "\n- Stonewall Knockdown/Knockout resist: (clamp(ST, 1, CH+4) + clamp(EN, 1, CH+6) )*3 + 15*stonewallRank vs 1d100"
                                 + "\n- Iron Limbs Weapon Drop resist: (ST - 5) + 2*ironLimbsRank vs 1d10"
                                 + "\n- Heavy Handed Trait Knockdown chance: "
                                 + "\n- Electric Shock effect (cannot run) duration reduce: ");

        tooltipsKey.insertLast(ST_PERCEPTION);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_PERCEPTION)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_PERCEPTION))
                                 + pipText + jjJournal
                                 + "\n\n\"Just when I ran out of smokes, I found a tobacco plantation along the shore to the west. It even had a working press machine! So much about me being 'Jinxed' he-he, oh no.... a pack of floaters are swarming to the north, gotta leave quick, damn, where do these creatures even come from?\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n- Sight range: Base(20) + 3*PE + Sharpshooter(6) + Binoculars(6)"
                                 + "\n- Ranged chance to hit bonus: 2*PE, (if weapon perk LongRange 4*PE, if Scope 5*PE)"
                                 + "\n- Sequence: 2*PE");
        tooltipsKey.insertLast(ST_ENDURANCE);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_ENDURANCE)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_ENDURANCE))
                                 + pipText + jjJournal
                                 + "\n\n\"Today I saw a skin-n-bones human like creature being eaten by dogs until another one scared the dogs off with a shotgun. After a short time he woke up and walked away like nothing happened. The radiation must have increased the natural regeneration of these creatures to a level where they simply cannot die. Some of them were even glowing! It was to the north-east at the huge metropolitan ruins, better avoid for now.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n- Hit Points: (Initial: 55 + 2*ST + EN) + (Per level: (30 + EN)/8)"
                                 + "\n- Stonewall KD/KO resist: (clamp(ST, 1, CH+4) + clamp(EN, 1, CH+6) )*3 + 15*stonewallRank vs 1d100"
                                 + "\n- Enhanced Knockout Weapon perk resist factor.");

        tooltipsKey.insertLast(ST_CHARISMA);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_CHARISMA)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_CHARISMA))
                                 + pipText + jjJournal
                                 + "\n\n\"A group of travelers were gossiping about a special lady in New Reno today. It seems that she is able to turn even the most unfriendly punks to do her bidding. I was wondering if it was her Magnetic Personality or something else, after all New Reno is also famous of addictive substances like Jet.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n- Stonewall: ST clamped with CH+4, EN clamped with CH+6 (ex: 9 ST with 1 CH means 5 ST in calculations)"
                                 + "\n- Confident Shooter (old More Ranged Damage) Perk damage bonus (per bullet):"
                                 + "\n\t- 1 + CLAMP(attacker.CH - (((target.CH + 1) * 2) / 3), 0, 4)"
                                 + "\n\t- ex: Att. CH6, Tar. CH5 bonus: 3"
                                 + "\n\t- ex: Att. CH9, Tar. CH7 bonus: 5 (max)"
                                 + "\n\t- ex: Att. CH5, Tar. CH1 bonus: 5 (max)"
                                 + "\n\t- ex: Att. CH2, bonus: 1 (better take Bonus Ranged Damage perk instead)"
                                 + "\n- Maximum Chance To Hit: 94 + (CH+1)/2");

        tooltipsKey.insertLast(ST_INTELLECT);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_INTELLECT)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_INTELLECT))
                                 + pipText + jjJournal
                                 + "\n\n\"There is a very old and knowledgeable woman in the Hub working in a bookshop at the market square between the caravan offices. She had some good advice on technical books, but they were out of the 3rd volume of Big Books of Science. If I were to return there I sure will check that bookstore out again.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n- Effectiveness of combat skills: (in combat calculations)"
                                 + "\n\t- 4% skill penalty for every point below 5 IN"
                                 + "\n\t\t(example: 100 SG skill with 1 IN becomes 84 SG skill)"
                                 + "\n\t- 4% skill bonus for every point above 5 IN"
                                 + "\n\t\t(example: 100 SG skill with 10 IN becomes 120 SG skill)"
                                 + "\n- Critical hit chance bonus from To Hit overflow: clamp(toHitOverflow/10, 0, 5+IN)"
                                 + "\n\t- ex: IN: 5, Hit Roll: 45 vs Hit Chance: 210 -> (165 overflow) / 10 -> 16 -> 10% crit. chance bonus"
                                 + "\n\t- Note: Weaker version of this effect was present before, now it has higher cap with 5+IN"
                                 + "\n- Critical hit chance for Aimed attacks: AimLocationBonus * (60 + 4*IN) / 100"
                                 + "\n- Sniper crit. chance bonus: (5*IN - 2*LK) * sniperMargin/150 (max. 50)"
                                 + "\n\t- SniperMargin value is the hit overflow compared to the hit roll, max. 150"
                                 + "\n- Enhanced KO (head) resist factor for EN clamped with IN+4 (9EN and 2IN -> 6EN)"
                                 + "\n- KO duration reduction factor: up to 2/3 duration reduction with 10IN"
                                 + "\n\nNOTE: Does no longer give extra skill points per level.");

        tooltipsKey.insertLast(ST_AGILITY);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_AGILITY)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_AGILITY))
                                 + pipText + jjJournal
                                 + "\n\n\"I saw some children yesterday playing around gecko traps in Klamath, far to the north-west, without triggering any them. Must be good to be young and agile.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n- Armor Class: +3*AG (double with Livewire perk)"
                                 + "\n- Action Points factor changed: (5 + 2*AG) -> (5 + (13+AG)/4)"
                                 + "\n\t- ex: 7AG-10AG -> 10AP, 3AG-6AG -> 9AP, 1AG-2AG -> 8AP"
                                 + "\n- Equipped Armor's can change AG level:"
                                 + "\n\t- Light Armor +1AG bonus (Leather Armor types and also give Quick Pockets Perk)"
                                 + "\n\t- Medium Armor -1AG malus (Combat Armor types and also give Iron Limbs Perk)"
                                 + "\n\t- Heavy Armor -3AG malus (Metal Armor types and also give Stonewall Perk)");

        tooltipsKey.insertLast(ST_LUCK);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_LUCK)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_LUCK))
                                 + pipText + jjJournal
                                 + "\n\n\"Finally I found some kind of abandoned theme-park with a working Nuka-Cola machine to the north-east but I didn't have any full water bags left to feed the machine. I shall not forget to pick some mutated fruits for the flavor before I return with fresh water.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n- Critical Chance on all attacks: 1*LK as crit. chance"
                                 + "\n- Reduce chance to be critically hit: LK/2 as crit. chance reduce"
                                 + "\n\t- Reduce chance to be critically hit by Sniper Perk: LK*2 reduce"
                                 + "\n- Critical Failure magnitude roll: Roll - 5 * (LK-5) vs 1d100"
                                 + "\n- Critical Power roll factor as target: reduce power by 1*LK"
                                 + "\n- Chance to get poisoned or radiated by creature attacks like:"
                                 + "\n\t- Radscorpions, Floaters, Aliens or Centaurs: 1d10+1 vs LK"
                                 + "\n- Thief Perk steal timeout reduce: 1d50 vs LK"
                                 + "\n- Spearfishing rare catch factor: LK/2 (overwritten by Golden Locket = 5, Magic 8-ball = 10)"
                                 + "\n- Primitive Tool (not) break chance: 10 + 5*LK vs 1d100"
                                 + "\n- Car repair tool break chance: 1 vs 1d(Repair/10 + LK/2)");
        //  skills
        tooltipsKey.insertLast(SK_SMALL_GUNS);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_SMALL_GUNS)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_SMALL_GUNS))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active combat specialization skill, leveled by spending Skill Points, up to a maximum of 200. (if this is tagged as your combat specialization then 300)"
                                 + "\n- To know more about Chance To Hit calculations attack a training dummy in a tent or base."
                                 + modifies
                                 + "\n- Base chance to hit with small guns.");

        tooltipsKey.insertLast(SK_BIG_GUNS);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_BIG_GUNS)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_BIG_GUNS))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active combat specialization skill, leveled by spending Skill Points, up to a maximum of 200. (if this is tagged as your combat specialization then 300)"
                                 + "\n- To know more about Chance To Hit calculations attack a training dummy in a tent or base."
                                 + modifies
                                 + "\n- Base chance to hit with big guns.");

        tooltipsKey.insertLast(SK_ENERGY_WEAPONS);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_ENERGY_WEAPONS)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_ENERGY_WEAPONS))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active combat specialization skill, leveled by spending Skill Points, up to a maximum of 200. (if this is tagged as your combat specialization then 300)"
                                 + "\n- To know more about Chance To Hit calculations attack a training dummy in a tent or base."
                                 + modifies
                                 + "\n- Base chance to hit with energy weapons.");

        tooltipsKey.insertLast(SK_UNARMED);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_UNARMED)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_UNARMED))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active combat specialization skill, leveled by spending Skill Points, up to a maximum of 200. (if this is tagged as your combat specialization then 300)"
                                 + "\n- To know more about Chance To Hit calculations attack a training dummy in a tent or base."
                                 + modifies
                                 + "\n- Base chance to hit with melee weapons or unarmed attacks.");

        tooltipsKey.insertLast(SK_SCAVENGING);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_SCAVENGING)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_SCAVENGING))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- Passive non-combat skill, can be leveled by related activity up to a maximum of 200."
                                 + "\n- To be able to scavenge you will need some kind of tool in inventory (not needed to be in hand), then hovering mouse over old barrels, newspaper machines, rusty sceneries etc., will change the mouse cursor and show your tool, indicating if that scenery is scavengeable."
                                 + modifies
                                 + "\n- Chance to scavenge useful or even rare materials.");

        tooltipsKey.insertLast(SK_THROWING);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_THROWING)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_THROWING))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active combat specialization skill, leveled by spending Skill Points, up to a maximum of 200. (if this is tagged as your combat specialization then 300)"
                                 + "\n- To know more about Chance To Hit calculations attack a training dummy in a tent or base."
                                 + modifies
                                 + "\n- Base chance to hit with throwing weapons.");

        tooltipsKey.insertLast(SK_FIRST_AID);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_FIRST_AID)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_FIRST_AID))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active combat skill that you cannot specialize in. If you want to be a healer you can tag Doctor skill instead. You can level this skill by spending Skill Points, up to a maximum of 200."
                                 + modifies
                                 + "\n- First Aid cooldown and effect.");

        tooltipsKey.insertLast(SK_DOCTOR);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_DOCTOR)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_DOCTOR))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active combat specialization skill, leveled by spending Skill Points, up to a maximum of 200. (if this is tagged as your combat specialization then 300)"
                                 + modifies
                                 + "\n- Doctor cooldown and chance to success.");

        tooltipsKey.insertLast(SK_SNEAK);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_SNEAK)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_SNEAK))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active combat specialization skill, leveled by spending Skill Points, up to a maximum of 200. (if this is tagged as your combat specialization then 300)"
                                 + modifies
                                 + "\n- Chance that you can remain undetected while sneaking.");

        tooltipsKey.insertLast(SK_LOCKPICK);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_LOCKPICK)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_LOCKPICK))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- Passive non-combat skill, can be leveled by related activity up to a maximum of 200."
                                 + modifies
                                 + "\n- Chance to open locks.");

        tooltipsKey.insertLast(SK_STEAL);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_STEAL)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_STEAL))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active non-combat skill that you cannot specialize in. You can level this skill by spending Skill Points, up to a maximum of 200."
                                 + modifies
                                 + "\n- Chance to steal from NPC's or players in non safe towns.");

        tooltipsKey.insertLast(SK_TRAPS);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_TRAPS)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_TRAPS))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- This is an active combat specialization skill, leveled by spending Skill Points, up to a maximum of 200. (if this is tagged as your combat specialization then 300)"
                                 + modifies
                                 + "\n- Explosives strength and chance of not triggering traps.");

        tooltipsKey.insertLast(SK_SCIENCE);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_SCIENCE)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_SCIENCE))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- Passive non-combat skill, can be leveled by related activity up to a maximum of 200."
                                 + modifies
                                 + "\n- Ability to craft high-tech stuff.");

        tooltipsKey.insertLast(SK_REPAIR);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_REPAIR)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_REPAIR))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- Passive non-combat skill, can be leveled by related activity up to a maximum of 200."
                                 + modifies
                                 + "\n- Ability to craft most items, armors and weapons."
                                 + "\n- Chance to repair mostly items, cars or in general any mechanism.");

        tooltipsKey.insertLast(SK_SPEECH);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_SPEECH)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_SPEECH))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- Passive non-combat skill, can be leveled by related activity up to a maximum of 200."
                                 + modifies
                                 + "\n- Party size."
                                 + "\n- Sometimes dialog options and their chance to work.");

        tooltipsKey.insertLast(SK_BARTER);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_BARTER)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_BARTER))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- Passive non-combat skill, can be leveled by related activity up to a maximum of 200."
                                 + modifies
                                 + "\n- Barter prices.");

        tooltipsKey.insertLast(SK_GAMBLING);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_GAMBLING)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_GAMBLING))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- Passive non-combat skill, can be leveled by related activity up to a maximum of 200."
                                 + modifies
