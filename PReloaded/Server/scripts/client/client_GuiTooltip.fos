        tooltipsKey.insertLast(SK_OUTDOORSMAN);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_OUTDOORSMAN)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_OUTDOORSMAN))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n- Passive non-combat skill, can be leveled by related activity up to a maximum of 200."
                                 + "\n\t- Traveling on world map"
                                 + "\n\t- Crafting traveling gear (spears, leather armor and such)"
                                 + "\n\t- Spearfishing, cooking"
                                 + modifies
                                 + "\n- Chance to be able to evade encounters while traveling."
                                 + "\n- Spearfishing, cooking and such.");
        //  Hit Points and Damaged parts
        tooltipsKey.insertLast(ST_MAX_LIFE);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_MAX_LIFE)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_MAX_LIFE)) + pipText);
        tooltipsValueExt.insertLast(pipReference + noData);

        tooltipsKey.insertLast(DAMAGE_POISONED);
