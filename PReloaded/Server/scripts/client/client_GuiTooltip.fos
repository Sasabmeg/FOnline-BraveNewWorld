import string showItemBonus(ItemCl& it, int type, int value) from "client_interface";
import bool IsDetectHiddenWeapon(ItemMutual& item) from "hexThrow";

/*
import uint GetRadiationStage(int level) from "client/client_buffs";
import int GetStatLossForRadiationLevel(int stat, int level) from "client/client_buffs";
import uint GetRadiationLevelColor(int level) from "client/client_buffs";
import uint PercentColor(uint percent, bool clamp = true) from "client/client_buffs";
