#define STR_POISON_PROCESS      (12811)

#define COLOR_REGULAR           (COLOR_GREEN)
#define COLOR_BUFF              (COLOR_GOLDEN_YELLOW)
#define COLOR_DEBUFF            (COLOR_DORANGE)

#define TOOLTIPS_DEBUG_LOGGING  (false)

void LogToolTips(string& str) {
    if (TOOLTIPS_DEBUG_LOGGING) {
        Message("Tooltips :: " + str);
    }
}

CGuiTooltip characterTooltip;
CGuiTooltip inventoryTooltip;
CTooltips tooltipKeyValue;
bool chosenIsInvalid = true;
uint lastInventoryItemId;
uint tooltipRefreshDelay = 0;

class CTooltips {
    array<uint>     tooltipsKey;
    array<string>   tooltipsValue;
    array<string>   tooltipsValueExt;
    CTooltips() {
        InitTooltips();
    }

    string getToolTip(uint key) {
        int index = 0;
        index = tooltipsKey.find(key);
        if (index >= 0) {
            return tooltipsValue[index];
        } else {
            return "N/A";
        }
    }

    string getToolTipExt(uint key) {
        int index = 0;
        index = tooltipsKey.find(key);
        if (index >= 0) {
            return tooltipsValueExt[index];
        } else {
            return "\n\nN/A";
        }
    }

    void InitTooltips() {
        string pipText = "\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \u00ABVault-Tec Pip-Info\u2122\u00BB";
        string jjJournal = "\nJournal entry:";
        string jjText = "\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t  - Chief Gadgeteer 'Jinxed' Jack -";
        string pipStatus = "\nPIP-STATUS:\n";
        string pipReference = "\n|" + COLOR_GREEN + " Extended Pip-boy database search results:\n";
        string notes = "";//"\nNotes:";
        string requirements = "\n\nRequirements:";
        string modifies = "\n\nModifies:";
        string tldr = "\n\nTLDR:";
        string noData = "- No additional information available.";
        string @bullet = EncodeUTF8(0x2022);

        string strengthExt = "";
        string perceptionExt = "";
        string enduranceExt = "";
        string charismaExt = "";
        string intellectExt = "";
        string agilityExt = "";
        string luckExt = "";

        string lockpickExt = "";
        string scienceExt = "";
        string repairExt = "";
        string barterExt = "";
        string gamblingExt = "";
        string outdoorsmanExt = "";

        string resistExt = "";
        string healingRateExt = "";
        string radiatedExt = "";
        string poisonedExt = "";
        string carryWeightExt = "";
        string radiationResistExt = "";
        string poisonResistExt = "";
        string maxLifeExt = "";
        string armorClassExt = "";
        string ActionPointsExt = "";
        string meleeDamageExt = "";
        string stonewallExt = "";
        CritterCl@ chosen = GetChosen();

        if (valid(chosen)) {
            //Message("InitTooltips :: chosen valid");
            int helmetNormalDT = chosen.Stat[ST_NORMAL_ABSORB];
            int helmetNormalDR = chosen.Stat[ST_NORMAL_RESIST];
            int helmetLaserDT = chosen.Stat[ST_LASER_ABSORB];
            int helmetLaserDR = chosen.Stat[ST_LASER_RESIST];
            int helmetFireDT = chosen.Stat[ST_FIRE_ABSORB];
            int helmetFireDR = chosen.Stat[ST_FIRE_RESIST];
            int helmetPlasmaDT = chosen.Stat[ST_PLASMA_ABSORB];
            int helmetPlasmaDR = chosen.Stat[ST_PLASMA_RESIST];
            int helmetElectrDT = chosen.Stat[ST_ELECTRO_ABSORB];
            int helmetElectrDR = chosen.Stat[ST_ELECTRO_RESIST];
            int helmetExplodeDT = chosen.Stat[ST_EXPLODE_ABSORB];
            int helmetExplodeDR = chosen.Stat[ST_EXPLODE_RESIST];
            int armorRadResist = 0;
            int stonewallRank = 0;
            int stonewallRankHead = 0;
            if (chosen.Param[PE_STONEWALL] > 0) {
                stonewallRank = 1;
                stonewallRankHead = 1;
            }
            int thermalLeatherArmorFlamerResist = 1;

            ItemCl@ helmet = chosen.GetItem(0, SLOT_HEAD);
            ItemCl@ bodyArmor = chosen.GetItem(0, SLOT_ARMOR);

            if (valid(bodyArmor)) {
                helmetNormalDT -= bodyArmor.Proto.Armor_DTNormal;
                helmetNormalDR -= bodyArmor.Proto.Armor_DRNormal;
                helmetLaserDT -= bodyArmor.Proto.Armor_DTLaser;
                helmetLaserDR -= bodyArmor.Proto.Armor_DRLaser;
                helmetFireDT -= bodyArmor.Proto.Armor_DTFire;
                helmetFireDR -= bodyArmor.Proto.Armor_DRFire;
                helmetPlasmaDT -= bodyArmor.Proto.Armor_DTPlasma;
                helmetPlasmaDR -= bodyArmor.Proto.Armor_DRPlasma;
                helmetElectrDT -= bodyArmor.Proto.Armor_DTElectr;
                helmetElectrDR -= bodyArmor.Proto.Armor_DRElectr;
                helmetExplodeDT -= bodyArmor.Proto.Armor_DTExplode;
                helmetExplodeDR -= bodyArmor.Proto.Armor_DRExplode;
                switch (bodyArmor.Proto.Armor_Perk) {
                    case ARMOR_PERK_POWERED: armorRadResist = 35; stonewallRank += 1; break;
                    case ARMOR_PERK_ADVANCED_I:
                    case ARMOR_PERK_ADVANCED_II: armorRadResist = 40; break;
                    case ARMOR_PERK_LEATHER_JACKET: armorRadResist = 5; break;
                    case ARMOR_PERK_LEATHER_ARMOR: armorRadResist = 10; break;
                    case ARMOR_PERK_THERMAL_LEATHER: armorRadResist = 35; break;
                    case ARMOR_PERK_COMBAT: armorRadResist = 25; break;
                    case ARMOR_PERK_METAL: armorRadResist = 15; stonewallRank += 1; break;
                    case ARMOR_PERK_TESLA: armorRadResist = 35; stonewallRank += 1; break;
                    case ARMOR_PERK_CAMOUFLAGE_HP: armorRadResist = 10; break;
                }
                if (bodyArmor.GetProtoId() == PID_THERMAL_LEATHER_ARMOR) {
                    thermalLeatherArmorFlamerResist = 3;
                }
            }
            if (valid(helmet)) {
                helmetNormalDT += helmet.Proto.Armor_DTNormal;
                helmetNormalDR += helmet.Proto.Armor_DRNormal;
                helmetLaserDT += helmet.Proto.Armor_DTLaser;
                helmetLaserDR += helmet.Proto.Armor_DRLaser;
                helmetFireDT += helmet.Proto.Armor_DTFire;
                helmetFireDR += helmet.Proto.Armor_DRFire;
                helmetPlasmaDT += helmet.Proto.Armor_DTPlasma;
                helmetPlasmaDR += helmet.Proto.Armor_DRPlasma;
                helmetElectrDT += helmet.Proto.Armor_DTElectr;
                helmetElectrDR += helmet.Proto.Armor_DRElectr;
                helmetExplodeDT += helmet.Proto.Armor_DTExplode;
                helmetExplodeDR += helmet.Proto.Armor_DRExplode;
                switch (helmet.GetProtoId()) {
                    case PID_METAL_HELMET:
                    case PID_METAL_HELMET_MK2:
                    case PID_FRONT_PLATED_METAL_HELMET:
                    case PID_TESLA_HELMET:
                    case PID_POWER_HELMET:
                        stonewallRankHead++;
                        break;
                }

            }

            resistExt = "\nBase:\t\t\t\t\t\tBuff:\t\t\t\t\t\tBody:\t\t\t\t\t\tHead:"
                         + "\n\tNormal: \u00A0\u00A0\u00A0" + chosen.StatBase[ST_NORMAL_ABSORB] + "/" + chosen.StatBase[ST_NORMAL_RESIST]
                         + (chosen.StatBase[ST_NORMAL_ABSORB] > 9 ? "" : " ") + (chosen.StatBase[ST_NORMAL_RESIST] > 9 ? "" : " ")
                         + "\t\tNormal: \u00A0\u00A0\u00A0" + chosen.StatBase[ST_NORMAL_ABSORB_EXT] + "/" + chosen.StatBase[ST_NORMAL_RESIST_EXT]
                         + (chosen.StatBase[ST_NORMAL_ABSORB_EXT] > 9 || chosen.StatBase[ST_NORMAL_ABSORB_EXT] < 0 ? "" : " ")
                         + (chosen.StatBase[ST_NORMAL_RESIST_EXT] > 9 || chosen.StatBase[ST_NORMAL_RESIST_EXT] < 0 ? "" : " ")
                         + "\t\tNormal: \u00A0\u00A0\u00A0" + chosen.Stat[ST_NORMAL_ABSORB] + "/" + chosen.Stat[ST_NORMAL_RESIST]
                         + (chosen.Stat[ST_NORMAL_ABSORB] > 9 ? "" : " ") + (chosen.Stat[ST_NORMAL_RESIST] > 9 ? "" : " ")
                         + "\t\tNormal: \u00A0\u00A0\u00A0" + helmetNormalDT + "/" + helmetNormalDR
                         + "\n\tLaser:     \u00A0" + chosen.StatBase[ST_LASER_ABSORB] + "/" + chosen.StatBase[ST_LASER_RESIST]
                         + (chosen.StatBase[ST_LASER_ABSORB] > 9 ? "" : " ") + (chosen.StatBase[ST_LASER_RESIST] > 9 ? "" : " ")
                         + "\t\tLaser:     \u00A0" + chosen.StatBase[ST_LASER_ABSORB_EXT] + "/" + chosen.Stat[ST_LASER_RESIST_EXT]
                         + (chosen.StatBase[ST_LASER_ABSORB_EXT] > 9 || chosen.StatBase[ST_LASER_ABSORB_EXT] < 0 ? "" : " ")
                         + (chosen.StatBase[ST_LASER_RESIST_EXT] > 9 || chosen.StatBase[ST_LASER_RESIST_EXT] < 0 ? "" : " ")
                         + "\t\tLaser:     \u00A0" + chosen.Stat[ST_LASER_ABSORB] + "/" + chosen.Stat[ST_LASER_RESIST]
                         + (chosen.Stat[ST_LASER_ABSORB] > 9 ? "" : " ") + (chosen.Stat[ST_LASER_RESIST] > 9 ? "" : " ")
                         + "\t\tLaser:     \u00A0" + helmetLaserDT + "/" + helmetLaserDR
                         + "\n\tFire:         " + chosen.StatBase[ST_FIRE_ABSORB] + "/" + chosen.StatBase[ST_FIRE_RESIST]
                         + (chosen.StatBase[ST_FIRE_ABSORB] > 9 ? "" : " ") + (chosen.StatBase[ST_FIRE_RESIST] > 9 ? "" : " ")
                         + "\t\tFire:         " + chosen.StatBase[ST_FIRE_ABSORB_EXT] + "/" + chosen.StatBase[ST_FIRE_RESIST_EXT]
                         + (chosen.StatBase[ST_FIRE_ABSORB_EXT] > 9 || chosen.StatBase[ST_FIRE_ABSORB_EXT] < 0 ? "" : " ")
                         + (chosen.StatBase[ST_FIRE_RESIST_EXT] > 9 || chosen.StatBase[ST_FIRE_RESIST_EXT] < 0 ? "" : " ")
                         + "\t\tFire:         " + chosen.Stat[ST_FIRE_ABSORB] + "/" + chosen.Stat[ST_FIRE_RESIST]
                         + (chosen.Stat[ST_FIRE_ABSORB] > 9 ? "" : " ") + (chosen.Stat[ST_FIRE_RESIST] > 9 ? "" : " ")
                         + "\t\tFire:         " + helmetLaserDT + "/" + helmetFireDR
                         + "\n\tPlasma:  \u00A0\u00A0" + chosen.StatBase[ST_PLASMA_ABSORB] + "/" + chosen.StatBase[ST_PLASMA_RESIST]
                         + (chosen.StatBase[ST_PLASMA_ABSORB] > 9 ? "" : " ") + (chosen.StatBase[ST_PLASMA_RESIST] > 9 ? "" : " ")
                         + "\t\tPlasma:  \u00A0\u00A0" + chosen.StatBase[ST_PLASMA_ABSORB_EXT] + "/" + chosen.StatBase[ST_PLASMA_RESIST_EXT]
                         + (chosen.StatBase[ST_PLASMA_ABSORB_EXT] > 9 || chosen.StatBase[ST_PLASMA_ABSORB_EXT] < 0 ? "" : " ")
                         + (chosen.StatBase[ST_PLASMA_RESIST_EXT] > 9 || chosen.StatBase[ST_PLASMA_RESIST_EXT] < 0 ? "" : " ")
                         + "\t\tPlasma:  \u00A0\u00A0" + chosen.Stat[ST_PLASMA_ABSORB] + "/" + chosen.Stat[ST_PLASMA_RESIST]
                         + (chosen.Stat[ST_PLASMA_ABSORB] > 9 ? "" : " ") + (chosen.Stat[ST_PLASMA_RESIST] > 9 ? "" : " ")
                         + "\t\tPlasma:  \u00A0\u00A0" + helmetNormalDT + "/" + helmetPlasmaDR
                         + "\n\tElectric:  \u00A0" + chosen.StatBase[ST_ELECTRO_ABSORB] + "/" + chosen.StatBase[ST_ELECTRO_RESIST]
                         + (chosen.StatBase[ST_ELECTRO_ABSORB] > 9 ? "" : " ") + (chosen.StatBase[ST_ELECTRO_RESIST] > 9 ? "" : " ")
                         + "\t\tElectric:  \u00A0" + chosen.StatBase[ST_ELECTRO_ABSORB_EXT] + "/" + chosen.StatBase[ST_ELECTRO_RESIST_EXT]
                         + (chosen.StatBase[ST_ELECTRO_ABSORB_EXT] > 9 || chosen.StatBase[ST_ELECTRO_ABSORB_EXT] < 0 ? "" : " ")
                         + (chosen.StatBase[ST_ELECTRO_RESIST_EXT] > 9 || chosen.StatBase[ST_ELECTRO_RESIST_EXT] < 0 ? "" : " ")
                         + "\t\tElectric:  \u00A0" + chosen.Stat[ST_ELECTRO_ABSORB] + "/" + chosen.Stat[ST_ELECTRO_RESIST]
                         + (chosen.Stat[ST_ELECTRO_ABSORB] > 9 ? "" : " ") + (chosen.Stat[ST_ELECTRO_RESIST] > 9 ? "" : " ")
                         + "\t\tElectric:  \u00A0" + helmetElectrDT + "/" + helmetElectrDR
                         + "\n\tExplode:  \u00A0" + chosen.StatBase[ST_EXPLODE_ABSORB] + "/" + chosen.StatBase[ST_EXPLODE_RESIST]
                         + (chosen.StatBase[ST_EXPLODE_ABSORB] > 9 ? "" : " ") + (chosen.StatBase[ST_EXPLODE_RESIST] > 9 ? "" : " ")
                         + "\t\tExplode:  \u00A0" + chosen.StatBase[ST_EXPLODE_ABSORB_EXT] + "/" + chosen.StatBase[ST_EXPLODE_RESIST_EXT]
                         + (chosen.StatBase[ST_EXPLODE_ABSORB_EXT] > 9 || chosen.StatBase[ST_EXPLODE_ABSORB_EXT] < 0 ? "" : " ")
                         + (chosen.StatBase[ST_EXPLODE_RESIST_EXT] > 9 || chosen.StatBase[ST_EXPLODE_RESIST_EXT] < 0 ? "" : " ")
                         + "\t\tExplode:  \u00A0" + chosen.Stat[ST_EXPLODE_ABSORB] + "/" + chosen.Stat[ST_EXPLODE_RESIST]
                         + (chosen.Stat[ST_EXPLODE_ABSORB] > 9 ? "" : " ") + (chosen.Stat[ST_EXPLODE_RESIST] > 9 ? "" : " ")
                         + "\t\tExplode:  \u00A0" + helmetExplodeDT + "/" + helmetElectrDR + "\n";
            int strDif = chosen.Stat[ST_STRENGTH] - chosen.StatBase[ST_STRENGTH];
            int perDif = chosen.Stat[ST_PERCEPTION] - chosen.StatBase[ST_PERCEPTION];
            int endDif = chosen.Stat[ST_ENDURANCE] - chosen.StatBase[ST_ENDURANCE];
            int chaDif = chosen.Stat[ST_CHARISMA] - chosen.StatBase[ST_CHARISMA];
            int intDif = chosen.Stat[ST_INTELLECT] - chosen.StatBase[ST_INTELLECT];
            int agiDif = chosen.Stat[ST_AGILITY] - chosen.StatBase[ST_AGILITY];
            int luckDif = chosen.Stat[ST_LUCK] - chosen.StatBase[ST_LUCK];
            int radiationLevel = chosen.Stat[ST_RADIATION_LEVEL];
            int poisoningLevel = chosen.Stat[ST_POISONING_LEVEL];
            int carryWeightBase = chosen.StatBase[ST_CARRY_WEIGHT] + chosen.StatBase[ST_CARRY_WEIGHT_EXT];
            carryWeightBase += 453 * (25 + chosen.Stat[ST_STRENGTH] * 25);
            carryWeightBase += 20000;
            int carryWeightDif = chosen.Stat[ST_CARRY_WEIGHT] - carryWeightBase;

            strengthExt = "\n\u2022 Base: " + chosen.StatBase[ST_STRENGTH]
                        + "\n\u2022 Effects: " + (strDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + strDif + "|" + COLOR_GREEN + " ";
                        if (radiationLevel > 0) {
                            int statLoss = GetStatLossForRadiationLevel(ST_STRENGTH, radiationLevel);
                            strengthExt += "\n\t\u2022 " + (statLoss > 0 ? ("|" + COLOR_DEBUFF + " -" + statLoss):("|" + COLOR_BUFF + " " + statLoss)) + "|" + COLOR_REGULAR + "  from radiation";
                        }
                        if (chosen.Param[TO_BUFFOUT] > 0) {
                            strengthExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1" + "|" + COLOR_REGULAR + "  from Buffout";
                        }
                        if (chosen.Param[TO_MENTATS] > 0) {
                            strengthExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " -1" + "|" + COLOR_REGULAR + "  from Mentats";
                        }
                        if (GetClientBuffsTimeout(CLIENT_BUFFS_SALMON) > 0) {
                            strengthExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1" + "|" + COLOR_REGULAR + "  from Salmon";
                        }
                        if (chosen.Param[DAMAGE_LEFT_LEG] > 0 || chosen.Param[DAMAGE_RIGHT_LEG] > 0) {
                            if (chosen.Param[DAMAGE_LEFT_LEG] == 0) {
                                strengthExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " -1" + "|" + COLOR_REGULAR + "  from Damaged Right Leg";
                            } else if (chosen.Param[DAMAGE_RIGHT_LEG] == 0) {
                                strengthExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " -1" + "|" + COLOR_REGULAR + "  from Damaged Left Leg";
                            } else {
                                strengthExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " -3 " + "|" + COLOR_REGULAR + " from both legs crippled";
                            }
                        }
            perceptionExt = "\n\u2022 Base: " + chosen.StatBase[ST_PERCEPTION]
                            + "\n\u2022 Effects: " + (perDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + perDif + "|" + COLOR_GREEN + " ";
                            if (radiationLevel > 0) {
                                int statLoss = GetStatLossForRadiationLevel(ST_PERCEPTION, radiationLevel);
                                perceptionExt += "\n\t\u2022 " + (statLoss > 0 ? ("|" + COLOR_DEBUFF + " -" + statLoss):("|" + COLOR_BUFF + " " + statLoss)) + "|" + COLOR_REGULAR + "  from radiation";
                            }
            enduranceExt = "\n\u2022 Base: " + chosen.StatBase[ST_ENDURANCE]
                            + "\n\u2022 Effects: " + (endDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + endDif + "|" + COLOR_GREEN + " ";
                            if (radiationLevel > 0) {
                                int statLoss = GetStatLossForRadiationLevel(ST_ENDURANCE, radiationLevel);
                                enduranceExt += "\n\t\u2022 " + (statLoss > 0 ? ("|" + COLOR_DEBUFF + " -" + statLoss):("|" + COLOR_BUFF + " " + statLoss)) + "|" + COLOR_REGULAR + "  from radiation";
                            }
                            if (chosen.Param[TO_BUFFOUT] > 0) {
                                enduranceExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1" + "|" + COLOR_REGULAR + "  from Buffout";
                            }
                            if (GetClientBuffsTimeout(CLIENT_BUFFS_TUNA) > 0) {
                                enduranceExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1" + "|" + COLOR_REGULAR + "  from Tuna";
                            }
            charismaExt = "\n\u2022 Base: " + chosen.StatBase[ST_CHARISMA]
                            + "\n\u2022 Effects: " + (chaDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + chaDif + "|" + COLOR_GREEN + " ";
                            if (radiationLevel > 0) {
                                int statLoss = GetStatLossForRadiationLevel(ST_CHARISMA, radiationLevel);
                                charismaExt += "\n\t\u2022 " + (statLoss > 0 ? ("|" + COLOR_DEBUFF + " -" + statLoss):("|" + COLOR_BUFF + " " + statLoss)) + "|" + COLOR_REGULAR + "  from radiation";
                            }
                            if (chosen.Param[TO_MENTATS] > 0) {
                                charismaExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1" + "|" + COLOR_REGULAR + "  from Mentats";
                            }
            intellectExt = "\n\u2022 Base: " + chosen.StatBase[ST_INTELLECT]
                            + "\n\u2022 Effects: " + (intDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + intDif + "|" + COLOR_GREEN + " ";
                            if (radiationLevel > 0) {
                                int statLoss = GetStatLossForRadiationLevel(ST_INTELLECT, radiationLevel);
                                intellectExt += "\n\t\u2022 " + (statLoss > 0 ? ("|" + COLOR_DEBUFF + " -" + statLoss):("|" + COLOR_BUFF + " " + statLoss)) + "|" + COLOR_REGULAR + "  from radiation";
                            }
                            if (chosen.Param[TO_BUFFOUT] > 0) {
                                intellectExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " -1" + "|" + COLOR_REGULAR + "  from Buffout";
                            }
                            if (chosen.Param[TO_MENTATS] > 0) {
                                intellectExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1" + "|" + COLOR_REGULAR + "  from Mentats";
                            }
            agilityExt = "\n\u2022 Base: " + chosen.StatBase[ST_AGILITY]
                        + "\n\u2022 Effects: " + (agiDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + agiDif + "|" + COLOR_GREEN + " ";
                        if (radiationLevel > 0) {
                            int statLoss = GetStatLossForRadiationLevel(ST_AGILITY, radiationLevel);
                            agilityExt += "\n\t\u2022 " + (statLoss > 0 ? ("|" + COLOR_DEBUFF + " -" + statLoss):("|" + COLOR_BUFF + " " + statLoss)) + "|" + COLOR_REGULAR + "  from radiation";
                        }
                        if (chosen.Param[TO_NUKA_COLA] > 0) {
                            agilityExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1" + "|" + COLOR_REGULAR + "  from Nuka Cola";
                        }
                        if (GetClientBuffsTimeout(CLIENT_BUFFS_CATFISH) > 0) {
                            agilityExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1" + "|" + COLOR_REGULAR + "  from Catfish";
                        }
                        if (chosen.Param[DAMAGE_LEFT_ARM] > 0 || chosen.Param[DAMAGE_RIGHT_ARM] > 0) {
                            if (chosen.Param[DAMAGE_LEFT_ARM] == 0) {
                                agilityExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " -3" + "|" + COLOR_REGULAR + "  from Damaged Right Arm";
                            } else if (chosen.Param[DAMAGE_RIGHT_ARM] == 0) {
                                agilityExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " -3" + "|" + COLOR_REGULAR + "  from Damaged Left Arm";
                            } else {
                                agilityExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " AG 1 " + "|" + COLOR_REGULAR + " because both arms crippled";
                            }
                        }
                        if (chosen.Param[PE_BONUS_RATE_OF_ATTACK] > 0) {
                            agilityExt += "\n\t\u2022 AP cost reduce by " + "|" + COLOR_BUFF + " 1 AP" + "|" + COLOR_REGULAR + "  from BRoA";
                        } else {
                            string apReduce;
                            if (chosen.Stat[ST_AGILITY] > 9) {
                                apReduce = "1";
                            } else {
                                apReduce = "0." + chosen.Stat[ST_AGILITY];
                            }
                            agilityExt += "\n\t\u2022 AP cost reduce by " + "|" + COLOR_BUFF + "  " + apReduce + "|" + COLOR_REGULAR + "  from Agility";
                        }
                        if (valid(bodyArmor)) {
                            if (chosen.Param[ST_CURRENT_ARMOR_PERK] > 0) {
                                switch(chosen.Param[ST_CURRENT_ARMOR_PERK]) {
                                    case ARMOR_PERK_POWERED:
                                    case ARMOR_PERK_ADVANCED_I:
                                    case ARMOR_PERK_ADVANCED_II:
                                    case ARMOR_PERK_METAL:
                                    case ARMOR_PERK_TESLA:
                                        agilityExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " -3" + "|" + COLOR_REGULAR + "  from Heavy Armor";
                                        break;
                                    case ARMOR_PERK_LEATHER_JACKET:
                                    case ARMOR_PERK_LEATHER_ARMOR:
                                    case ARMOR_PERK_THERMAL_LEATHER:
                                        agilityExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1" + "|" + COLOR_REGULAR + "  from Light Armor";
                                        break;
                                    case ARMOR_PERK_COMBAT:
                                        agilityExt += "\n\t\u2022 " + "|" + COLOR_DEBUFF + " -1" + "|" + COLOR_REGULAR + "  from Medium Armor";
                                        break;
                                    case ARMOR_PERK_CAMOUFLAGE_HP:
                                    default:
                                        break;
                                }
                            }
                        }

            luckExt = "\nCurrent:"
                    + "\n\u2022 Base: " + chosen.StatBase[ST_LUCK]
                    + "\n\u2022 Effects: " + (luckDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + luckDif + "|" + COLOR_REGULAR + " ";

            lockpickExt = "\n\u2022 XP needed for next skill level: " + _XpForNextSkill(chosen.Skill[SK_LOCKPICK]) + "\n\n";
            scienceExt = "\n\u2022 XP needed for next skill level: " + _XpForNextSkill(chosen.Skill[SK_SCIENCE]) + "\n\n";
            repairExt = "\n\u2022 XP needed for next skill level: " + _XpForNextSkill(chosen.Skill[SK_REPAIR]) + "\n\n";
            gamblingExt = "\n\u2022 XP needed for next skill level: " + _XpForNextSkill(chosen.Skill[SK_GAMBLING]) + "\n\n";
            barterExt = "\n\u2022 XP needed for next skill level: " + _XpForNextSkill(chosen.Skill[SK_BARTER]) + "\n\n";
            outdoorsmanExt = "\n\u2022 XP needed for next skill level: " + _XpForNextSkill(chosen.Skill[SK_OUTDOORSMAN]) + "\n\n";

            int maxLifeBase = chosen.StatBase[ST_MAX_LIFE] + chosen.Stat[ST_ENDURANCE]*3 + chosen.Stat[ST_STRENGTH]*2;
            int maxLifeDif = chosen.Stat[ST_MAX_LIFE] - maxLifeBase;
            maxLifeExt = "\nCurrent: " + "|" + COLOR_BUFF + " " + chosen.Stat[ST_MAX_LIFE] + "|" + COLOR_GREEN + " "
                        + "\n\u2022 Base: " + "|" + COLOR_BUFF + " " + maxLifeBase + "|" + COLOR_GREEN + " "
                        + "\n\t\u2022 " + "|" + COLOR_BUFF + " +168|" + COLOR_REGULAR + "  from Base"
                        + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +15|" + COLOR_REGULAR + "  for all creatures"
                        + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +40|" + COLOR_REGULAR + "  for all humanoids"
                        + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +113|" + COLOR_REGULAR + "  for all players";
                        if (chosen.Stat[ST_LEVEL] > 1) {
                            maxLifeExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + (CLAMP(chosen.Stat[ST_LEVEL] - 1, 0, 23) * 4) + "|" + COLOR_REGULAR + "  from level up";
                        }
                        maxLifeExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + chosen.Stat[ST_STRENGTH]*2 + "|" + COLOR_REGULAR + "  from Strength"
                        + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + chosen.Stat[ST_ENDURANCE]*3 + "|" + COLOR_REGULAR + "  from Endurance";
                        if (chosen.Param[TRAIT_BRUTISH_HULK] > 0) {
                            maxLifeExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +12|" + COLOR_REGULAR + "  from Brutish Hulk trait";
                        }
                        if (chosen.Perk[PE_LIFEGIVER] == 1) {
                            maxLifeExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + (chosen.Perk[PE_LIFEGIVER]*30) + "|" + COLOR_REGULAR + "  from Lifegiver perk";
                        } else if (chosen.Perk[PE_LIFEGIVER] > 1) {
                            maxLifeExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + (chosen.Perk[PE_LIFEGIVER]*30) + "|" + COLOR_REGULAR + "  from Lifegiver(" + chosen.Perk[PE_LIFEGIVER] + ") perks";
                        }
            maxLifeExt += "\n\u2022 Effects: " + (maxLifeDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + maxLifeDif + "|" + COLOR_GREEN + " ";
                        maxLifeExt += "\n\n";

            int healingRateBase = chosen.StatBase[ST_HEALING_RATE] + (2 + chosen.Stat[ST_ENDURANCE]) / 3;
            int healingRateDif = chosen.Stat[ST_HEALING_RATE] - healingRateBase;
            healingRateExt = "\nCurrent: " + "|" + COLOR_BUFF + " " +  CLAMP(chosen.Stat[ST_HEALING_RATE], 3, 10) + "% |" + COLOR_REGULAR + " max life every ";
                            if (chosen.Param[TRAIT_FAST_METABOLISM] > 0) {
                                if (chosen.Param[PE_WAY_OF_THE_FRUIT] > 0) {
                                    healingRateExt += "|" + COLOR_BUFF + " 10 seconds|" + COLOR_REGULAR + "  (if recently eaten fruit)";
                                } else {
                                    healingRateExt += "|" + COLOR_BUFF + " 20 seconds|" + COLOR_REGULAR + " ";
                                }
                            } else {
                                if (chosen.Param[PE_WAY_OF_THE_FRUIT] > 0) {
                                    healingRateExt += "|" + COLOR_BUFF + " 20 seconds |" + COLOR_REGULAR + " (if recently eaten fruit)";
                                } else {
                                    healingRateExt += "|" + COLOR_BUFF + " 40 seconds |" + COLOR_REGULAR + " ";
                                }
                            }
            healingRateExt += "\n\u2022 Base: " + "|" + COLOR_BUFF + " " + healingRateBase + "% |" + COLOR_REGULAR + " max life every |" + COLOR_BUFF + " 40 seconds|" + COLOR_REGULAR + " "
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + 1 + "% |" + COLOR_REGULAR + "  from Base"
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + ((chosen.Stat[ST_ENDURANCE] - 1) / 3) + "% |" + COLOR_REGULAR + "  from Endurance";
                            if (chosen.Param[PE_FASTER_HEALING] > 0) {
                                healingRateExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + ((chosen.Stat[ST_ENDURANCE] - 1) / 3) + "% |" + COLOR_REGULAR + "  from Faster Healing";
                            }
            healingRateExt += "\n\u2022 Effects: " + (healingRateDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + healingRateDif + "% |" + COLOR_REGULAR + " ";
                            if (radiationLevel > 0) {
                                int statLoss = GetStatLossForRadiationLevel(RADIATION_HR_INDEX, radiationLevel);
                                healingRateExt += "\n\t\u2022 " + (statLoss > 0 ? ("|" + COLOR_DEBUFF + " -" + statLoss + "%"):("|" + COLOR_BUFF + " " + statLoss + "%")) + "|" + COLOR_REGULAR + "  from radiation";
                            }
                            if (chosen.Stat[ST_HEALING_RATE] > 10) {
                                healingRateExt += "\n\t\u2022 reached maximum cap" + "|" + COLOR_DEBUFF + "  10%|" + COLOR_REGULAR + "  of max life";
                            }
                            if (chosen.Stat[ST_HEALING_RATE] < 3) {
                                healingRateExt += "\n\t\u2022 reached minimum cap" + "|" + COLOR_BUFF + "  3%|" + COLOR_REGULAR + "  of max life";
                            }
                            if (chosen.Param[TRAIT_FAST_METABOLISM] > 0) {
                                healingRateExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " -20 seconds|" + COLOR_REGULAR + "  because of Fast Metabolism";
                            }
                            if (chosen.Param[PE_WAY_OF_THE_FRUIT] > 0) {
                                if (chosen.Param[TRAIT_FAST_METABOLISM] > 0) {
                                    healingRateExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " -10 seconds|" + COLOR_REGULAR + "  because of Way of the Fruit (if recently eaten fruit)";
                                } else {
                                    healingRateExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " -20 seconds|" + COLOR_REGULAR + "  because of Way of the Fruit (if recently eaten fruit)";
                                }
                            }
                            healingRateExt += "\n\n";

            radiatedExt = "\n\t\u2022 Stage: |" + GetRadiationLevelColor(radiationLevel) + " " + GetRadiationStage(radiationLevel) + "|" + COLOR_REGULAR + " "
                            + "\n\t\u2022 Level: |" + GetRadiationLevelColor(radiationLevel) + " " + radiationLevel + " Rem." + "|" + COLOR_REGULAR + " "
                            + "\n\t\u2022 Effects: |" + COLOR_REGULAR + " " + (GetRadiationStage(radiationLevel) > 0 ? GetMsgStr(TEXTMSG_GAME, 12799 + GetRadiationStage(radiationLevel)) : "None.") + "|" + COLOR_REGULAR + " \n\n";

            poisonedExt = "\n\t\u2022 Poisoning level: |" + PercentColor(poisoningLevel) + " " + poisoningLevel + "|" + COLOR_REGULAR + " "
                            + "\n\t\u2022 Effects: |" + COLOR_REGULAR + " " + (poisoningLevel > 0 ? GetMsgStr(TEXTMSG_GAME, STR_POISON_PROCESS) : "None.") + "|" + COLOR_REGULAR + " \n\n";
            carryWeightExt = "\nCurrent:"
                           + "\n\u2022 Base: " + (carryWeightBase / 1000) + " kg"
                           + "\n\u2022 Effects: " + (carryWeightDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + (carryWeightDif/1000) + " kg" + "|" + COLOR_GREEN + " ";
                           carryWeightExt += "\n\n";

            int radiationResistDif = chosen.Stat[ST_RADIATION_RESISTANCE] - chosen.StatBase[ST_RADIATION_RESISTANCE] - chosen.Stat[ST_ENDURANCE]*2;
            radiationResistExt = "\nCurrent: " + "|" + COLOR_BUFF + " " +  chosen.Stat[ST_RADIATION_RESISTANCE] + "|" + COLOR_GREEN + " "
                            + "\n\u2022 Base: " + "|" + COLOR_BUFF + " " + (chosen.StatBase[ST_RADIATION_RESISTANCE] + chosen.Stat[ST_ENDURANCE]*2) + "|" + COLOR_GREEN + " "
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + chosen.Stat[ST_ENDURANCE]*2 + "|" + COLOR_REGULAR + "  from Endurance";
                            if (chosen.Perk[PE_SNAKEATER] > 0) {
                                radiationResistExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +5" + "|" + COLOR_REGULAR + "  from Snakeater perk";
                            }
                            if (chosen.Perk[PE_RAD_RESISTANCE] > 0) {
                                radiationResistExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +10" + "|" + COLOR_REGULAR + "  from Rad Resistance perk";
                            }
            radiationResistExt += "\n\u2022 Effects: " + (radiationResistDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + radiationResistDif + "|" + COLOR_GREEN + " ";
                            if (armorRadResist != 0) {
                                radiationResistExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + armorRadResist + "|" + COLOR_REGULAR + "  from Armor";
                            }
                            if (chosen.Timeout[TO_RAD_X] > 0) {
                                radiationResistExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +25" + "|" + COLOR_REGULAR + "  from Rad-X";
                            }
                            radiationResistExt += "\n\n";

            int posionResistDif = chosen.Stat[ST_POISON_RESISTANCE] - chosen.StatBase[ST_POISON_RESISTANCE] - chosen.Stat[ST_ENDURANCE]*3;
            poisonResistExt = "\nCurrent: " + "|" + COLOR_BUFF + " " +  chosen.Stat[ST_POISON_RESISTANCE] + "|" + COLOR_GREEN + " "
                            + "\n\u2022 Base: " + "|" + COLOR_BUFF + " " + (chosen.StatBase[ST_POISON_RESISTANCE] + chosen.Stat[ST_ENDURANCE]*3) + "|" + COLOR_GREEN + " "
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + chosen.Stat[ST_ENDURANCE]*3 + "|" + COLOR_REGULAR + "  from Endurance";
                            if (chosen.Perk[PE_SNAKEATER] > 0) {
                                poisonResistExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +10" + "|" + COLOR_REGULAR + "  from Snakeater perk";
                            }
                            if (chosen.Perk[PE_RAD_RESISTANCE] > 0) {
                                poisonResistExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +5" + "|" + COLOR_REGULAR + "  from Rad Resistance perk";
                            }
            poisonResistExt += "\n\u2022 Effects: " + (posionResistDif < 0 ? ("|" + COLOR_DEBUFF + " ") : ("|" + COLOR_BUFF + " +")) + posionResistDif + "|" + COLOR_GREEN + " ";
                            poisonResistExt += "\n\n";

            // stonewall body resists
            int stonewallResistKnockdown = 25 + ((CLAMP(chosen.Stat[ST_STRENGTH], 1, 5 + chosen.Stat[ST_CHARISMA])) * 5) + 20 * stonewallRank;
            int stonewallDowngradeKnockout = 10 + ((CLAMP(chosen.Stat[ST_INTELLECT], 1, 5 + chosen.Stat[ST_CHARISMA])) * 3) + 10 * stonewallRank;
            int stonewallFlamerResist0 = 100 - CLAMP(25 / (stonewallRank + 1) / thermalLeatherArmorFlamerResist, 0, 50);
            int stonewallFlamerResist100 = 100 - CLAMP(125 / (stonewallRank + 1) / thermalLeatherArmorFlamerResist, 0, 50);
            int stonewallIncineratorResist0 = 100 - CLAMP(50 / (stonewallRank + 1) / thermalLeatherArmorFlamerResist, 0, 75);
            int stonewallIncineratorResist100 = 100 - CLAMP(150 / (stonewallRank + 1) / thermalLeatherArmorFlamerResist, 0, 75);
            int knockbackWeaponPerkResist = CLAMP(100 - (15 + 10 * 5 - chosen.Param[ST_STRENGTH] * 3 - stonewallRank * 15), 0, 100);
            int heavyHandedResist = 100 - (50 + (10*5 - chosen.Stat[ST_STRENGTH]*3) + 0 - 30 * stonewallRank);
            int resistShotgunRounds = 15 + (5 * chosen.Stat[ST_STRENGTH]) + 15 * stonewallRank;
            int spearThrowResist = 100 - 100 / (1+ stonewallRank);
            //  stonewall head resist
            int resistFactorHead = 5 + chosen.Stat[ST_LUCK] + (chosen.Param[PE_MAN_OF_STEEL] > 0 ? 5 : 0) + 15 * stonewallRankHead;

            stonewallExt = ""
                            + "\n\n\u2022 Stonewall resists values for: |" + COLOR_BUFF +" Body|" + COLOR_REGULAR + " "
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + CLAMP(stonewallResistKnockdown, 0, 95) + "%|" + COLOR_REGULAR + "  resist most Knockdowns (Explosion/Critical)" + (stonewallResistKnockdown > 95 ? " (reached cap of 95%)" : "")
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + 25 + "%|" + COLOR_REGULAR + "  from Wastelander's Resilience"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (CLAMP(chosen.Stat[ST_STRENGTH], 1, 5 + chosen.Stat[ST_CHARISMA]) * 5) + "%|" + COLOR_REGULAR + "  from Strength" + (chosen.Stat[ST_STRENGTH] > 5 + chosen.Stat[ST_CHARISMA] ? (" (capped by Charisma to " + (CLAMP(chosen.Stat[ST_STRENGTH], 1, 5 + chosen.Stat[ST_CHARISMA])) + " ST)") : "")
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (20 * stonewallRank) + "%|" + COLOR_REGULAR + "  from Stonewall" + (stonewallRank > 1 ? "(2)" : "")
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + stonewallDowngradeKnockout + "%|" + COLOR_REGULAR + "  downgrade Knockout to Knockdown"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + 10 + "%|" + COLOR_REGULAR + "  from Wastelander's Resilience"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + ((CLAMP(chosen.Stat[ST_INTELLECT], 1, 5 + chosen.Stat[ST_CHARISMA])) * 3) + "%|" + COLOR_REGULAR + "  from Intellect" + (chosen.Stat[ST_INTELLECT] > 5 + chosen.Stat[ST_CHARISMA] ? " (capped by Charisma to " + (CLAMP(chosen.Stat[ST_INTELLECT], 1, 5 + chosen.Stat[ST_CHARISMA])) + " IN)" : "")
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (10 * stonewallRank) + "%|" + COLOR_REGULAR + "  from Stonewall" + (stonewallRank > 1 ? "(2)" : "")
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + stonewallFlamerResist0 + "%-" + stonewallFlamerResist100 + "%|" + COLOR_REGULAR + "  Flamer resist (0% - 100% fire vulnerability)"
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + stonewallIncineratorResist0 + "%-" + stonewallIncineratorResist100 + "%|" + COLOR_REGULAR + "  Incinerator resist (0% - 100% fire vulnerability)"
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + knockbackWeaponPerkResist + "%|" + COLOR_REGULAR + "  Weapon Perk: Knockback resist (vs 10 ST attacker)"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + "  " + 55 + "%|" + COLOR_REGULAR + "  base chance to resist Weapon Perk: Knockback"
                            + "\n\t\t\u2022 " + "|" + COLOR_DDGREEN + " -" + 50 + "%|" + COLOR_REGULAR + "  from attacker's Strength (10)"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + 30 + "%|" + COLOR_REGULAR + "  from Wastelander's Resilience"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (3 * chosen.Stat[ST_STRENGTH]) + "%|" + COLOR_REGULAR + "  from Strength"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (15 * stonewallRank) + "%|" + COLOR_REGULAR + "  from Stonewall" + (stonewallRank > 1 ? "(2)" : "")
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + heavyHandedResist + "%|" + COLOR_REGULAR + "  Heavy Handed resist (vs 10 ST attacker with Power Fist)"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + "  " + 10 + "%|" + COLOR_REGULAR + "  base chance to resist Heavy Handed"
                            + "\n\t\t\u2022 " + "|" + COLOR_DDGREEN + " -" + 50 + "%|" + COLOR_REGULAR + "  from attacker's Strength (10)"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + 40 + "%|" + COLOR_REGULAR + "  from Wastelander's Resilience"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (3 * chosen.Stat[ST_STRENGTH]) + "%|" + COLOR_REGULAR + "  from Strength"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (30 * stonewallRank) + "%|" + COLOR_REGULAR + "  from Stonewall" + (stonewallRank > 1 ? "(2)" : "")
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + resistShotgunRounds + "%|" + COLOR_REGULAR + "  Shotgun Knockback resist"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + 15 + "%|" + COLOR_REGULAR + "  from Wastelander's Resilience"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (5 * chosen.Stat[ST_STRENGTH]) + "%|" + COLOR_REGULAR + "  from Strength"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (15 * stonewallRank) + "%|" + COLOR_REGULAR + "  from Stonewall" + (stonewallRank > 1 ? "(2)" : "")
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + spearThrowResist + "%|" + COLOR_REGULAR + "  Spear Throw direct hit Knockback resist"
                            + "\n\n\u2022 Stonewall resists values for: |" + COLOR_BUFF +" Head|" + COLOR_REGULAR + " "
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + CLAMP(resistFactorHead, 0, 33) + "%|" + COLOR_REGULAR + "  resist Knockdowns from critical head shots" + (resistFactorHead > 33 ? " (reached cap of 33%)" : "")
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + 5 + "%|" + COLOR_REGULAR + "  from Wastelander's Resilience"
                            + "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + chosen.Stat[ST_LUCK] + "%|" + COLOR_REGULAR + "  from Luck";
                            if (chosen.Param[PE_MAN_OF_STEEL] > 0) {
                                stonewallExt += "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + 5 + "%|" + COLOR_REGULAR + "  from Man of Steel perk";
                            }
                            stonewallExt += "\n\t\t\u2022 " + "|" + COLOR_LGREEN + " +" + (15*stonewallRankHead) + "%|" + COLOR_REGULAR + "  from Stonewall Head" + (stonewallRankHead > 1 ? "(2)" : "")

                            ;

            stonewallExt += "\n\n\u2022 Effects: "
                            + "\n\t\u2022 " + "|" + COLOR_BUFF + " +1|" + COLOR_REGULAR + "  Stonewall (both body and head) rank from Perk";
                            if (stonewallRank > 1) {
                                stonewallExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1|" + COLOR_REGULAR + "  Stonewall rank from Heavy Armor";
                            }
                            if (thermalLeatherArmorFlamerResist > 1) {
                                stonewallExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +" + thermalLeatherArmorFlamerResist + "|" + COLOR_REGULAR + "  Flame Attack Knockdown effect divider from Thermal Leather Armor";
                            }
                            if (stonewallRankHead > 1) {
                                stonewallExt += "\n\t\u2022 " + "|" + COLOR_BUFF + " +1|" + COLOR_REGULAR + "  Stonewall head rank from Heavy Helmet";
                            }
                            stonewallExt += "\n\n";


            strengthExt += "\n\n";
            perceptionExt += "\n\n";
            enduranceExt += "\n\n";
            charismaExt += "\n\n";
            intellectExt += "\n\n";
            agilityExt += "\n\n";
            luckExt += "\n\n";

            //Message("Character IS valid when init tooltip.");
        } else {
            //Message("Character NOT valid when init tooltip.");
        }
        //   special stats
        tooltipsKey.insertLast(ST_STRENGTH);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_STRENGTH)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_STRENGTH))
                                 + pipText + jjJournal
                                 + "\n\n\"There is a small mining town to north in the mountains, Broken Hills. I saw a huge super-mutant drinking at the local tap house who wanted to arm wrestle every newcomer, I bet he could lift a whole caravan cart with his right arm.\""
                                 + jjText + pipStatus + strengthExt);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Initial Hit Points: (55 + 2*ST + EN)"
                                 + "\n\u2022 Melee Damage: (ST - 5) with a minimum of 1."
                                 + "\n\u2022 Carry Weight: [(25 + (ST*25 ))/2.2] + 20"
                                 + "\n\u2022 Throwing Distance: 3*ST to reach weapon max. distance (+6 with Heave Ho!)"
                                 + "\n\u2022 Throwing Damage: min. ST/2, max. ST (more with Heave Ho!)"
                                 + "\n\u2022 To hit chance: if lower than weapon ST requirement then -20 To Hit for each missing ST"
                                 + "\n\u2022 Stonewall Knockdown/Knockout resist: 25 + 5*(CLAMP(ST, 1, CH+5) + 20*stonewallRank vs 1d100"
                                 + "\n\u2022 Iron Limbs Weapon Drop resist: (ST - 5) + 2*ironLimbsRank vs 1d10"
                                 + "\n\u2022 Heavy Handed Trait Knockdown chance: "
                                 + "\n\u2022 Electric Shock effect (cannot run) duration reduce: ");

        tooltipsKey.insertLast(ST_PERCEPTION);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_PERCEPTION)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_PERCEPTION))
                                 + pipText + jjJournal
                                 + "\n\n\"Just when I ran out of smokes, I found a tobacco plantation along the shore to the west. It even had a working press machine! So much about me being 'Jinxed' he-he, oh no.... a pack of floaters are swarming to the north, gotta leave quick, damn, where do these creatures even come from?\""
                                 + jjText + pipStatus + perceptionExt);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Sight range: Base(20) + 3*PE + Sharpshooter(6) + Binoculars(6)"
                                 + "\n\u2022 Ranged chance to hit bonus: 2*PE, (if weapon perk LongRange 4*PE, if Scope 5*PE)"
                                 + "\n\u2022 Sequence: 2*PE");
        tooltipsKey.insertLast(ST_ENDURANCE);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_ENDURANCE)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_ENDURANCE))
                                 + pipText + jjJournal
                                 + "\n\n\"Today I saw a skin-n-bones human like creature being eaten by dogs until another one scared the dogs off with a shotgun. After a short time he woke up and walked away like nothing happened. The radiation must have increased the natural regeneration of these creatures to a level where they simply cannot die. Some of them were even glowing! It was to the north-east at the huge metropolitan ruins, better avoid for now.\""
                                 + jjText + pipStatus + enduranceExt);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Hit Points: (Initial: 55 + 2*ST + EN) + (Per level: (30 + EN)/8)"
                                 + "\n\u2022 Iron Limbs weapon drop/cripple resist: (clamp(ST, 1, CH+4) + clamp(EN, 1, CH+6) )*3 + 15*stonewallRank vs 1d100"
                                 + "\n\u2022 Enhanced Knockout Weapon perk resist factor.");

        tooltipsKey.insertLast(ST_CHARISMA);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_CHARISMA)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_CHARISMA))
                                 + pipText + jjJournal
                                 + "\n\n\"A group of travelers were gossiping about a special lady in New Reno today. It seems that she is able to turn even the most unfriendly punks to do her bidding. I was wondering if it was her Magnetic Personality or something else, after all New Reno is also famous of addictive substances like Jet.\""
                                 + jjText + pipStatus + charismaExt);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Stonewall: ST clamped with CH+5(ex: 9 ST with 1 CH means 5 ST in calculations)"
                                 + "\n\u2022 Confident Shooter (old More Ranged Damage) Perk damage bonus (per bullet):"
                                 + "\n\t\u2022 1 + CLAMP(attacker.CH - (((target.CH + 1) * 2) / 3), 0, 4)"
                                 + "\n\t\u2022 ex: Att. CH6, Tar. CH5 bonus: 3"
                                 + "\n\t\u2022 ex: Att. CH9, Tar. CH7 bonus: 5 (max)"
                                 + "\n\t\u2022 ex: Att. CH5, Tar. CH1 bonus: 5 (max)"
                                 + "\n\t\u2022 ex: Att. CH2, bonus: 1 (better take Bonus Ranged Damage perk instead)"
                                 + "\n\u2022 Maximum Chance To Hit: 94 + (CH+1)/2");

        tooltipsKey.insertLast(ST_INTELLECT);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_INTELLECT)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_INTELLECT))
                                 + pipText + jjJournal
                                 + "\n\n\"There is a very old and knowledgeable woman in the Hub working in a bookshop at the market square between the caravan offices. She had some good advice on technical books, but they were out of the 3rd volume of Big Books of Science. If I were to return there I sure will check that bookstore out again.\""
                                 + jjText + pipStatus + intellectExt);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Effectiveness of combat skills: (in combat calculations)"
                                 + "\n\t\u2022 4% skill penalty for every point below 5 IN"
                                 + "\n\t\t(example: 100 SG skill with 1 IN becomes 84 SG skill)"
                                 + "\n\t\u2022 4% skill bonus for every point above 5 IN"
                                 + "\n\t\t(example: 100 SG skill with 10 IN becomes 120 SG skill)"
                                 + "\n\u2022 Critical hit chance bonus from To Hit overflow: clamp(toHitOverflow/10, 0, 5+IN)"
                                 + "\n\t\u2022 ex: IN: 5, Hit Roll: 45 vs Hit Chance: 210 -> (165 overflow) / 10 -> 16 -> 10% crit. chance bonus"
                                 + "\n\t\u2022 Note: Weaker version of this effect was present before, now it has higher cap with 5+IN"
                                 + "\n\u2022 Critical hit chance for Aimed attacks: AimLocationBonus * (60 + 4*IN) / 100"
                                 + "\n\u2022 Sniper crit. chance bonus: (5*IN - 2*LK) * sniperMargin/150 (max. 50)"
                                 + "\n\t\u2022 SniperMargin value is the hit overflow compared to the hit roll, max. 150"
                                 + "\n\u2022 Enhanced KO (head) resist factor for EN clamped with IN+4 (9EN and 2IN -> 6EN)"
                                 + "\n\u2022 KO duration reduction factor: up to 2/3 duration reduction with 10IN"
                                 + "\n\nWarning: Does no longer give extra skill points per level.");

        tooltipsKey.insertLast(ST_AGILITY);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_AGILITY)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_AGILITY))
                                 + pipText + jjJournal
                                 + "\n\n\"I saw some children yesterday playing around gecko traps in Klamath, far to the north-west, without triggering any them. Must be good to be young and agile.\""
                                 + jjText + pipStatus + agilityExt);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Armor Class: +3*AG (double with Livewire perk)"
                                 + "\n\u2022 Each Agility reduces cost of attack by 0.1 Action Points."
                                 + "\n\t\u2022 Note: this does not stack with Bonus Rate of Attack."
                                 + "\n\u2022 Action Points calculation changed:"
                                 + "\n\t\u2022 Final AG = 1     -> 9 base AP"
                                 + "\n\t\u2022 Final AG = 2-9 -> 10 base AP"
                                 + "\n\t\u2022 Final AG = 10   -> 11 base AP"
                                 + "\n\u2022 Damaged arms reduces AG:"
                                 + "\n\t\u2022 Only left or only right: -3 AG"
                                 + "\n\t\u2022 Both left and right: AG set to 1"
                                 + "\n\u2022 Equipped Armor's can change AG level:"
                                 + "\n\t\u2022 Light Armor: +1 AG bonus (Leather Armor types and also give Quick Pockets Perk)"
                                 + "\n\t\u2022 Medium Armor: -1 AG malus (Combat Armor types and also give Iron Limbs Perk)"
                                 + "\n\t\u2022 Heavy Armor: -3 AG malus (Metal Armor types and also give Stonewall Perk)");

        tooltipsKey.insertLast(ST_LUCK);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_LUCK)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_LUCK))
                                 + pipText + jjJournal
                                 + "\n\n\"Finally I found some kind of abandoned theme-park with a working Nuka-Cola machine to the north-east but I didn't have any full water bags left to feed the machine. I shall not forget to pick some mutated fruits for the flavor before I return with fresh water.\""
                                 + jjText + pipStatus + luckExt);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Critical Chance on all attacks: 1*LK as crit. chance"
                                 + "\n\u2022 Reduce chance to be critically hit: LK/2 as crit. chance reduce"
                                 + "\n\t\u2022 Reduce chance to be critically hit by Sniper Perk: LK*2 reduce"
                                 + "\n\u2022 Critical Failure magnitude roll: Roll - 5 * (LK-5) vs 1d100"
                                 + "\n\u2022 Critical Power roll factor as target: reduce power by 1*LK"
                                 + "\n\u2022 Chance to get poisoned or radiated by creature attacks like:"
                                 + "\n\t\u2022 Radscorpions, Floaters, Aliens or Centaurs: 1d10+1 vs LK"
                                 + "\n\u2022 Thief Perk steal timeout reduce: 1d50 vs LK"
                                 + "\n\u2022 Spearfishing rare catch factor: LK/2 (overwritten by Golden Locket = 5, Magic 8-ball = 10)"
                                 + "\n\u2022 Primitive Tool (not) break chance: 10 + 5*LK vs 1d100"
                                 + "\n\u2022 Car repair tool break chance: 1 vs 1d(Repair/10 + LK/2)");
        //  skills
        tooltipsKey.insertLast(SK_SMALL_GUNS);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_SMALL_GUNS)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_SMALL_GUNS))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat specialization skill, leveled by spending Skill Points."
                                 + "\n\t\u2022 Max: 200 (if this is tagged as your combat specialization then Max: 300)"
                                 + modifies
                                 + "\n\u2022 Base chance to hit with small guns."
                                 + "\n\nNotes:"
                                 + "\n\u2022 To know more about Chance To Hit, Damage, Critical or other effect calculations use a training dummy in a tent or base.");

        tooltipsKey.insertLast(SK_BIG_GUNS);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_BIG_GUNS)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_BIG_GUNS))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat specialization skill, leveled by spending Skill Points."
                                 + "\n\t\u2022 Max: 200 (if this is tagged as your combat specialization then Max: 300)"
                                 + modifies
                                 + "\n\u2022 Base chance to hit with big guns."
                                 + "\n\nNotes:"
                                 + "\n\u2022 Hex Shoot:"
