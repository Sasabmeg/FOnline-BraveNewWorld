        tooltipsKey.insertLast(PE_PROFESSION_DEMOLITION_EXPERT);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(PE_PROFESSION_DEMOLITION_EXPERT)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(PE_PROFESSION_DEMOLITION_EXPERT)) + pipText);
        tooltipsValueExt.insertLast(pipReference + noData);
    }
};

//  Exported - client_interface
void RefreshTooltips(bool forced) {
    //  forced refresh, in case of special ext change to reflect that on tooltips
    if (forced) {
        InitCharacterTooltip();
        LogToolTips("Tooltips refresh FORCED!");
        return;
    }
    if (tooltipRefreshDelay > 0 && tooltipRefreshDelay < GetTick()) {
        tooltipRefreshDelay = 0;
        InitCharacterTooltip();
        LogToolTips("Tooltips refreshed by delay!");
        return;
    }
    //  this ensures that tooltips are refreshed after character is loaded fully after it was unloaded or not initialized yet on client side
    CritterCl@ chosen = GetChosen();
    if (!valid(chosen)) {
        chosenIsInvalid = false;
    } else if (!chosenIsInvalid) {
        chosenIsInvalid = true;
        InitCharacterTooltip();
        LogToolTips("Tooltips refreshed!");
    }
}

//  Exported - client_interface
#define TOOLTIPS_REFRESH_DELAY      (1000)
void RefreshTooltipsDelayed(uint delayInMs) {
    if (tooltipRefreshDelay < GetTick()) {
        tooltipRefreshDelay = GetTick() + delayInMs;
        LogToolTips("Tooltips refresh DELAYED by: " + delayInMs);
        RefreshTooltips(true);
    } else {
        LogToolTips("Tooltips refresh already under DELAYED effect!");
    }
}

//  Exported - client_main
void InitCharacterTooltip() {
    tooltipKeyValue = CTooltips();
}

//  Exported - client_main
void InitInventoryTooltip() {
    tooltipKeyValue = CTooltips();
}

//  Exported - client_interface
void UpdateCharacterTooltip(int tooltipId, int posX, int posY) {
    if (valid(characterTooltip) && tooltipId < 0) {
        characterTooltip.enabled = false;
        return;
    }

    characterTooltip = CGuiTooltip(tooltipId);

    if (valid(characterTooltip)) {
        characterTooltip.enabled = false;
    }

    characterTooltip.posX = posX;
    characterTooltip.posY = posY;
    int x = posX;
    int y = posY;
    if (uint(tooltipId) >= SKILL_BEGIN && uint(tooltipId) < SKILL_BEGIN + SKILL_COUNT || GUI_GetActiveScreen() == CLIENT_SCREEN_PERK) {
        characterTooltip.interfaceWindow = CInterfaceWindow(x - 620 - 30, y, 620, 100);
    } else {
        characterTooltip.interfaceWindow = CInterfaceWindow(x + 20, y, 620, 100);
    }

    characterTooltip.interfaceWindow.maxWidth = __ScreenWidth * 4 / 5;
    characterTooltip.interfaceWindow.maxHeight = __ScreenHeight * 4 / 5;
    characterTooltip.interfaceWindow.backgroundColor = COLOR_RGBA(0, 0, 0, 230);

    characterTooltip.interfaceTextbox = CInterfaceTextbox(10, 10, 600, 800);
    characterTooltip.interfaceTextbox.Init();
    characterTooltip.interfaceTextbox.SetFont(FONT_TYPE_DEFAULT);
    characterTooltip.interfaceTextbox.textColor = COLOR_LGREEN;

    SetCharacterDetailText(tooltipKeyValue.getToolTip(tooltipId));

    characterTooltip.interfaceWindow.posY -= characterTooltip.interfaceWindow.totalHeight;
    characterTooltip.posY = characterTooltip.interfaceWindow.posY;

    characterTooltip.interfaceWindow.childControls.insertLast(characterTooltip.interfaceTextbox);
    characterTooltip.interfaceWindow.FitScreen();
    characterTooltip.enabled = true;
    //__HideCursor = true;
}

//  Exported - client_interface
void UpdateInventoryTooltip(ItemCl& item, int left, int right, int top, int bottom, bool preferLeft) {
    if (!valid(inventoryTooltip)) {
        lastInventoryItemId = 0;
        return;
    }
    if (!valid(item)) {
        lastInventoryItemId = 0;
        inventoryTooltip.enabled = false;
        return;
    }
    if (item.Id == lastInventoryItemId) {
        return;
    } else {
        lastInventoryItemId = item.Id;
    }


    inventoryTooltip = CGuiTooltip();

    if (valid(inventoryTooltip)) {
        inventoryTooltip.enabled = false;
    }

    //int x = __MouseX;
    //int y = __MouseY;
    int x = left;
    int y = top;
    inventoryTooltip.interfaceWindow = CInterfaceWindow(x + 20, y, 320, 100);

    inventoryTooltip.interfaceWindow.maxWidth = __ScreenWidth * 4 / 5;
    inventoryTooltip.interfaceWindow.maxHeight = __ScreenHeight * 4 / 5;
    inventoryTooltip.interfaceWindow.backgroundColor = COLOR_RGBA(0, 0, 0, 230);
    inventoryTooltip.interfaceTextbox = CInterfaceTextbox(10, 10, 300, 800);
    inventoryTooltip.interfaceTextbox.Init();
    inventoryTooltip.interfaceTextbox.textColor = COLOR_RGB(0, 0xD8, 0);
    inventoryTooltip.interfaceTextbox.SetFont(FONT_TYPE_DEFAULT);

    inventoryTooltip.interfaceTextboxComparison = CInterfaceTextbox(10, 10, 100, 200);
    inventoryTooltip.interfaceTextboxComparison.Init();
    inventoryTooltip.interfaceTextboxComparison.textColor = COLOR_RGB(0, 0xD8, 0);

    //Message("UpdateInventoryTooltip() :: " + (GetTick() / 1000) + "." + (GetTick() % 1000));
    SetInventoryDetailText(item);
    inventoryTooltip.interfaceWindow.childControls.insertLast(inventoryTooltip.interfaceTextbox);
    inventoryTooltip.interfaceWindow.childControls.insertLast(inventoryTooltip.interfaceTextboxComparison);

    inventoryTooltip.interfaceWindow.FitScreen(left, right, top, bottom, preferLeft);
    inventoryTooltip.enabled = true;
    //__HideCursor = true;
}


void SetCharacterDetailText(string& text) {
    int h = characterTooltip.interfaceTextbox.setText(text);
    characterTooltip.interfaceWindow.totalHeight = 20 + h;
    //characterTooltip.interfaceWindow.posY -= characterTooltip.interfaceWindow.totalHeight;
}

void SetInventoryDetailText(ItemCl& item) {
    CritterCl@ chosen = GetChosen();
    if (!valid(chosen)) {
        return;
    }

	string itemQualityPrefix = "";
	if (valid(item)) {
        if(item.GetType() == ITEM_TYPE_ARMOR || item.GetType()== ITEM_TYPE_WEAPON) {
            if(item.Val4!=0)	itemQualityPrefix +="|" + COLOR_SAND + " Unique " + "|" + COLOR_LGREEN + " ";
            else if(item.Val3!=0) itemQualityPrefix +="|" + COLOR_GREEN_RED + " Advanced " + "|" + COLOR_LGREEN + " ";
            else if(item.Val2!=0) itemQualityPrefix +="|" + COLOR_WHITE + " Superior " + "|" + COLOR_LGREEN + " ";
            else if(item.Val1!=0) itemQualityPrefix +="|" + COLOR_LGRAY + " Improved " + "|" + COLOR_LGREEN + " ";
            else if(item.Val0!=0) itemQualityPrefix +="|" + COLOR_GRAY + " Quality " + "|" + COLOR_LGREEN + " ";
        }
	}

	string textComparison = "";
    string text = "" + itemQualityPrefix;
    if (valid(item)) {
        text += GetMsgStr(TEXTMSG_ITEM, STR_ITEM_INFO(item)) + "\n\n";
        text += GetMsgStr(TEXTMSG_ITEM, STR_PROTO_INFO(item.Proto)+1) + "\n";
        int ammoCount = 0;
        int ammoWeight = 0;
        if (item.GetType() == ITEM_TYPE_WEAPON) {
            if (item.Proto.Weapon_Skill_0 >= 200 && item.Proto.Weapon_Skill_0 <= 218) {
                text += "\nSkill: " + GetMsgStr(TEXTMSG_GAME, STR_SKILL_NAME(item.Proto.Weapon_Skill_0));
                if (item.Proto.Weapon_ActiveUses > 1 && item.Proto.Weapon_Skill_0 != item.Proto.Weapon_Skill_1 && item.Proto.Weapon_Skill_1 >= 200 && item.Proto.Weapon_Skill_1 <= 218) {
                    text += " / " + GetMsgStr(TEXTMSG_GAME, STR_SKILL_NAME(item.Proto.Weapon_Skill_1));
                }
            }
            if (item.Proto.Weapon_MinStrength > 1) {
                text += "\nMinimum Strength: " + item.Proto.Weapon_MinStrength;
            }
            if (item.Proto.Weapon_MaxDist_0 > 0) {
                uint16	rounds = _WeaponRound(item.Proto, 0);
                bool 	isBurst = rounds > 1;
                if (isBurst) {
                    text += "\nBurst range: " + item.Proto.Weapon_MaxDist_0;
                } else {
                    text += "\nRange: " + item.Proto.Weapon_MaxDist_0;
                }
                if (item.Proto.Weapon_MaxDist_1 > 0) {
                    uint16	rounds = _WeaponRound(item.Proto, 1);
                    bool 	isBurst = rounds > 1;
                    if (isBurst) {
                        text += "\t(Burst range: " + item.Proto.Weapon_MaxDist_1 + ")";
                    } else if (item.Proto.Weapon_Anim2_1 == ANIM2_THROW) {
                        text += "\t(Throw range: " + item.Proto.Weapon_MaxDist_1 + ")";
                    }
                }
            }
            if (item.Proto.Weapon_DmgMin_0 > 0 && item.Proto.Weapon_DmgMax_0 > 0) {
                text += "\nBase damage: " + item.Proto.Weapon_DmgMin_0 + "-" + item.Proto.Weapon_DmgMax_0;
            }
            // Ammo load
            if(item.Proto.Weapon_MaxAmmoCount > 0) {
                text += "\n";
                string str = GetMsgStr(TEXTMSG_GAME, STR_INV_HAS_SHOTS);
                str = ReplaceText(str, "VALUE", item.AmmoCount);
                str = ReplaceText(str, "MAX_VALUE", item.Proto.Weapon_MaxAmmoCount);
                if (item.AmmoCount > 0) {
                    str = ReplaceText(str, "AMMO", GetMsgStr(TEXTMSG_ITEM, (item.AmmoPid*100)));
                } else {
                    str = ReplaceText(str, "AMMO", GetMsgStr(TEXTMSG_GAME, STR_CALIBER(item.Proto.Weapon_Caliber)));
                }
                text += str;
                if (item.AmmoCount > 0) {
                    ProtoItem@ ammo = GetProtoItem(item.AmmoPid);
                    if (valid(ammo)) {
                        ammoCount = item.AmmoCount;
                        ammoWeight = ammo.Weight;
                    }
                }
            }
            if (IsDetectHiddenWeapon(item)) {
                text += "\nReveal hidden once:";
                text += "\n\tReveal radius on lit: " + FLARELIT_REVEAL_RADIUS;
                text += "\n\tReveal radius on thrown hex: " + FLARELIT_REVEAL_RADIUS;
                text += "\nReveal hidden per pulse:";
                text += "\n\tMust be in any hands or on the ground.";
                text += "\n\tReveal radius per pulse: " + FLAREGROUND_REVEAL_RADIUS;
                text += "\n\tPulse frequency: " + FLARE_PULSE_FREQ_MIN + "-" + FLARE_PULSE_FREQ_MAX + " seconds.";
                text += "\n\tPulse count: " + FLARE_PULSE_COUNT;
                text += "\n\tLifetime after lit: " + (FLARE_PULSE_FREQ_MIN * FLARE_PULSE_COUNT / 60) + "-" + (FLARE_PULSE_FREQ_MAX * FLARE_PULSE_COUNT / 60) + " minutes.";
            }
            if (item.Proto.Weapon_Perk != 0) {
                string str = GetMsgStr(TEXTMSG_GAME, STR_WEAPON_PERK(item.Proto.Weapon_Perk));
                text += "\nPerk: " + str + ".";
            }
            text += "\nWeapon size category: " + getWeaponSizeRankDescription(getWeaponSizeRank(item.Proto)) + "\n";
        } else if (item.GetType() == ITEM_TYPE_ARMOR) {
            string radResistStr = "";
            string perkStr = "";
            ItemCl@ equippedArmor;
            int armorNormalDTDiff = item.Proto.Armor_DTNormal, armorNormalDRDiff = item.Proto.Armor_DRNormal;
            int armorLaserDTDiff = item.Proto.Armor_DTLaser, armorLaserDRDiff = item.Proto.Armor_DRLaser;
            int armorFireDTDiff = item.Proto.Armor_DTFire, armorFireDRDiff = item.Proto.Armor_DRFire;
            int armorPlasmaDTDiff = item.Proto.Armor_DTPlasma, armorPlasmaDRDiff = item.Proto.Armor_DRPlasma;
            int armorElectrDTDiff = item.Proto.Armor_DTElectr, armorElectrDRDiff = item.Proto.Armor_DRElectr;
            int armorExplodeDTDiff = item.Proto.Armor_DTExplode, armorExplodeDRDiff = item.Proto.Armor_DRExplode;
            if (item.Proto.Slot == SLOT_ARMOR) {
                @equippedArmor = chosen.GetItem(0, SLOT_ARMOR);
            } else if (item.Proto.Slot == SLOT_HEAD) {
                @equippedArmor = chosen.GetItem(0, SLOT_HEAD);
            }
            if (valid(equippedArmor)) {
                armorNormalDTDiff  -= equippedArmor.Proto.Armor_DTNormal;
                armorNormalDRDiff  -= equippedArmor.Proto.Armor_DRNormal;
                armorLaserDTDiff   -= equippedArmor.Proto.Armor_DTLaser;
                armorLaserDRDiff   -= equippedArmor.Proto.Armor_DRLaser;
                armorFireDTDiff    -= equippedArmor.Proto.Armor_DTFire;
                armorFireDRDiff    -= equippedArmor.Proto.Armor_DRFire;
                armorPlasmaDTDiff  -= equippedArmor.Proto.Armor_DTPlasma;
                armorPlasmaDRDiff  -= equippedArmor.Proto.Armor_DRPlasma;
                armorElectrDTDiff  -= equippedArmor.Proto.Armor_DTElectr;
                armorElectrDRDiff  -= equippedArmor.Proto.Armor_DRElectr;
                armorExplodeDTDiff -= equippedArmor.Proto.Armor_DTExplode;
                armorExplodeDRDiff -= equippedArmor.Proto.Armor_DRExplode;
            }
            if (item.Proto.Armor_Perk != 0) {
                if (item.Proto.Slot == SLOT_ARMOR) {
                    switch (item.Proto.Armor_Perk) {
                        case ARMOR_PERK_POWERED: radResistStr += "+35"; perkStr = "\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall.\nPerk: Adv. Powered. (+3 ST)"; break;
                        case ARMOR_PERK_ADVANCED_I:
                        case ARMOR_PERK_ADVANCED_II: radResistStr += "+40"; perkStr = "\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall.\nPerk: Adv. Powered. (+4 ST)"; break;
                        case ARMOR_PERK_LEATHER_JACKET: radResistStr += "+5"; perkStr = "\nLight: +1 AG \nPerk: Quick Pockets.\nPerk: Swagger. (+1 CH)"; break;
                        case ARMOR_PERK_LEATHER_ARMOR: radResistStr += "+10"; perkStr = "\nLight: +1 AG \nPerk: Quick Pockets."; break;
                        case ARMOR_PERK_THERMAL_LEATHER: radResistStr += "+35"; perkStr = "\nPerk: Flame Resistant. (Higher Flamer KD resist)"; break;
                        case ARMOR_PERK_COMBAT: radResistStr += "+25"; perkStr = "\nMedium: -1 AG (also AG cap 9)\nPerk: Iron Limbs."; break;
                        case ARMOR_PERK_METAL: radResistStr += "+15"; perkStr = "\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall."; break;
                        case ARMOR_PERK_TESLA: radResistStr += "+35"; perkStr = "\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall."; break;
                        case ARMOR_PERK_CAMOUFLAGE_HP: radResistStr += "+10"; perkStr = "\nPerk: Camouflage. (Hide HP and Helm)"; break;
                    }
                } else if (item.Proto.Slot == SLOT_HEAD) {
                    switch (item.Proto.Armor_Perk) {
                        case HELMET_PERK_CHARISMA: perkStr = "\nPerk: Stylish. (+1 CH)"; break;
                        case HELMET_PERK_PERCEPTION_GLASSES: perkStr = "\nPerk: Sight Correction. (PE set to 4 if lower)"; break;
                        case HELMET_PERK_PROTECT_EYES: perkStr = "\nPerk: Protect Eyes. (Aim location Eyes changed to Head)"; break;
                        case HELMET_PERK_BONUS_PERCEPTION: perkStr = "\nPerk: Clear Vision. (+1 PE)"; break;
                        case HELMET_PERK_MALUS_PERCEPTION: perkStr = "\nPerk: Impaired Vision. (-1 PE)"; break;
                        case HELMET_PERK_CAMOUFLAGE_NAME: perkStr = "\nPerk: Camouflage. (Hide Name)"; break;
                        case HELMET_PERK_METAL_MASK: perkStr = "\nPerk: Camouflage. (Hide Name)\nPerk: Impaired Vision. (-1 PE)"; break;
                        case HELMET_PERK_METAL_MASK_2: perkStr = "\nPerk: Camouflage. (Hide Name)\nPerk: Impaired Vision. (-2 PE)"; break;
                    }
                }
            }

            text += "\nArmor Class: " + item.Proto.Armor_AC;
            text += "\nDamage resistances: (DT/DR)";
            if (item.GetProtoId() == PID_FRONT_PLATED_METAL_ARMOR || item.GetProtoId() == PID_FRONT_PLATED_METAL_HELMET) {
                text += "\nFront:";
            }

            int w = 0, h = 0, l = 0;
            GetTextInfo(text, 300, 800, FONT_TYPE_DEFAULT, FONT_FLAG_BORDERED, w, h, l);
            inventoryTooltip.interfaceTextboxComparison.SetPosY(h + 10);
            string widthText;
            text += widthText = "\n\tNormal: \u00A0\u00A0\u00A0" + item.Proto.Armor_DTNormal + "/" + item.Proto.Armor_DRNormal;
            GetTextInfo(widthText, 300, 800, FONT_TYPE_DEFAULT, FONT_FLAG_BORDERED, w, h, l);
            inventoryTooltip.interfaceTextboxComparison.SetPosX(w);

            if (valid(equippedArmor) && item.Id != equippedArmor.Id) {
                int comparisonColorDT = armorNormalDTDiff < 0 ? COLOR_DORANGE : (armorNormalDTDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                int comparisonColorDR = armorNormalDRDiff < 0 ? COLOR_DORANGE : (armorNormalDRDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                string comparisonValueDT =  armorNormalDTDiff < 0 ? ("" + armorNormalDTDiff) : ("+" + armorNormalDTDiff);
                string comparisonValueDR =  armorNormalDRDiff < 0 ? ("" + armorNormalDRDiff) : ("+" + armorNormalDRDiff);
                if (armorNormalDTDiff != 0 || armorNormalDRDiff != 0) {
                    textComparison += "    \t|" + comparisonColorDT + " " + comparisonValueDT + "|" + COLOR_DGREEN + " /|" + comparisonColorDR + " " + comparisonValueDR + "\n";
                } else {
                    textComparison += "\n";
                }
            }
            text += "\n\tLaser:     \u00A0" + item.Proto.Armor_DTLaser + "/" + item.Proto.Armor_DRLaser;
            if (valid(equippedArmor) && item.Id != equippedArmor.Id) {
                int comparisonColorDT = armorLaserDTDiff < 0 ? COLOR_DORANGE : (armorLaserDTDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                int comparisonColorDR = armorLaserDRDiff < 0 ? COLOR_DORANGE : (armorLaserDRDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                string comparisonValueDT =  armorLaserDTDiff < 0 ? ("" + armorLaserDTDiff) : ("+" + armorLaserDTDiff);
                string comparisonValueDR =  armorLaserDRDiff < 0 ? ("" + armorLaserDRDiff) : ("+" + armorLaserDRDiff);
                if (armorLaserDTDiff != 0 || armorLaserDRDiff != 0) {
                    textComparison += "    \t|" + comparisonColorDT + " " + comparisonValueDT + "|" + COLOR_DGREEN + " /|" + comparisonColorDR + " " + comparisonValueDR + "\n";
                } else {
                    textComparison += "\n";
                }
            }
            text += "\n\tFire:         " + item.Proto.Armor_DTFire + "/" + item.Proto.Armor_DRFire;
            if (valid(equippedArmor) && item.Id != equippedArmor.Id) {
                int comparisonColorDT = armorFireDTDiff < 0 ? COLOR_DORANGE : (armorFireDTDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                int comparisonColorDR = armorFireDRDiff < 0 ? COLOR_DORANGE : (armorFireDRDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                string comparisonValueDT =  armorFireDTDiff < 0 ? ("" + armorFireDTDiff) : ("+" + armorFireDTDiff);
                string comparisonValueDR =  armorFireDRDiff < 0 ? ("" + armorFireDRDiff) : ("+" + armorFireDRDiff);
                if (armorFireDTDiff != 0 || armorFireDRDiff != 0) {
                    textComparison += "    \t|" + comparisonColorDT + " " + comparisonValueDT + "|" + COLOR_DGREEN + " /|" + comparisonColorDR + " " + comparisonValueDR + "\n";
                } else {
                    textComparison += "\n";
                }
            }
            text += "\n\tPlasma:  \u00A0\u00A0" + item.Proto.Armor_DTPlasma + "/" + item.Proto.Armor_DRPlasma;
            if (valid(equippedArmor) && item.Id != equippedArmor.Id) {
                int comparisonColorDT = armorPlasmaDTDiff < 0 ? COLOR_DORANGE : (armorPlasmaDTDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                int comparisonColorDR = armorPlasmaDRDiff < 0 ? COLOR_DORANGE : (armorPlasmaDRDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                string comparisonValueDT =  armorPlasmaDTDiff < 0 ? ("" + armorPlasmaDTDiff) : ("+" + armorPlasmaDTDiff);
                string comparisonValueDR =  armorPlasmaDRDiff < 0 ? ("" + armorPlasmaDRDiff) : ("+" + armorPlasmaDRDiff);
                if (armorPlasmaDTDiff != 0 || armorPlasmaDRDiff != 0) {
                    textComparison += "    \t|" + comparisonColorDT + " " + comparisonValueDT + "|" + COLOR_DGREEN + " /|" + comparisonColorDR + " " + comparisonValueDR + "\n";
                } else {
                    textComparison += "\n";
                }
            }
            text += "\n\tElectric:  \u00A0" + item.Proto.Armor_DTElectr + "/" + item.Proto.Armor_DRElectr;
            if (valid(equippedArmor) && item.Id != equippedArmor.Id) {
                int comparisonColorDT = armorElectrDTDiff < 0 ? COLOR_DORANGE : (armorElectrDTDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                int comparisonColorDR = armorElectrDRDiff < 0 ? COLOR_DORANGE : (armorElectrDRDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                string comparisonValueDT =  armorElectrDTDiff < 0 ? ("" + armorElectrDTDiff) : ("+" + armorElectrDTDiff);
                string comparisonValueDR =  armorElectrDRDiff < 0 ? ("" + armorElectrDRDiff) : ("+" + armorElectrDRDiff);
                if (armorElectrDTDiff != 0 || armorElectrDRDiff != 0) {
                    textComparison += "    \t|" + comparisonColorDT + " " + comparisonValueDT + "|" + COLOR_DGREEN + " /|" + comparisonColorDR + " " + comparisonValueDR + "\n";
                } else {
                    textComparison += "\n";
                }
            }
            text += "\n\tExplode:  \u00A0" + item.Proto.Armor_DTExplode + "/" + item.Proto.Armor_DRExplode;
            if (valid(equippedArmor) && item.Id != equippedArmor.Id) {
                int comparisonColorDT = armorExplodeDTDiff < 0 ? COLOR_DORANGE : (armorExplodeDTDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                int comparisonColorDR = armorExplodeDRDiff < 0 ? COLOR_DORANGE : (armorExplodeDRDiff > 0 ? COLOR_GOLDEN_YELLOW : COLOR_GREEN);
                string comparisonValueDT =  armorExplodeDTDiff < 0 ? ("" + armorExplodeDTDiff) : ("+" + armorExplodeDTDiff);
                string comparisonValueDR =  armorExplodeDRDiff < 0 ? ("" + armorExplodeDRDiff) : ("+" + armorExplodeDRDiff);
                if (armorExplodeDTDiff != 0 || armorExplodeDRDiff != 0) {
                    textComparison += "    \t|" + comparisonColorDT + " " + comparisonValueDT + "|" + COLOR_DGREEN + " /|" + comparisonColorDR + " " + comparisonValueDR + "\n";
                } else {
                    textComparison += "\n";
                }
            }

            inventoryTooltip.interfaceTextboxComparison.setText(textComparison);

            if (radResistStr.length() > 0) {
                text += "\n\tRadiation Resist: " + radResistStr;
            }
            text += "\n\tCrit chance mod: " + (item.Proto.Armor_CMCritChance);
            text += "\n\tCrit power mod: " + (item.Proto.Armor_CMCritPower);
            if (item.GetProtoId() == PID_FRONT_PLATED_METAL_ARMOR || item.GetProtoId() == PID_FRONT_PLATED_METAL_HELMET) {
                text += "\nBack:";
                text += "\n\tNormal: \u00A0\u00A0\u00A0" + (item.Proto.Armor_DTNormal - 3) + "/" + (item.Proto.Armor_DRNormal - 10);
                text += "\n\tLaser:     \u00A0" + (item.Proto.Armor_DTLaser - 3) + "/" + (item.Proto.Armor_DRLaser - 10);
                text += "\n\tFire:         " + (item.Proto.Armor_DTFire - 3) + "/" + (item.Proto.Armor_DRFire - 10);
                text += "\n\tPlasma:  \u00A0\u00A0" + (item.Proto.Armor_DTPlasma - 3) + "/" + (item.Proto.Armor_DRPlasma - 10);
                text += "\n\tElectric:  \u00A0" + (item.Proto.Armor_DTElectr - 3) + "/" + (item.Proto.Armor_DRElectr - 10);
                text += "\n\tExplode:  \u00A0" + (item.Proto.Armor_DTExplode - 3) + "/" + (item.Proto.Armor_DRExplode - 10);
                text += "\n\tCrit chance mod: " + (item.Proto.Armor_CMCritChance + 10);
                text += "\n\tCrit power mod: " + (item.Proto.Armor_CMCritPower + 10);
            }

            text += "\n";
            if (item.GetProtoId() == PID_TESLA_ARMOR) {
                text += "\nCharges: "+item.Charge+"/"+item.Proto.Misc_ChargeMax;
            }
            if (perkStr.length() > 0) {
                text += perkStr;
            }
        } else if (item.GetType() == ITEM_TYPE_AMMO) {
            text += "\nDM mod: " + (item.Proto.Ammo_DmgMult) + "/" + (item.Proto.Ammo_DmgDiv);
            text += "\nDR mod: " + (item.Proto.Ammo_DrMod) + "%";
            text += "\nAC mod: " + (item.Proto.Ammo_AcMod);
            if (COMBAT_AMMO_AP(item.Proto)) {
                text += "\nArmor Piercing";
            }
        } else if (item.GetType() == ITEM_TYPE_MISC) {
            if (item.GetProtoId() == PID_BEAR_TRAP_SPRUNG) {
                text += "\nTrap features:";
                text += "\n\t\u2022 Trappers can see it easier.";
                text += "\n\t\u2022 Light step will not trigger own traps.";
                text += "\n\t\u2022 Chance to cripple limbs.";
                text += "\n\t\u2022 Increased damage against animals or beasts.";
                text += "\n\t\u2022 Increased damage per crippled limb.";
                text += "\nTrap base damage: 5 - 15";
                text += "\nTrap damage bonus: " + item.Val4 + "\n";
            }
            if (item.Proto.Misc_ToolSkillNum != 0) {
                string str = GetMsgStr(TEXTMSG_GAME, STR_SKILL_NAME(item.Proto.Misc_ToolSkillNum));
                text += "\n" + str + " bonus: " + item.Proto.Misc_ToolSkillBonus + ".";
            }
            if (item.Proto.Misc_ChargeMax > 0) {
                text += "\nCharges: "+item.Charge+"/"+item.Proto.Misc_ChargeMax;
            }
        } else if (item.GetType() == ITEM_TYPE_KEY) {
            // Key id
            text += "\n" + ReplaceText(GetMsgStr(TEXTMSG_GAME, STR_INV_KEY_NUMBER), "KEY_ID", item.LockerId);
        } else if (item.GetType() == ITEM_TYPE_DRUG) {
            text += "\nEffects:";
            switch (item.GetProtoId()) {
                //  combat drugs
                case PID_PSYCHO:
                    text += "\n\t\u2022 First phase:";
                    text += "\n\t\t\u2022 Reduced damage by 50%.";
                    text += "\n\t\t\u2022 Rage limits vision of friend/hostile status.";
                    if (chosen.Trait[TRAIT_CHEM_RELIANT] > 0) {
                        text += "\n\t\t\u2022 Duration: 20 sec (Chem Reliant)";
                    } else {
                        text += "\n\t\t\u2022 Duration: 30 sec";
                    }
                    text += "\n\t\u2022 Second phase:";
                    text += "\n\t\t\u2022 Damage reduced from first phase applied over time as hemorrhage.";
                    if (chosen.Trait[TRAIT_CHEM_RELIANT] > 0) {
                        text += "\n\t\t\u2022 Duration: 40 sec (Chem Reliant)";
                    } else {
                        text += "\n\t\t\u2022 Duration: 1.5 min";
                    }
                    break;
                case PID_JET:
                    text += "\n\t\u2022 Action Points: +2";
                    text += "\n\t\u2022 Strength: -2";
                    text += "\n\t\u2022 Intellect: -1";
                    text += "\n\t\u2022 Normal DR: -15%";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                //  usual buffs
                case PID_BUFFOUT:
                    text += "\n\t\u2022 Strength: +1";
                    text += "\n\t\u2022 Endurance: +1";
                    text += "\n\t\u2022 Intellect: -1";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_MENTATS:
                    text += "\n\t\u2022 Intellect: +1";
                    text += "\n\t\u2022 Charisma: +1";
                    text += "\n\t\u2022 Strength: -1";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_RAD_X:
                    text += "\n\t\u2022 Radiation resistance: +25";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                //  alcohol and cigarettes
                case PID_BEER:
                    text += "\n\t\u2022 Normal DR: +4%";
                    text += "\n\t\u2022 Strength: +1";
                    text += "\n\t\u2022 Perception: -1";
                    text += "\n\t\u2022 Range penalty: -50 combat skill";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_BOOZE:
                    text += "\n\t\u2022 Normal DR: +3%";
                    text += "\n\t\u2022 Charisma: +1";
                    text += "\n\t\u2022 Perception: -1";
                    text += "\n\t\u2022 Range penalty: -50 combat skill";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_GAMMA_GULP_BEER:
                    text += "\n\t\u2022 Normal DR: +3%";
                    text += "\n\t\u2022 Radiation Resist.: +10";
                    text += "\n\t\u2022 Perception: -1";
                    text += "\n\t\u2022 Radiation level: +10 Rem";
                    text += "\n\t\u2022 Range penalty: -50 combat skill";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_ROENTGEN_RUM:
                    text += "\n\t\u2022 Normal DT: +3";
                    text += "\n\t\u2022 Perception: -1";
                    text += "\n\t\u2022 Radiation level: +10 Rem";
                    text += "\n\t\u2022 Range penalty: -50 combat skill";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_ROT_GUT:
                    text += "\n\t\u2022 Normal DR: +3%";
                    text += "\n\t\u2022 Perception: -1";
                    text += "\n\t\u2022 Fire DR: -10";
                    text += "\n\t\u2022 Laser DR: +5";
                    text += "\n\t\u2022 Range penalty: -50 combat skill";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_CIGARETTES:
                    text += "\n\t\u2022 Perception: +1";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                //  radiation, poison healing and drug effect remove
                case PID_RADAWAY:
                    text += "\n\t\u2022 Radiation level: -25";
                    text += "\n\t\u2022 Radiation level: -50 after 2 min.";
                    text += "\n\t\u2022 Radiation level: -75 after 4 min.";
                    break;
                case PID_WATERBAG:
                case PID_BOTTLE_FULL:
                    text += "\n\t\u2022 Initial and over time:";
                    text += "\n\t\t\u2022 Chance to reduce radiation by small amount.";
                    text += "\n\t\t\u2022 Small chance to increase radiation instead.";
                    break;
                case PID_ANTIDOTE:
                    text += "\n\t\u2022 Poisoning level: -25";
                    text += "\n\t\u2022 Poisoning level: -25 after 10 seconds.";
                    text += "\n\t\u2022 Poisoning level: -25 after 20 seconds.";
                    break;
                case PID_JET_ANTIDOTE:
                    text += "\n\t\u2022 Cures of all drug effect";
                    text += "\n\t\u2022 Neutralizes ongoing mutation effects.";
                    break;
                //  healing
                case PID_HYPO:
                    if (chosen.Trait[TRAIT_CHEM_RELIANT] > 0) {
                        text += "\n\t\u2022 Initial heal: 75-112 HP";
                        text += "\n\t\u2022 Heal over time:";
                        text += "\n\t\t\u2022 37-56 HP after 2 sec";
                        text += "\n\t\t\u2022 37-56 HP after 6 sec";
                        text += "\n\t\u2022 (Chem Reliant values shown)";
                        text += "\n\t\u2022 Does not stack, overwrites old effect.";
                    } else {
                        text += "\n\t\u2022 Heal: 100-150 HP";
                    }
                    break;
                case PID_SUPER_STIMPAK:
                    if (chosen.Trait[TRAIT_CHEM_RELIANT] > 0) {
                        text += "\n\t\u2022 Initial heal: 60 HP";
                        text += "\n\t\u2022 Heal over time:";
                        text += "\n\t\t\u2022 30 HP after 2 sec";
                        text += "\n\t\t\u2022 30 HP after 6 sec";
                        text += "\n\t\u2022 (Chem Reliant values shown)";
                        text += "\n\t\u2022 Does not stack, overwrites old effect.";
                    } else {
                        text += "\n\t\u2022 Heal: 80 HP";
                    }
                    break;
                case PID_STIMPAK:
                    if (chosen.Trait[TRAIT_CHEM_RELIANT] > 0) {
                        text += "\n\t\u2022 Initial heal: 9-18 HP";
                        text += "\n\t\u2022 Heal over time:";
                        text += "\n\t\t\u2022 16-31 HP after 3 sec";
                        text += "\n\t\t\u2022 12-18 HP after 6 sec";
                        text += "\n\t\t\u2022  8-18 HP after 9 sec";
                        text += "\n\t\t\u2022  8-12 HP after 12 sec";
                        text += "\n\t\u2022 (Chem Reliant values shown)";
                    } else {
                        text += "\n\t\u2022 Initial heal: 13-25 HP";
                        text += "\n\t\u2022 Heal over time:";
                        text += "\n\t\t\u2022 13-25 HP after 3 sec";
                        text += "\n\t\t\u2022 10-15 HP after 6 sec";
                        text += "\n\t\t\u2022  7-15 HP after 9 sec";
                        text += "\n\t\t\u2022  7-10 HP after 12 sec";
                    }
                    text += "\n\t\u2022 Does not stack, overwrites old effect.";
                    break;
                case PID_HEALING_POWDER:
                    if (chosen.Trait[TRAIT_CHEM_RELIANT] > 0) {
                        text += "\n\t\u2022 Initial heal: 5-11 HP";
                        text += "\n\t\u2022 Heal over time:";
                        text += "\n\t\t\u2022  8-18 HP after 10 sec";
                        text += "\n\t\t\u2022 12-25 HP after 20 sec";
                        text += "\n\t\t\u2022 16-31 HP after 30 sec";
                        text += "\n\t\t\u2022 16-31 HP after 40 sec";
                        text += "\n\t\u2022 (Chem Reliant values shown)";
                    } else {
                        text += "\n\t\u2022 Initial heal: 7-15 HP";
                        text += "\n\t\u2022 Heal over time:";
                        text += "\n\t\t\u2022  7-15 HP after 10 sec";
                        text += "\n\t\t\u2022 10-20 HP after 20 sec";
                        text += "\n\t\t\u2022 13-25 HP after 30 sec";
                        text += "\n\t\t\u2022 13-25 HP after 40 sec";
                    }
                    text += "\n\t\u2022 Does not stack, overwrites old effect.";
                    break;
                case PID_WEAK_HEALING_POWDER:
                    text += "\n\t\u2022 Heal: 20 HP";
                    text += "\n\t\u2022 Perception: -1";
                    break;
                //  food
                case PID_NUKA_COLA:
                    text += "\n\t\u2022 Agility: +1";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_MUTATED_FRUIT:
                    text += "\n\t\u2022 Heal: 1-4 HP";
                    text += "\n\t\u2022 Radiation level: +6";
                    text += "\n\t\u2022 Faster healing rate. (60 sec -> 40 sec)";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 15 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 30 min";
                    }
                    break;
                case PID_IGUANA_ON_A_STICK:
                    text += "\n\t\u2022 Heal: 4-20 HP";
                    break;
                case PID_MEAT_ON_A_STICK:
                    text += "\n\t\u2022 Current HP: 4-20 HP";
                    break;
                case PID_FISH_SALMON:
                    text += "\n\t\u2022 Heal: 4 HP";
                    text += "\n\t\u2022 Strength: +1";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_FISH_TUNA:
                    text += "\n\t\u2022 Heal: 4 HP";
                    text += "\n\t\u2022 Endurance: +1";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 30 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 60 min";
                    }
                    break;
                case PID_FISH_CATFISH:
                    text += "\n\t\u2022 Heal: 4 HP";
                    text += "\n\t\u2022 Agility: +1";
                    if (chosen.Trait[TRAIT_FAST_METABOLISM] > 0) {
                        text += "\n\t\u2022 Duration: 15 min (Fast Metabolism)";
                    } else {
                        text += "\n\t\u2022 Duration: 30 min";
                    }
                    break;
                default:
                    text += "\nUnknown?!\n";
            }
            text += "\n\t";
        }

        // Show bonuses
        if (item.Val0 != 0) {
            text += "\n";
            text += showItemBonus(item, item.Val0, item.Val5);
            text += showItemBonus(item, item.Val1, item.Val6);
            text += showItemBonus(item, item.Val2, item.Val7);
            text += showItemBonus(item, item.Val3, item.Val8);
            text += showItemBonus(item, item.Val4, item.Val9);
        }

        //Achievement book levels
        if(item.GetProtoId() == PID_BOOK_OF_ACHIEVEMENT) {
            text += "\nLevels: " + item.Val0;
        }

        if (IsLexem(item, "$crafter")) {
            text += "\n\nCrafter: " + GetLexem(item, "$crafter");
        } else {
            //text += "\n";
        }
        uint craftXpSkillNum = GetCraftingSkillNumByCraftPid(item);
        if (craftXpSkillNum >= 200 && craftXpSkillNum <= 218) {
            text += "\nCraft passive skill gain: " + GetMsgStr(TEXTMSG_GAME, STR_SKILL_NAME(craftXpSkillNum));
            uint craftXpValue = GetCraftXpByPid(item.GetProtoId());
            if (craftXpValue > 0) {
                text += "\nCraft material base xp value: " + craftXpValue;
                for (int skillNum = SK_LOCKPICK; skillNum <= SK_OUTDOORSMAN; skillNum++) {
                    if (skillNum == SK_LOCKPICK || skillNum == SK_REPAIR || skillNum == SK_SCIENCE || skillNum == SK_OUTDOORSMAN) {
                        int skill = chosen.Skill[skillNum];
                        int componentDiminisher = (skill > 150 ? 5 : (skill > 125 ? 4 : (skill > 100 ? 3 : (skill > 75 ? 2 : (skill > 50 ? 1 : 0)))));
                        int craftXpValueCurrent = CLAMP(craftXpValue - componentDiminisher, 0, 7);
                        text += "\n\t\u2022 " + GetMsgStr(TEXTMSG_GAME, STR_SKILL_NAME(skillNum)) + ": " + craftXpValueCurrent;
                    }
                }
            }
        }

        // Deterioration
        if (item.IsDeteriorable()) {
            uint8  flags = item.BrokenFlags;
            uint8  brokenCount = item.BrokenCount;
            uint16 wearCount = item.Deterioration;

            // Broken level, procent
            text += "\n\n";
            if (FLAG(flags, BI_NOTRESC)) {
                text += "|" + COLOR_GRAY + " " + GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_NO_RESC) +  "|" + COLOR_LGREEN + " ";
            } else if (FLAG(flags, BI_LOWBROKEN)) {
                text += GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_BROKEN_LOW);
            } else if (FLAG(flags, BI_NORMBROKEN)) {
                text += GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_BROKEN_NORM);
            } else if (FLAG(flags, BI_HIGHBROKEN)) {
                text += GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_BROKEN_HIGH);
            } else {
                int deterCurrent = 100 - wearCount * 100 / MAX_DETERIORATION;
                int deterMax = 100 - brokenCount;
                string currentColor = "";
                if (deterCurrent > 75) {
                    currentColor = " |" + COLOR_LGREEN;
                } else if (deterCurrent > 50) {
                    currentColor = " |" + COLOR_YELLOW;
                } else if (deterCurrent > 25) {
                    currentColor = " |" + COLOR_ORANGE;
                } else {
                    currentColor = " |" + COLOR_DORANGE;
                }
                currentColor += " " + deterCurrent;
                string maxColor = "";
                if (deterMax > 75) {
                    maxColor = "|" + COLOR_LGREEN;
                } else if (deterMax > 50) {
                    maxColor = "|" + COLOR_YELLOW;
                } else if (deterMax > 25) {
                    maxColor = "|" + COLOR_ORANGE;
                } else {
                    maxColor = "|" + COLOR_DORANGE;
                }
                maxColor += " " + deterMax;
                text += ReplaceText(ReplaceText(GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_PROCENT), "VALUE", currentColor), "MAXVALUE", maxColor);
                text += "|" + COLOR_LGREEN + " ";
            }

            // Service
            if (FLAG(flags, BI_SERVICE)) {
                text += "\n" + GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_SERVICE);
            }

            // Service ext
            if (FLAG(flags, BI_SERVICE_EXT)) {
                text += "\n" + GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_SERVICE_EXT);
            }
        }
        text += "\nBase price: " + item.Proto.Cost;

        /*
        if (item.Proto.NeedBlueprint > 0) {
            text += "\nNeeds blueprint!";
            text += "\n\tChosen param[" + item.Proto.Blueprint_Param + "]: " + chosen.Param[item.Proto.Blueprint_Param];
            text += "\n\tBlueprint ID = " + item.Proto.Blueprint_Id;
            if (FLAG(chosen.Param[item.Proto.Blueprint_Param], (1 << item.Proto.Blueprint_Id))) {
                text += "FLAG() = true";
            } else {
                text += "FLAG() = false";
            }
        } else {
            text += "\nDoes NOT need blueprint!";
        }*/
        // Weight
        string weightString = GetMsgStr(TEXTMSG_GAME, STR_ITEM_WEIGHT_GRAMM);
        if (item.Proto.Weight * item.GetCount() == 1) {
            weightString = ReplaceText(weightString, "grams.", "gram.");
        }
        string ammoWeightReplaceString = "";
        int totalWeight = item.Proto.Weight * item.GetCount();
        string totalWeightString = "";
        if (item.GetCount() > 1 && item.Proto.Weight > 0) {
            totalWeightString += "  (" + item.GetCount() + " * " + item.Proto.Weight + "g)";
        }
        if (ammoCount > 0) {
            totalWeight +=  ammoWeight * ammoCount;
            ammoWeightReplaceString = "  (" + (item.Proto.Weight * item.GetCount()) + "g + " + ammoCount + " * " + ammoWeight + "g)";
        }
        text += "\n\n" + ReplaceText(weightString, "VALUE", "" + totalWeight) + totalWeightString + ammoWeightReplaceString;
    } else {
        text = "N/A - Invalid Item";
    }
    int h = inventoryTooltip.interfaceTextbox.setText(text);
    inventoryTooltip.interfaceWindow.totalHeight = 20 + h;
    inventoryTooltip.interfaceWindow.posY -= inventoryTooltip.interfaceWindow.totalHeight;
}

//  Exported
void DrawCharacterTooltip() {
    string pipExtInfo = "\t\t\t\t\t\t|" + COLOR_DDGREEN + " <<Hold Shift for extended pip-search results>>";
    if (GUI_IsKeyPressed(DIK_LSHIFT) || GUI_IsKeyPressed(DIK_RSHIFT)) {
        SetCharacterDetailText(tooltipKeyValue.getToolTip(characterTooltip.currentTooltipId) + tooltipKeyValue.getToolTipExt(characterTooltip.currentTooltipId));
    } else {
        SetCharacterDetailText(tooltipKeyValue.getToolTip(characterTooltip.currentTooltipId) + pipExtInfo);
    }
    characterTooltip.Draw();
}

//  Exported
void DrawInventoryTooltip() {
    inventoryTooltip.Draw();
}

//  Exported
bool CharacterTooltipCatchMouseRelease(int click) {
    if (!characterTooltip.enabled) {
        return false;
    } else {
        characterTooltip.enabled = false;
        return true;
    }
}

class CGuiTooltip {
    bool enabled;                           //  use this to toggle on/off
    int currentTooltipId;
    int posX, posY;
    CInterfaceWindow interfaceWindow;
    CInterfaceTextbox interfaceTextbox;
    CInterfaceTextbox interfaceTextboxComparison;

    CGuiTooltip() {
        enabled = false;
    }

    CGuiTooltip(int id) {
        currentTooltipId = id;
        enabled = false;
    }

    void Draw() {
        if (!enabled) {
            //Message("GuiImage disabled.");
            return;
        }
        interfaceWindow.DrawWindow();
    }
};

/// TOOLS

//  warning: duplicate code, bc I couldn't link it form util.fos

#define HEX_BURST_WEAPON_RANK_UNRANKED      (0)
#define HEX_BURST_WEAPON_RANK_MELEE         (1)
#define HEX_BURST_WEAPON_RANK_LIGHT         (2)
#define HEX_BURST_WEAPON_RANK_MEDIUM        (3)
#define HEX_BURST_WEAPON_RANK_HEAVY         (4)
int getWeaponSizeRank(ProtoItem& item) {
    int weaponRank = HEX_BURST_WEAPON_RANK_UNRANKED;
    if (!valid(item)) {
        return weaponRank;
    }

    int skill = item.Weapon_Skill_0;
    //Log("SKILL = " + SkillName(skill) + " (" + skill + ")");
    switch (skill) {
        case SK_UNARMED:
        case SK_THROWING:
            weaponRank = HEX_BURST_WEAPON_RANK_MELEE;
            break;
        case SK_SMALL_GUNS:
            weaponRank = HEX_BURST_WEAPON_RANK_MEDIUM;
            break;
        case SK_ENERGY_WEAPONS:
            weaponRank = HEX_BURST_WEAPON_RANK_MEDIUM;
            break;
        case SK_BIG_GUNS:
            weaponRank = HEX_BURST_WEAPON_RANK_HEAVY;
            break;
    }

    uint itemPid = item.ProtoId;
    switch (itemPid) {
        //  small weapons or point blank burst weapons, like SMG's - need to set these here
        case PID_10MM_SMG:
        case PID_HK_P90C:
        case PID_GREASE_GUN:
        case PID_HK_G11:
        case PID_HK_G11E:
        case PID_10MM_PISTOL:
        case PID_14MM_PISTOL:
        case PID_9MM_MAUSER:
        case PID_DESERT_EAGLE:
        case PID_DESERT_EAGLE_EXT_MAG:
        case PID_223_PISTOL:
        case PID_44_MAGNUM_REVOLVER:
        case PID_44_MAGNUM_SPEEDLOADER:
        case PID_NEEDLER_PISTOL:
        case PID_ZIP_GUN:
        case PID_PK12_GAUSS_PISTOL:
        //  small energy
        case PID_LASER_PISTOL:
        case PID_MAGNETO_LASER_PISTOL:
        case PID_PLASMA_PISTOL:
        case PID_PLASMA_PISTOL_EXT_CART:
        case PID_ALIEN_LASER_PISTOL:
        case PID_YK32_PULSE_PISTOL:
        case PID_SOLAR_SCORCHER:
        case PID_PHAZER:
        case PID_LASER_SMG:
            weaponRank = HEX_BURST_WEAPON_RANK_LIGHT;
            break;

        //  medium sized weapons, need to set Flamer here, else they would fall into heavy category
        case PID_FLAMER:
        case PID_IMPROVED_FLAMETHROWER:
            weaponRank = HEX_BURST_WEAPON_RANK_MEDIUM;
            break;

        //  big guns, even if energy weapons
        case PID_GATLING_LASER:
            weaponRank = HEX_BURST_WEAPON_RANK_HEAVY;
            break;
    }
    return weaponRank;
}

string getWeaponSizeRankDescription(int value) {
    switch (value) {
        case 1: return "Melee";
        case 2: return "Light";
        case 3: return "Medium";
        case 4: return "Heavy";
    }
    return "Unranked";
}

#define HEX_BURST_WEAPON_RANK_UNRANKED      (0)
#define HEX_BURST_WEAPON_RANK_MELEE         (1)
#define HEX_BURST_WEAPON_RANK_LIGHT         (2)
#define HEX_BURST_WEAPON_RANK_MEDIUM        (3)
#define HEX_BURST_WEAPON_RANK_HEAVY         (4)

//  more duplicate code

uint GetCraftingSkillNumByCraftPid(ItemCl& item) {
    const ProtoItem@ proto = item.Proto;
    int craftSkillNum = 0;

    if (proto.Type == ITEM_TYPE_WEAPON) {
        int weaponSkillNum = proto.Weapon_Skill_0;
        switch (weaponSkillNum) {
            case SK_ENERGY_WEAPONS:
                craftSkillNum = SK_SCIENCE;
                break;
            default:
                craftSkillNum = SK_REPAIR;
        }
        switch (proto.ProtoId) {
            case PID_CATTLE_PROD:
            case PID_SUPER_CATTLE_PROD:
            case PID_MEGA_POWER_FIST:
            case PID_POWER_FIST:
                craftSkillNum = SK_SCIENCE;
                break;
            case PID_SPEAR:
            case PID_SHARPENED_POLE:
            case PID_SHARP_SPEAR:
            case PID_KNIFE:
            case PID_THROWING_KNIFE:
            case PID_MOLOTOV_COCKTAIL:
            case PID_SLEDGEHAMMER:
            case PID_SHOVEL:
                craftSkillNum = SK_OUTDOORSMAN;
                break;
            default:
        }
        //SkillsLog("proto weaponSkillNum = " + weaponSkillNum + ", name = " + SkillName(weaponSkillNum));
    } else if (proto.Type == ITEM_TYPE_ARMOR) {
        switch (proto.ProtoId) {
            case PID_LEATHER_ARMOR:
            case PID_LEATHER_ARMOR_HELMET:
            case PID_LEATHER_JACKET:
            case PID_LEATHER_JACKET_HELMET:
                craftSkillNum = SK_OUTDOORSMAN;
                break;
            case PID_TESLA_ARMOR:
            case PID_TESLA_HELMET:
                craftSkillNum = SK_SCIENCE;
                break;
            default:
                craftSkillNum = SK_REPAIR;
        }
        //SkillsLog("proto ARMOR craftskill = " + craftSkillNum);
    } else if (proto.Type == ITEM_TYPE_DRUG) {
        switch (proto.ProtoId) {
            case PID_WEAK_HEALING_POWDER:
            case PID_HEALING_POWDER:
            case PID_ANTIDOTE:
                craftSkillNum = SK_OUTDOORSMAN;
                break;
            default:
                craftSkillNum = SK_SCIENCE;
        }
        //SkillsLog("proto DRUG craftskill = " + craftSkillNum);
    } else if (proto.Type == ITEM_TYPE_AMMO) {
        switch (proto.ProtoId) {
            case PID_SMALL_ENERGY_CELL:
            case PID_MICRO_FUSION_CELL:
                craftSkillNum = SK_SCIENCE;
                break;
            default:
                craftSkillNum = SK_REPAIR;
        }
        //SkillsLog("proto AMMO craftskill = " + craftSkillNum);
    } else {
        switch (proto.ProtoId) {
            case PID_LOCK:
            case PID_LOCKPICKS:
            case PID_EXP_LOCKPICK_SET:
            case PID_ELECTRONIC_LOCKPICKS:
            case PID_ELEC_LOCKPICK_MKII:
                craftSkillNum = SK_LOCKPICK;
                break;
            case PID_AXE:
            case PID_WATERBAG:
            case PID_WATERBAG_EMPTY:
            case PID_TENT:
            case PID_PRIMITIVE_TOOL:
            case PID_RADIO:
            case PID_LIGHTER:
            case PID_ROPE:
            case PID_FLARE:
            //case PID_FLARE_GREEN:
            //case PID_FLARE_WHITE:
            //case PID_FLARE_YELLOW:
            case PID_BEAR_TRAP_SPRUNG:
                craftSkillNum = SK_OUTDOORSMAN;
                break;
            case PID_METAL_PARTS:
            case PID_METAL_PARTS2:
            case PID_ALLOYS:
            case PID_ALLOYS2:
            case PID_GUNPOWDER:
            case PID_GUNPOWDER2:
            case PID_MULTI_TOOL:
            case PID_MOVABLE_AMMO_BOX_S1:
            case PID_MOVABLE_AMMO_BOX_L1:
            case PID_POOR_BOX:
            case PID_MOVABLE_CHEST:
            case PID_MOVABLE_CRATE:
            case PID_MOVABLE_FOOTLOCKER1:
            case PID_MOVABLE_LOCKER1:
            case PID_MOVABLE_SAFE:
            case PID_MOVABLE_FRIDGE:
                craftSkillNum = SK_REPAIR;
                break;
            default:
                craftSkillNum = 0;
        }
        //SkillsLog("proto ELSE craftskill = " + craftSkillNum);
    }

    return craftSkillNum;
}

//  and even more duplicated code

int GetCraftXpByPid(uint pid) {
    switch (pid) {
        case PID_METAL_ORE:
        case PID_MINERAL:
        case PID_GUNPOWDER:
        case PID_MEAT_JERKY:
        case PID_BRAHMINSHIT:
            return 1;
        case PID_ROT_GUT:
        case PID_FIBER:
        case PID_FIREWOOD:
        case PID_FLINT:
        case PID_PUMP_PARTS:
        case PID_METAL_PARTS:
        case PID_XANDER_ROOT:
        case PID_BROC_FLOWER:
        case PID_MUTATED_FRUIT:
        case PID_MEAT:
        case PID_ROPE:
        case PID_GECKO_PELT:
        case PID_TOBACCO:
        case PID_CHEMICALS:
        case PID_HYPODERMIC_NEEDLE:
        case PID_MINERALS2:
        case PID_GUNPOWDER2:
        case PID_ALLOYS:
        case PID_ELECTRONIC_PARTS:
        case PID_ORE2:
            return 3;
        case PID_BIO_GEL:
        case PID_BRAHMIN_HIDE:
        case PID_GOLDEN_GECKO_PELT:
            return 4;
        case PID_FIBRE2:
        case PID_CHEMICALS2:
            return 6;
        case PID_FIREGECKO_PELT:
        case PID_ELECTRONIC_PARTS2:
        case PID_METAL_PARTS2:
        case PID_ALLOYS2:
        case PID_URANIUM_ORE:
            return 7;
        default:
            return 0;
    }
    return 0;
}

