                                    + "\n\t\u2022 Stage 3 at  400 Rem: -3 ST, -2 PE, -1 EN, -3 CH, -2 IN, -3 AG and -7 HR."
                                    + "\n\t\u2022 Stage 4 at  600 Rem: -5 ST, -3 PE, -3 EN, -4 CH, -4 IN, -5 AG and -10 HR."
                                    + "\n\t\u2022 Stage 5 at 1200 Rem: -7 ST, -5 PE, -5 EN, -7 CH, -4 IN, -7 AG and -15 HR."
