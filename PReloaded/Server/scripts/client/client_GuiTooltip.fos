#ifndef __GUI_TOOLTIP__
#define __GUI_TOOLTIP__

#include "../sprite.fos"
#include "../_defines.fos"
#include "../_client_defines.fos"
#include "../_macros.fos"
#include "../_colors.fos"
#include "../_other_h.fos"
#include "../client_gui_h.fos"
#include "../combat_h.fos"
#include "client_InterfaceControl.fos"
#include "client_InterfaceTextbox.fos"
#include "client_InterfaceWindow.fos"
#include "../lexems_h.fos"

import string showItemBonus(ItemCl& it, int type, int value) from "client_interface";
import bool IsDetectHiddenWeapon(ItemMutual& item) from "hexThrow";

CGuiTooltip characterTooltip;
CGuiTooltip inventoryTooltip;
CTooltips tooltipKeyValue;

class CTooltips {
    array<uint>     tooltipsKey;
    array<string>   tooltipsValue;
    array<string>   tooltipsValueExt;
    CTooltips() {
        InitTooltips();
    }

    string getToolTip(uint key) {
        int index = 0;
        index = tooltipsKey.find(key);
        if (index >= 0) {
            return tooltipsValue[index];
        } else {
            return "N/A";
        }
    }

    string getToolTipExt(uint key) {
        int index = 0;
        index = tooltipsKey.find(key);
        if (index >= 0) {
            return tooltipsValueExt[index];
        } else {
            return "\n\nN/A";
        }
    }

    void InitTooltips() {
        string pipText = "\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \u00ABVault-Tec Pip-Info\u2122\u00BB";
        string jjJournal = "\nJournal entry:";
        string jjText = "\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t  - Chief Gadgeteer 'Jinxed' Jack -";
        string pipReference = "\n|" + COLOR_GREEN + " Extended Pip-boy database search results:\n";
        string notes = "";//"\nNotes:";
        string requirements = "\n\nRequirements:";
        string modifies = "\n\nModifies:";
        string tldr = "\n\nTLDR:";
        string noData = "- No additional information available.";
        string @bullet = EncodeUTF8(0x2022);
        //   special stats
        tooltipsKey.insertLast(ST_STRENGTH);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_STRENGTH)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_STRENGTH))
                                 + pipText + jjJournal
                                 + "\n\n\"There is a small mining town to north in the mountains, Broken Hills. I saw a huge super-mutant drinking at the local tap house who wanted to arm wrestle every newcomer, I bet he could lift a whole caravan cart with his right arm.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Initial Hit Points: (55 + 2*ST + EN)"
                                 + "\n\u2022 Melee Damage: (ST - 5) with a minimum of 1."
                                 + "\n\u2022 Carry Weight: [(25 + (ST*25 ))/2.2] + 20"
                                 + "\n\u2022 Throwing Distance: 3*ST to reach weapon max. distance (+6 with Heave Ho!)"
                                 + "\n\u2022 Throwing Damage: min. ST/2, max. ST (more with Heave Ho!)"
                                 + "\n\u2022 To hit chance: if lower than weapon ST requirement then -20 To Hit for each missing ST"
                                 + "\n\u2022 Stonewall Knockdown/Knockout resist: (clamp(ST, 1, CH+4) + clamp(EN, 1, CH+6) )*3 + 15*stonewallRank vs 1d100"
                                 + "\n\u2022 Iron Limbs Weapon Drop resist: (ST - 5) + 2*ironLimbsRank vs 1d10"
                                 + "\n\u2022 Heavy Handed Trait Knockdown chance: "
                                 + "\n\u2022 Electric Shock effect (cannot run) duration reduce: ");

        tooltipsKey.insertLast(ST_PERCEPTION);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_PERCEPTION)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_PERCEPTION))
                                 + pipText + jjJournal
                                 + "\n\n\"Just when I ran out of smokes, I found a tobacco plantation along the shore to the west. It even had a working press machine! So much about me being 'Jinxed' he-he, oh no.... a pack of floaters are swarming to the north, gotta leave quick, damn, where do these creatures even come from?\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Sight range: Base(20) + 3*PE + Sharpshooter(6) + Binoculars(6)"
                                 + "\n\u2022 Ranged chance to hit bonus: 2*PE, (if weapon perk LongRange 4*PE, if Scope 5*PE)"
                                 + "\n\u2022 Sequence: 2*PE");
        tooltipsKey.insertLast(ST_ENDURANCE);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_ENDURANCE)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_ENDURANCE))
                                 + pipText + jjJournal
                                 + "\n\n\"Today I saw a skin-n-bones human like creature being eaten by dogs until another one scared the dogs off with a shotgun. After a short time he woke up and walked away like nothing happened. The radiation must have increased the natural regeneration of these creatures to a level where they simply cannot die. Some of them were even glowing! It was to the north-east at the huge metropolitan ruins, better avoid for now.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Hit Points: (Initial: 55 + 2*ST + EN) + (Per level: (30 + EN)/8)"
                                 + "\n\u2022 Stonewall KD/KO resist: (clamp(ST, 1, CH+4) + clamp(EN, 1, CH+6) )*3 + 15*stonewallRank vs 1d100"
                                 + "\n\u2022 Enhanced Knockout Weapon perk resist factor.");

        tooltipsKey.insertLast(ST_CHARISMA);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_CHARISMA)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_CHARISMA))
                                 + pipText + jjJournal
                                 + "\n\n\"A group of travelers were gossiping about a special lady in New Reno today. It seems that she is able to turn even the most unfriendly punks to do her bidding. I was wondering if it was her Magnetic Personality or something else, after all New Reno is also famous of addictive substances like Jet.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Stonewall: ST clamped with CH+4, EN clamped with CH+6 (ex: 9 ST with 1 CH means 5 ST in calculations)"
                                 + "\n\u2022 Confident Shooter (old More Ranged Damage) Perk damage bonus (per bullet):"
                                 + "\n\t\u2022 1 + CLAMP(attacker.CH - (((target.CH + 1) * 2) / 3), 0, 4)"
                                 + "\n\t\u2022 ex: Att. CH6, Tar. CH5 bonus: 3"
                                 + "\n\t\u2022 ex: Att. CH9, Tar. CH7 bonus: 5 (max)"
                                 + "\n\t\u2022 ex: Att. CH5, Tar. CH1 bonus: 5 (max)"
                                 + "\n\t\u2022 ex: Att. CH2, bonus: 1 (better take Bonus Ranged Damage perk instead)"
                                 + "\n\u2022 Maximum Chance To Hit: 94 + (CH+1)/2");

        tooltipsKey.insertLast(ST_INTELLECT);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_INTELLECT)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_INTELLECT))
                                 + pipText + jjJournal
                                 + "\n\n\"There is a very old and knowledgeable woman in the Hub working in a bookshop at the market square between the caravan offices. She had some good advice on technical books, but they were out of the 3rd volume of Big Books of Science. If I were to return there I sure will check that bookstore out again.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Effectiveness of combat skills: (in combat calculations)"
                                 + "\n\t\u2022 4% skill penalty for every point below 5 IN"
                                 + "\n\t\t(example: 100 SG skill with 1 IN becomes 84 SG skill)"
                                 + "\n\t\u2022 4% skill bonus for every point above 5 IN"
                                 + "\n\t\t(example: 100 SG skill with 10 IN becomes 120 SG skill)"
                                 + "\n\u2022 Critical hit chance bonus from To Hit overflow: clamp(toHitOverflow/10, 0, 5+IN)"
                                 + "\n\t\u2022 ex: IN: 5, Hit Roll: 45 vs Hit Chance: 210 -> (165 overflow) / 10 -> 16 -> 10% crit. chance bonus"
                                 + "\n\t\u2022 Note: Weaker version of this effect was present before, now it has higher cap with 5+IN"
                                 + "\n\u2022 Critical hit chance for Aimed attacks: AimLocationBonus * (60 + 4*IN) / 100"
                                 + "\n\u2022 Sniper crit. chance bonus: (5*IN - 2*LK) * sniperMargin/150 (max. 50)"
                                 + "\n\t\u2022 SniperMargin value is the hit overflow compared to the hit roll, max. 150"
                                 + "\n\u2022 Enhanced KO (head) resist factor for EN clamped with IN+4 (9EN and 2IN -> 6EN)"
                                 + "\n\u2022 KO duration reduction factor: up to 2/3 duration reduction with 10IN"
                                 + "\n\nWarning: Does no longer give extra skill points per level.");

        tooltipsKey.insertLast(ST_AGILITY);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_AGILITY)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_AGILITY))
                                 + pipText + jjJournal
                                 + "\n\n\"I saw some children yesterday playing around gecko traps in Klamath, far to the north-west, without triggering any them. Must be good to be young and agile.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Armor Class: +3*AG (double with Livewire perk)"
                                 + "\n\u2022 Action Points factor changed: (5 + 2*AG) -> (5 + (13+AG)/4)"
                                 + "\n\t\u2022 ex: 7AG-10AG -> 10AP, 3AG-6AG -> 9AP, 1AG-2AG -> 8AP"
                                 + "\n\u2022 Equipped Armor's can change AG level:"
                                 + "\n\t\u2022 Light Armor +1AG bonus (Leather Armor types and also give Quick Pockets Perk)"
                                 + "\n\t\u2022 Medium Armor -1AG malus (Combat Armor types and also give Iron Limbs Perk)"
                                 + "\n\t\u2022 Heavy Armor -3AG malus (Metal Armor types and also give Stonewall Perk)");

        tooltipsKey.insertLast(ST_LUCK);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(ST_LUCK)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(ST_LUCK))
                                 + pipText + jjJournal
                                 + "\n\n\"Finally I found some kind of abandoned theme-park with a working Nuka-Cola machine to the north-east but I didn't have any full water bags left to feed the machine. I shall not forget to pick some mutated fruits for the flavor before I return with fresh water.\""
                                 + jjText);
        tooltipsValueExt.insertLast(pipReference
                                 + "\n\u2022 Critical Chance on all attacks: 1*LK as crit. chance"
                                 + "\n\u2022 Reduce chance to be critically hit: LK/2 as crit. chance reduce"
                                 + "\n\t\u2022 Reduce chance to be critically hit by Sniper Perk: LK*2 reduce"
                                 + "\n\u2022 Critical Failure magnitude roll: Roll - 5 * (LK-5) vs 1d100"
                                 + "\n\u2022 Critical Power roll factor as target: reduce power by 1*LK"
                                 + "\n\u2022 Chance to get poisoned or radiated by creature attacks like:"
                                 + "\n\t\u2022 Radscorpions, Floaters, Aliens or Centaurs: 1d10+1 vs LK"
                                 + "\n\u2022 Thief Perk steal timeout reduce: 1d50 vs LK"
                                 + "\n\u2022 Spearfishing rare catch factor: LK/2 (overwritten by Golden Locket = 5, Magic 8-ball = 10)"
                                 + "\n\u2022 Primitive Tool (not) break chance: 10 + 5*LK vs 1d100"
                                 + "\n\u2022 Car repair tool break chance: 1 vs 1d(Repair/10 + LK/2)");
        //  skills
        tooltipsKey.insertLast(SK_SMALL_GUNS);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_SMALL_GUNS)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_SMALL_GUNS))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat specialization skill, leveled by spending Skill Points."
                                 + "\n\t\u2022 Max: 200 (if this is tagged as your combat specialization then Max: 300)"
                                 + modifies
                                 + "\n\u2022 Base chance to hit with small guns."
                                 + "\n\nNotes:"
                                 + "\n\u2022 To know more about Chance To Hit, Damage, Critical or other effect calculations use a training dummy in a tent or base.");

        tooltipsKey.insertLast(SK_BIG_GUNS);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_BIG_GUNS)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_BIG_GUNS))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat specialization skill, leveled by spending Skill Points."
                                 + "\n\t\u2022 Max: 200 (if this is tagged as your combat specialization then Max: 300)"
                                 + modifies
                                 + "\n\u2022 Base chance to hit with big guns."
                                 + "\n\nNotes:"
                                 + "\n\u2022 Hex Shoot:"
                                 + "\n\t\u2022 You are able to shoot rockets without the need of a target."
                                 + "\n\t\u2022 Hold CTRL and left click to shoot."
                                 + "\n\u2022 To know more about Chance To Hit, Damage, Critical or other effect calculations use a training dummy in a tent or base.");

        tooltipsKey.insertLast(SK_ENERGY_WEAPONS);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_ENERGY_WEAPONS)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_ENERGY_WEAPONS))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat specialization skill, leveled by spending Skill Points."
                                 + "\n\t\u2022 Max: 200 (if this is tagged as your combat specialization then Max: 300)"
                                 + modifies
                                 + "\n\u2022 Base chance to hit with energy weapons."
                                 + "\n\nNotes:"
                                 + "\n\u2022 To know more about Chance To Hit, Damage, Critical or other effect calculations use a training dummy in a tent or base.");

        tooltipsKey.insertLast(SK_UNARMED);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_UNARMED)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_UNARMED))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat specialization skill, leveled by spending Skill Points."
                                 + "\n\t\u2022 Max: 200 (if this is tagged as your combat specialization then Max: 300)"
                                 + modifies
                                 + "\n\u2022 Base chance to hit with melee weapons or unarmed attacks."
                                 + "\n\nNotes:"
                                 + "\n\u2022 To know more about Chance To Hit, Damage, Critical or other effect calculations use a training dummy in a tent or base.");

        tooltipsKey.insertLast(SK_SCAVENGING);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_SCAVENGING)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_SCAVENGING))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 Passive non-combat skill, can be leveled by related activity up to a maximum of 200."
                                 + "\n\u2022 To be able to scavenge you will need some kind of tool in inventory (not needed to be in hand), then hovering mouse over old barrels, newspaper machines, rusty sceneries etc., will change the mouse cursor and show your tool, indicating if that scenery is scavengeable."
                                 + modifies
                                 + "\n\u2022 Chance to scavenge useful or even rare materials.");

        tooltipsKey.insertLast(SK_THROWING);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_THROWING)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_THROWING))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat specialization skill, leveled by spending Skill Points."
                                 + "\n\t\u2022 Max: 200 (if this is tagged as your combat specialization then Max: 300)"
                                 + "\n\u2022 Throwing damage formula:"
                                 + "\n\t\u2022 Min: (Min. Weapon Damage + ST/2), Max: (Max. Weapon Damage + ST)"
                                 + modifies
                                 + "\n\u2022 Base chance to hit with throwing weapons."
                                 + "\n\u2022 Base armor penetration with throwing weapons: (skill/10) -> 1DR"
                                 + "\n\nNotes:"
                                 + "\n\u2022 Hex Throw:"
                                 + "\n\t\u2022 You are able to throw grenades and stones without the need of a target."
                                 + "\n\t\u2022 Hold ALT, Left Click to cycle through throwables and left click to throw."
                                 + "\n\u2022 Spear Throw:"
                                 + "\n\t\u2022 Spears hit chance is based on real time projectile hex, they hit along a line from attacker to target hex, which was predicted at the time of throw. In Real Time combat mode, if a spear lands a direct hit (central line max 4 hexes in front of target hex or 2 behind the target hex, it will have 100% knockback chance reduced by Stonewall Rank of target. While a glancing hit (left or right side line) has only 50%. Effect is 25% for Turn Based combat mode."
                                 + "\n\t\u2022 This effect is lower if target hit is closer than 8 hexes, so the optimal throw range would be between 8 and 21 hexes with Heave Ho! perk."
                                 + "\n\u2022 To know more about Chance To Hit, Damage, Critical or other effect calculations use a training dummy in a tent or base.");

        tooltipsKey.insertLast(SK_FIRST_AID);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_FIRST_AID)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_FIRST_AID))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat skill that you cannot specialize in."
                                 + "\n\u2022 If you want to specialize a healer, tag the Doctor skill instead."
                                 + "\n\u2022 You can level this skill by spending Skill Points, up to a maximum of 200."
                                 + modifies
                                 + "\n\u2022 First Aid Kit efficiency:"
                                 + "\n\t\u2022 Max use: 5 + (firstAidSkill/10) + 5(Medic) + 5(Field Medic)"
                                 + "\n\t\u2022 Tool use counter is per character and not tool."
                                 + "\n\u2022 First Aid cooldown and effect:"
                                 + "\n\t\u2022 Initial Heal (instant):"
                                 + "\n\t\t\u2022 CLAMP(missingHP * HealFactor /100, 0, 20 + skill/4 + 25(Medic) + 25(Field Medic) + 3 * ItemFactor)"
                                 + "\n\t\t\u2022 HealFactor: (30 self or 45 other) + 5(Medic) + 5(Field Medic) + 10(Item Factor)"
                                 + "\n\t\t\u2022 ItemFactor: First Aid Kit(10), Field Medic Kit(15) otherwise (0)."
                                 + "\n\t\u2022 Heal Over Time:"
                                 + "\n\t\t\u2022 Same amount as Initial Heal is healed over a short period of time."
                                 + "\n\t\t\u2022 Healing ticks every 5 seconds, 4 times total."
                                 + "\n\t\t\u2022 Total FA duration is 20 seconds."
                                 + "\n\t\t\u2022 Does not stack with another FA before expire, but overwrites effect."
                                 + "\n\t\u2022 CD: 90 sec - Skill/4 - 20(Medic) - 10(Field Medic)"
                                 + "\n\u2022 Experience:"
                                 + "\n\t\u2022 NPC: 5 * HealAmount * ( 1.5(Medic) or 2(Field Medic) )"
                                 + "\n\t\u2022 Player: HealAmount * ( 1.5(Medic) or 2(Field Medic) )"
                                 + tldr
                                 + " The higher the skill, the shorter the CD, more heal done and more usage on First Aid Kits.");

        tooltipsKey.insertLast(SK_DOCTOR);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_DOCTOR)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_DOCTOR))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat specialization skill, leveled by spending Skill Points."
                                 + "\n\t\u2022 Max: 200 (if this is tagged as your combat specialization then Max: 300)"
                                 + modifies
                                 + "\n\u2022 Doctor's Bag efficiency:"
                                 + "\n\t\u2022 Max use: 5 + ((doctorSkill-200)/10) + 5(Medic) + 5(Field Medic)"
                                 + "\n\t\u2022 Tool use counter is per character and not tool."
                                 + "\n\u2022 Doctor cooldown and chance to success:"
                                 + "\n\t\u2022 Doctor Skill vs (Random(5, 95) * ((isSelf && !isMedic) ? 2 : 1) * Difficulty / ItemFactor)"
                                 + "\n\t\t\u2022 ItemFactor: Doctor's Bag(10), Paramedic's Bag(15) otherwise (0)."
                                 + "\n\t\t\u2022 Difficulty: Starts 1 and +1 for each crippled arms or eyes."
                                 + "\n\t\t\u2022 Healing self is twice as difficult, unless Medic perk."
                                 + "\n\t\u2022 CD: 90 sec - Skill/5 - 20(Medic) - 10(Field Medic)"
                                 + "\n\u2022 Experience:"
                                 + "\n\t\u2022 NPC: 100 * healedInjuries * ( 3(Medic) or 5(Field Medic) )"
                                 + "\n\t\u2022 Player: 20 * healedInjuries * ( 3(Medic) or 5(Field Medic) )"
                                 + tldr
                                 + " The higher the skill, the shorter the CD, more chance to heal cripple and more usage on doctors bag.");

        tooltipsKey.insertLast(SK_SNEAK);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_SNEAK)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_SNEAK))
                                 + pipText);
        tooltipsValueExt.insertLast(pipReference
                                 + notes
                                 + "\n\u2022 This is an active combat specialization skill, leveled by spending Skill Points."
                                 + "\n\t\u2022 Max: 200 (if this is tagged as your combat specialization then Max: 300)"
                                 + modifies
                                 + "\n\u2022 Chance that you can remain undetected while sneaking."
                                 + "\n\t\u2022 ((Sneak + Bonuses + Maluses)/6 + Distance) vs (Opponent Max. Sight Range)"
                                 + "\n\t\u2022 Bonuses:"
                                 + "\n\t\t\u2022 Next to wall: +30 bonus. (Ghost perk can be 5 hexes near wall)"
                                 + "\n\t\u2022 Maluses:"
                                 + "\n\t\t\u2022 Opponent look direction: -72 front, -26 front-sides, -12 back-sides, 0 back."
                                 + "\n\t\t\u2022 Wearing Combat, Metal and Power Armors will fail sneak checks."
                                 + "\n\t\t\u2022 Big Guns and SMG's in any hand: -150 malus to sneak checks."
                                 + "\n\t\t\u2022 Energy weapons or riffles: -100 malus to sneak checks."
                                 + "\n\t\t\u2022 Running without Silent Running perk if able to: -60 malus to sneak checks."
                                 + "\n\t\t\u2022 Active explosive in hand: -60 malus to sneak checks."
                                 + "\n\u2022 Sneak attack: (melee, thrown or single handed guns only)"
                                 + "\n\t\u2022 An attack made from behind the target while sneaking."
                                 + "\n\t\u2022 Bonus critical chance based on how close to target, up to 35% bonus:"
                                 + "\n\t\t\u2022 5 + CLAMP((18 - distance)*2, 0, 30)"
                                 + "\n\t\u2022 Bonus critical power based on how close to target, up to 20 bonus:"
                                 + "\n\t\t\u2022 5 + CLAMP((18 - distance), 0, 15)"
                                 + "\n\t\u2022 If target dies or KO, attacker is not un-stealthed."
                                 + "\n\t\u2022 Bonus damage against NPC only, based on Sneak Skill and Distance. (closer better)"
                                 + "\n\u2022 Distract throw: (Hold ALT to Hex Throw a stone near target(s))"
                                 + "\n\t\u2022 Throwing a stone near low IN NPC will make them look at that direction for short time."
                                 + "\n\t\u2022 Chance to success: CLAMP((SN + TH) / 3, 1, 95) vs 1d100"
                                 + "\n\t\u2022 If fail, the sneaker will be un-stealthed."
                                 + "\n\nNotes:"
                                 + "\n\u2022 To know more about Chance To Hit, Damage, Critical or other effect calculations use a training dummy in a tent or base.");

        tooltipsKey.insertLast(SK_LOCKPICK);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(SK_LOCKPICK)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(SK_LOCKPICK))
                                 + pipText);
