        tooltipsKey.insertLast(TRAIT_HEAVY_HANDED);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(TRAIT_HEAVY_HANDED)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(TRAIT_HEAVY_HANDED)) + pipText);
