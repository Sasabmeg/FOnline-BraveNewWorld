        tooltipsValueExt.insertLast(pipReference
                                     + notes
                                     + "\n\u2022 -1 AP cost for all attacks."
                                     + "\n\u2022 It does not stack with AP cost reduction from Agility."
                                     + requirements
                                     + "\n\t\u2022  One ranged combat skill or Close Combat >= 175");

        tooltipsKey.insertLast(PE_SNIPER);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(PE_SNIPER)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(PE_SNIPER)) + pipText);
        tooltipsValueExt.insertLast(pipReference
                                     + notes
                                     + "\n\u2022 Your accuracy over normal hit cap is added as critical hit chance:"
                                     + "\n\t\u2022 Bonus Crit. = CLAMP((attacker.IN * 5 - target.LK * 2) * sniperMargin / 150, 0, 50);"
                                     + "\n\t\u2022 SniperMargin = CAMP(ToHit - HitRoll, 0, 150)"
                                     + "\n\t\u2022 ex: (Attacker 10 IN, Target 10 LK) -> up 30% bonus Critical Chance."
                                     + "\n\u2022 This stacks with Aimed Attack critical chance bonuses."
                                     + requirements
                                     + "\n\t\u2022  One ranged combat skill >= 175");

        tooltipsKey.insertLast(PE_SILENT_DEATH);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(PE_SILENT_DEATH)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(PE_SILENT_DEATH)) + pipText);
        tooltipsValueExt.insertLast(pipReference
                                     + notes
                                     + "\n\u2022 Stealth attacks always crits when attacking from behind with melee or single handed guns."
                                     + "\n\u2022 Bonus Critical Power based off distance from target. (closer the better)"
                                     + "\n\t\u2022 15 + CLAMP((18 - distance) * 3, 0, 45)"
                                     + "\n\t\u2022 This power roll bonus is doubled against NPC's."
                                     + "\n\t\u2022 Bonus damage against NPC only based on Sneak Skill and Distance."
                                     + "\n\u2022 Distract throw never un-stealths."
