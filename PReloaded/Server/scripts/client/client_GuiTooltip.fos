//  Exported - client_main
void InitCharacterTooltip() {
    tooltipKeyValue = CTooltips();
}

//  Exported - client_main
void InitInventoryTooltip() {
    tooltipKeyValue = CTooltips();
}

//  Exported - client_interface
void UpdateCharacterTooltip(int tooltipId, int posX, int posY) {
    if (valid(characterTooltip) && tooltipId < 0) {
        characterTooltip.enabled = false;
        return;
    }

    characterTooltip = CGuiTooltip(tooltipId);

    if (valid(characterTooltip)) {
        characterTooltip.enabled = false;
    }

    characterTooltip.posX = posX;
    characterTooltip.posY = posY;
    int x = posX;
    int y = posY;
    if (uint(tooltipId) >= SKILL_BEGIN && uint(tooltipId) < SKILL_BEGIN + SKILL_COUNT || GUI_GetActiveScreen() == CLIENT_SCREEN_PERK) {
        characterTooltip.interfaceWindow = CInterfaceWindow(x - 620 - 30, y, 620, 100);
    } else {
        characterTooltip.interfaceWindow = CInterfaceWindow(x + 20, y, 620, 100);
    }

    characterTooltip.interfaceWindow.maxWidth = __ScreenWidth * 4 / 5;
    characterTooltip.interfaceWindow.maxHeight = __ScreenHeight * 4 / 5;
    characterTooltip.interfaceWindow.backgroundColor = COLOR_RGBA(0, 0, 0, 230);

    characterTooltip.interfaceTextbox = CInterfaceTextbox(10, 10, 600, 800);
    characterTooltip.interfaceTextbox.Init();
    characterTooltip.interfaceTextbox.textColor = COLOR_LGREEN;

    SetCharacterDetailText(tooltipKeyValue.getToolTip(tooltipId));

    characterTooltip.interfaceWindow.posY -= characterTooltip.interfaceWindow.totalHeight;
    characterTooltip.posY = characterTooltip.interfaceWindow.posY;

    characterTooltip.interfaceWindow.childControls.insertLast(characterTooltip.interfaceTextbox);
    characterTooltip.interfaceWindow.FitScreen();
    characterTooltip.enabled = true;
    //__HideCursor = true;
}

//  Exported - client_interface
void UpdateInventoryTooltip(ItemCl& item, int left, int right, int top, int bottom, bool preferLeft) {
    if (!valid(inventoryTooltip)) {
        return;
    }
    if (!valid(item)) {
        inventoryTooltip.enabled = false;
        return;
    }

    inventoryTooltip = CGuiTooltip();

    if (valid(inventoryTooltip)) {
        inventoryTooltip.enabled = false;
    }

    //int x = __MouseX;
    //int y = __MouseY;
    int x = left;
    int y = top;
    inventoryTooltip.interfaceWindow = CInterfaceWindow(x + 20, y, 320, 100);

    inventoryTooltip.interfaceWindow.maxWidth = __ScreenWidth * 4 / 5;
    inventoryTooltip.interfaceWindow.maxHeight = __ScreenHeight * 4 / 5;
    inventoryTooltip.interfaceWindow.backgroundColor = COLOR_RGBA(0, 0, 0, 230);
    inventoryTooltip.interfaceTextbox = CInterfaceTextbox(10, 10, 300, 800);
    inventoryTooltip.interfaceTextbox.Init();
    inventoryTooltip.interfaceTextbox.textColor = COLOR_RGB(0, 0xD8, 0);
    SetInventoryDetailText(item);
    inventoryTooltip.interfaceWindow.childControls.insertLast(inventoryTooltip.interfaceTextbox);
    inventoryTooltip.interfaceWindow.FitScreen(left, right, top, bottom, preferLeft);
    inventoryTooltip.enabled = true;
    //__HideCursor = true;
}


void SetCharacterDetailText(string& text) {
    int h = characterTooltip.interfaceTextbox.setText(text);
    characterTooltip.interfaceWindow.totalHeight = 20 + h;
    //characterTooltip.interfaceWindow.posY -= characterTooltip.interfaceWindow.totalHeight;
}

void SetInventoryDetailText(ItemCl& item) {
    CritterCl@ chosen = GetChosen();
    if (!valid(chosen)) {
        return;
    }

	string itemQualityPrefix = "";
	if (valid(item)) {
        if(item.GetType() == ITEM_TYPE_ARMOR || item.GetType()== ITEM_TYPE_WEAPON) {
            if(item.Val4!=0)	itemQualityPrefix +="|" + COLOR_SAND + " Unique " + "|" + COLOR_LGREEN + " ";
            else if(item.Val3!=0) itemQualityPrefix +="|" + COLOR_GREEN_RED + " Advanced " + "|" + COLOR_LGREEN + " ";
            else if(item.Val2!=0) itemQualityPrefix +="|" + COLOR_WHITE + " Superior " + "|" + COLOR_LGREEN + " ";
            else if(item.Val1!=0) itemQualityPrefix +="|" + COLOR_LGRAY + " Improved " + "|" + COLOR_LGREEN + " ";
            else if(item.Val0!=0) itemQualityPrefix +="|" + COLOR_GRAY + " Quality " + "|" + COLOR_LGREEN + " ";
        }
	}

    string text = "" + itemQualityPrefix;
    if (valid(item)) {
        text += GetMsgStr(TEXTMSG_ITEM, STR_ITEM_INFO(item)) + "\n\n";
        text += GetMsgStr(TEXTMSG_ITEM, STR_PROTO_INFO(item.Proto)+1) + "\n";
        int ammoCount = 0;
        int ammoWeight = 0;
        if (item.GetType() == ITEM_TYPE_WEAPON) {
            // Ammo load
            if(item.Proto.Weapon_MaxAmmoCount > 0) {
                text += "\n";
                string str = GetMsgStr(TEXTMSG_GAME, STR_INV_HAS_SHOTS);
                str = ReplaceText(str, "VALUE", item.AmmoCount);
                str = ReplaceText(str, "MAX_VALUE", item.Proto.Weapon_MaxAmmoCount);
                str = ReplaceText(str, "AMMO", GetMsgStr(TEXTMSG_GAME, STR_CALIBER(item.Proto.Weapon_Caliber)));
                text += str;
                if (item.AmmoCount > 0) {
                    ProtoItem@ ammo = GetProtoItem(item.AmmoPid);
                    if (valid(ammo)) {
                        ammoCount = item.AmmoCount;
                        ammoWeight = ammo.Weight;
                    }
                }
            }
            if (item.Proto.Weapon_MinStrength > 1) {
                text += "\nMinimum Strength: " + item.Proto.Weapon_MinStrength;
            }

            if (item.Proto.Weapon_MaxDist_0 > 0) {
                uint16	rounds = _WeaponRound(item.Proto, 0);
                bool 	isBurst = rounds > 1;
                if (isBurst) {
                    text += "\nBurst range: " + item.Proto.Weapon_MaxDist_0;
                } else {
                    text += "\nRange: " + item.Proto.Weapon_MaxDist_0;
                }
                if (item.Proto.Weapon_MaxDist_1 > 0) {
                    uint16	rounds = _WeaponRound(item.Proto, 1);
                    bool 	isBurst = rounds > 1;
                    if (isBurst) {
                        text += "\t(Burst range: " + item.Proto.Weapon_MaxDist_1 + ")";
                    } else if (item.Proto.Weapon_Anim2_1 == ANIM2_THROW) {
                        text += "\t(Throw range: " + item.Proto.Weapon_MaxDist_1 + ")";
                    }
                }
            }
            if (item.Proto.Weapon_DmgMin_0 > 0 && item.Proto.Weapon_DmgMax_0 > 0) {
                text += "\nBase damage: " + item.Proto.Weapon_DmgMin_0 + "-" + item.Proto.Weapon_DmgMax_0;
            }
            if (IsDetectHiddenWeapon(item)) {
                text += "\nReveal hidden once:";
                text += "\n\tReveal radius on lit: " + FLARELIT_REVEAL_RADIUS;
                text += "\n\tReveal radius on thrown hex: " + FLARELIT_REVEAL_RADIUS;
                text += "\nReveal hidden per pulse:";
                text += "\n\tMust be in any hands or on the ground.";
                text += "\n\tReveal radius per pulse: " + FLAREGROUND_REVEAL_RADIUS;
                text += "\n\tPulse frequency: " + FLARE_PULSE_FREQ_MIN + "-" + FLARE_PULSE_FREQ_MAX + " seconds.";
                text += "\n\tPulse count: " + FLARE_PULSE_COUNT;
                text += "\n\tLifetime after lit: " + (FLARE_PULSE_FREQ_MIN * FLARE_PULSE_COUNT / 60) + "-" + (FLARE_PULSE_FREQ_MAX * FLARE_PULSE_COUNT / 60) + " minutes.";
            }
            if (item.Proto.Weapon_Perk != 0) {
                string str = GetMsgStr(TEXTMSG_GAME, STR_WEAPON_PERK(item.Proto.Weapon_Perk));
                text += "\nPerk: " + str + ".";
            }
        } else if (item.GetType() == ITEM_TYPE_ARMOR) {
            string radResistStr = "";
            string perkStr = "";
            if (item.Proto.Armor_Perk != 0) {
                if (item.Proto.Slot == SLOT_ARMOR) {
                    switch (item.Proto.Armor_Perk) {
                        case ARMOR_PERK_POWERED: radResistStr += "+35"; perkStr = "\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall.\nPerk: Adv. Powered. (+3 ST)"; break;
                        case ARMOR_PERK_ADVANCED_I:
                        case ARMOR_PERK_ADVANCED_II: radResistStr += "+40"; perkStr = "\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall.\nPerk: Adv. Powered. (+4 ST)"; break;
                        case ARMOR_PERK_LEATHER_JACKET: radResistStr += "+5"; perkStr = "\nLight: +1 AG \nPerk: Quick Pockets.\nPerk: Swagger. (+1 CH)"; break;
                        case ARMOR_PERK_LEATHER_ARMOR: radResistStr += "+10"; perkStr = "\nLight: +1 AG \nPerk: Quick Pockets."; break;
                        case ARMOR_PERK_THERMAL_LEATHER: radResistStr += "+35"; perkStr = "\nPerk: Flame Resistant. (Higher Flamer KD resist)"; break;
                        case ARMOR_PERK_COMBAT: radResistStr += "+25"; perkStr = "\nMedium: -1 AG (also AG cap 9)\nPerk: Iron Limbs."; break;
                        case ARMOR_PERK_METAL: radResistStr += "+15"; perkStr = "\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall."; break;
                        case ARMOR_PERK_TESLA: radResistStr += "+35"; perkStr = "\nHeavy: -3 AG (also AG cap 7)\nPerk: Stonewall."; break;
                        case ARMOR_PERK_CAMOUFLAGE_HP: radResistStr += "+10"; perkStr = "\nPerk: Camouflage. (Hide HP and Helm)"; break;
                    }
                } else if (item.Proto.Slot == SLOT_HEAD) {
                    switch (item.Proto.Armor_Perk) {
                        case HELMET_PERK_CHARISMA: perkStr = "\nPerk: Stylish. (+1 CH)"; break;
                        case HELMET_PERK_PERCEPTION_GLASSES: perkStr = "\nPerk: Sight Correction. (PE set to 4 if lower)"; break;
                        case HELMET_PERK_PROTECT_EYES: perkStr = "\nPerk: Protect Eyes. (Aim location Eyes changed to Head)"; break;
                        case HELMET_PERK_BONUS_PERCEPTION: perkStr = "\nPerk: Clear Vision. (+1 PE)"; break;
                        case HELMET_PERK_MALUS_PERCEPTION: perkStr = "\nPerk: Impaired Vision. (-1 PE)"; break;
                        case HELMET_PERK_CAMOUFLAGE_NAME: perkStr = "\nPerk: Camouflage. (Hide Name)"; break;
                        case HELMET_PERK_METAL_MASK: perkStr = "\nPerk: Camouflage. (Hide Name)\nPerk: Impaired Vision. (-1 PE)"; break;
                        case HELMET_PERK_METAL_MASK_2: perkStr = "\nPerk: Camouflage. (Hide Name)\nPerk: Impaired Vision. (-2 PE)"; break;
                    }
                }
            }
            text += "\nArmor Class: " + item.Proto.Armor_AC;
            text += "\nDamage resistances: (DT/DR)";
            if (item.GetProtoId() == PID_FRONT_PLATED_METAL_ARMOR || item.GetProtoId() == PID_FRONT_PLATED_METAL_HELMET) {
                text += "\nFront:";
                text += "\n\tNormal: \u00A0\u00A0\u00A0" + (item.Proto.Armor_DTNormal + 3) + "/" + (item.Proto.Armor_DRNormal + 10);
                text += "\n\tLaser:     \u00A0" + (item.Proto.Armor_DTLaser + 3) + "/" + (item.Proto.Armor_DRLaser + 10);
                text += "\n\tFire:         " + (item.Proto.Armor_DTFire + 3) + "/" + (item.Proto.Armor_DRFire + 10);
                text += "\n\tPlasma:  \u00A0\u00A0" + (item.Proto.Armor_DTPlasma + 3) + "/" + (item.Proto.Armor_DRPlasma + 10);
                text += "\n\tElectric:  \u00A0" + (item.Proto.Armor_DTElectr + 3) + "/" + (item.Proto.Armor_DRElectr + 10);
                text += "\n\tExplode:  \u00A0" + (item.Proto.Armor_DTExplode + 3) + "/" + (item.Proto.Armor_DRExplode + 10);
                text += "\n\tCrit chance mod: " + (item.Proto.Armor_CMCritChance - 10);
                text += "\n\tCrit power mod: " + (item.Proto.Armor_CMCritPower - 10);
                text += "\nBack:";
            }
            text += "\n\tNormal: \u00A0\u00A0\u00A0" + item.Proto.Armor_DTNormal + "/" + item.Proto.Armor_DRNormal;
            text += "\n\tLaser:     \u00A0" + item.Proto.Armor_DTLaser + "/" + item.Proto.Armor_DRLaser;
            text += "\n\tFire:         " + item.Proto.Armor_DTFire + "/" + item.Proto.Armor_DRFire;
            text += "\n\tPlasma:  \u00A0\u00A0" + item.Proto.Armor_DTPlasma + "/" + item.Proto.Armor_DRPlasma;
            text += "\n\tElectric:  \u00A0" + item.Proto.Armor_DTElectr + "/" + item.Proto.Armor_DRElectr;
            text += "\n\tExplode:  \u00A0" + item.Proto.Armor_DTExplode + "/" + item.Proto.Armor_DRExplode;
            if (radResistStr.length() > 0) {
                text += "\n\tRadiation Resist: " + radResistStr;
            }
            text += "\n\tCrit chance mod: " + (item.Proto.Armor_CMCritChance);
            text += "\n\tCrit power mod: " + (item.Proto.Armor_CMCritPower);
            text += "\n";
            if (item.GetProtoId() == PID_TESLA_ARMOR) {
                text += "\nCharges: "+item.Charge+"/"+item.Proto.Misc_ChargeMax;
            }
            if (perkStr.length() > 0) {
                text += perkStr;
            }
        } else if (item.GetType() == ITEM_TYPE_AMMO) {
            text += "\nDM mod: " + (item.Proto.Ammo_DmgMult) + "/" + (item.Proto.Ammo_DmgDiv);
            text += "\nDR mod: " + (item.Proto.Ammo_DrMod) + "%";
            text += "\nAC mod: " + (item.Proto.Ammo_AcMod);
            if (COMBAT_AMMO_AP(item.Proto)) {
                text += "\nArmor Piercing";
            }
        } else if (item.GetType() == ITEM_TYPE_MISC) {
            if (item.Proto.Misc_ToolSkillNum != 0) {
                string str = GetMsgStr(TEXTMSG_GAME, STR_SKILL_NAME(item.Proto.Misc_ToolSkillNum));
                text += "\n" + str + " bonus: " + item.Proto.Misc_ToolSkillBonus + ".";
            }
            if (item.Proto.Misc_ChargeMax > 0) {
                text += "\nCharges: "+item.Charge+"/"+item.Proto.Misc_ChargeMax;
            }
        } else if(item.GetType() == ITEM_TYPE_KEY) {
            // Key id
            text += "\n" + ReplaceText(GetMsgStr(TEXTMSG_GAME, STR_INV_KEY_NUMBER), "KEY_ID", item.LockerId);
        }

        // Show bonuses
        if (item.Val0 != 0) {
            text += "\n";
            text += showItemBonus(item, item.Val0, item.Val5);
            text += showItemBonus(item, item.Val1, item.Val6);
            text += showItemBonus(item, item.Val2, item.Val7);
            text += showItemBonus(item, item.Val3, item.Val8);
            text += showItemBonus(item, item.Val4, item.Val9);
        }

        //Achievement book levels
        if(item.GetProtoId() == PID_BOOK_OF_ACHIEVEMENT) {
            text += "\nLevels: " + item.Val0;
        }

        if (IsLexem(item, "$crafter")) {
            text += "\n\nCrafter: " + GetLexem(item, "$crafter");
        } else {
            //text += "\n";
        }

        // Deterioration
        if (item.IsDeteriorable()) {
            uint8  flags = item.BrokenFlags;
            uint8  brokenCount = item.BrokenCount;
            uint16 wearCount = item.Deterioration;

            // Broken level, procent
            text += "\n\n";
            if (FLAG(flags, BI_NOTRESC)) {
                text += "|" + COLOR_GRAY + " " + GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_NO_RESC) +  "|" + COLOR_LGREEN + " ";
            } else if (FLAG(flags, BI_LOWBROKEN)) {
                text += GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_BROKEN_LOW);
            } else if (FLAG(flags, BI_NORMBROKEN)) {
                text += GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_BROKEN_NORM);
            } else if (FLAG(flags, BI_HIGHBROKEN)) {
                text += GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_BROKEN_HIGH);
            } else {
                int deterCurrent = 100 - wearCount * 100 / MAX_DETERIORATION;
                int deterMax = 100 - brokenCount;
                string currentColor = "";
                if (deterCurrent > 75) {
                    currentColor = " |" + COLOR_LGREEN;
                } else if (deterCurrent > 50) {
                    currentColor = " |" + COLOR_YELLOW;
                } else if (deterCurrent > 25) {
                    currentColor = " |" + COLOR_ORANGE;
                } else {
                    currentColor = " |" + COLOR_DORANGE;
                }
                currentColor += " " + deterCurrent;
                string maxColor = "";
                if (deterMax > 75) {
                    maxColor = "|" + COLOR_LGREEN;
                } else if (deterMax > 50) {
                    maxColor = "|" + COLOR_YELLOW;
                } else if (deterMax > 25) {
                    maxColor = "|" + COLOR_ORANGE;
                } else {
                    maxColor = "|" + COLOR_DORANGE;
                }
                maxColor += " " + deterMax;
                text += ReplaceText(ReplaceText(GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_PROCENT), "VALUE", currentColor), "MAXVALUE", maxColor);
                text += "|" + COLOR_LGREEN + " ";
            }

            // Service
            if (FLAG(flags, BI_SERVICE)) {
                text += "\n" + GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_SERVICE);
            }

            // Service ext
            if (FLAG(flags, BI_SERVICE_EXT)) {
                text += "\n" + GetMsgStr(TEXTMSG_GAME, STR_DETERIORATION_SERVICE_EXT);
            }
        }
        text += "\nBase price: " + item.Proto.Cost;

        // Weight
        string weightString = GetMsgStr(TEXTMSG_GAME, STR_ITEM_WEIGHT_GRAMM);
        if (item.Proto.Weight * item.GetCount() == 1) {
            weightString = ReplaceText(weightString, "grams.", "gram.");
        }
        string ammoWeightReplaceString = "";
        int totalWeight = item.Proto.Weight * item.GetCount();
        string totalWeightString = "";
        if (item.GetCount() > 1 && item.Proto.Weight > 0) {
            totalWeightString += "  (" + item.GetCount() + " * " + item.Proto.Weight + "g)";
        }
        if (ammoCount > 0) {
            totalWeight +=  ammoWeight * ammoCount;
            ammoWeightReplaceString = "  (" + (item.Proto.Weight * item.GetCount()) + "g + " + ammoCount + " * " + ammoWeight + "g)";
        }
        text += "\n\n" + ReplaceText(weightString, "VALUE", "" + totalWeight) + totalWeightString + ammoWeightReplaceString;
    } else {
        text = "N/A - Invalid Item";
    }
    int h = inventoryTooltip.interfaceTextbox.setText(text);
    inventoryTooltip.interfaceWindow.totalHeight = 20 + h;
    inventoryTooltip.interfaceWindow.posY -= inventoryTooltip.interfaceWindow.totalHeight;
}

//  Exported
void DrawCharacterTooltip() {
    string pipExtInfo = "\t\t\t\t\t\t|" + COLOR_DDGREEN + " <<Hold Shift for extended pip-search results>>";
    if (GUI_IsKeyPressed(DIK_LSHIFT) || GUI_IsKeyPressed(DIK_RSHIFT)) {
        SetCharacterDetailText(tooltipKeyValue.getToolTip(characterTooltip.currentTooltipId) + tooltipKeyValue.getToolTipExt(characterTooltip.currentTooltipId));
    } else {
        SetCharacterDetailText(tooltipKeyValue.getToolTip(characterTooltip.currentTooltipId) + pipExtInfo);
    }
    characterTooltip.Draw();
}

//  Exported
void DrawInventoryTooltip() {
    inventoryTooltip.Draw();
}

//  Exported
bool CharacterTooltipCatchMouseRelease(int click) {
    if (!characterTooltip.enabled) {
        return false;
    } else {
        characterTooltip.enabled = false;
        return true;
    }
}

class CGuiTooltip {
    bool enabled;                           //  use this to toggle on/off
    int currentTooltipId;
    int posX, posY;
    CInterfaceWindow interfaceWindow;
    CInterfaceTextbox interfaceTextbox;

    CGuiTooltip() {
        enabled = false;
    }

    CGuiTooltip(int id) {
        currentTooltipId = id;
        enabled = false;
    }

    void Draw() {
        if (!enabled) {
            //Message("GuiImage disabled.");
            return;
        }
        interfaceWindow.DrawWindow();
    }
};

