        tooltipsKey.insertLast(PE_SNIPER);
        tooltipsValue.insertLast("\t\t\t" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_NAME(PE_SNIPER)) + "\n\n" + GetMsgStr(TEXTMSG_GAME, STR_PARAM_DESC(PE_SNIPER)) + pipText);
        tooltipsValueExt.insertLast(pipReference
                                     + notes
                                     + "\n\u2022 Your accuracy over normal hit cap is added as critical hit chance:"
